# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> app/encryption ###
# Key for encrypting secrets at rest (SSO client secret, Telegram API key, the
# digital certificate private key). A 32-byte key as base64 or 64 hex chars.
# Generate with: php bin/console app:encryption:generate-key
# REQUIRED before the application can store any encrypted value. Provide it via
# the deployment secret store (Infisical) in production; never commit a real key.
APP_ENCRYPTION_KEY=
###< app/encryption ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> reverse proxy ###
# When TLS is terminated at a reverse proxy (nginx/traefik/k8s ingress), the app must trust
# that proxy's X-Forwarded-* headers so generated URLs (notably the OIDC SSO redirect_uri)
# use https rather than the plain-http scheme it sees internally. Applies in prod only.
# Values: a comma-separated list of proxy IPs/CIDRs, or the keyword `private_ranges` to trust
# any RFC1918/loopback upstream (safe when the pod/container is only reachable via the proxy).
# Narrow this to the proxy's real address if the app is otherwise directly reachable.
TRUSTED_PROXIES=private_ranges
###< reverse proxy ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> app/sso ###
# OpenID Connect SSO. Configure via the deployment secret store (Infisical).
# Prefer automatic discovery: set SSO_DISCOVERY_URL to the provider's
# .well-known/openid-configuration. For manual setup, leave it empty and set the
# three endpoint URLs instead.
SSO_ENABLED=0
SSO_DISCOVERY_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_AUTHORIZATION_URL=
SSO_TOKEN_URL=
SSO_USERINFO_URL=
SSO_SCOPES="openid profile email"
SSO_PROVIDER_LABEL=keycloak
###< app/sso ###

###> app/install ###
# Password that unlocks the web install wizard at /admin/install.
# Leave EMPTY to disable the wizard entirely (recommended once the system is
# installed and managed from the console). Set to a strong secret on first
# deploy if you want to run the guided install from a browser.
INSTALL_PASSWORD=
# Whether the container entrypoint runs database migrations on startup.
# Set to "0" for the plain web-server deployment where migrations are run by
# hand from the console. Docker / Compose / k8s images default this to "1".
RUN_MIGRATIONS_ON_START=0
###< app/install ###

###> app/embeds ###
# Comma-separated hosts allowed to be embedded as location maps. Only
# https iframes/URLs from these hosts (or their subdomains) are rendered, and
# the frame-src CSP is limited to them. Example:
#   LOCATION_EMBED_ALLOWED_DOMAINS="www.google.com,www.openstreetmap.org"
LOCATION_EMBED_ALLOWED_DOMAINS=""
###< app/embeds ###

###> app/telegram-bot ###
# Shared service token the Telegram bot (critterbot) presents as
# "Authorization: Bearer <token>" on /api/bot. It authenticates the bot only -
# the acting volunteer travels in the X-Acting-User header and is authorized
# separately. Leave empty to disable the bot surface entirely.
BOT_API_TOKEN=""
###< app/telegram-bot ###

###> app/uploads ###
# Pluggable storage backend for user uploads (chat images, avatars). One DSN
# selects the backend with no code change (see App\Storage\FileStorageFactory).
#
# Development - local filesystem (relative paths resolve under the project dir):
UPLOAD_STORAGE_DSN=local://var/uploads
# Production - Amazon S3 / S3-compatible. Credentials come from the standard
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env (or an instance role), never the
# DSN. Optional query params: &prefix=, &endpoint=, &path_style=1.
#   UPLOAD_STORAGE_DSN=s3://my-bucket?region=eu-central-1&prefix=uploads
###< app/uploads ###

###> app/exports ###
# Storage for audit legal packages and GDPR data exports. Same DSN grammar as uploads.
#
# The archive is written by one process (the messenger worker, for GDPR exports) and served by
# another (the web request). A `local://` DSN therefore only works when every container mounts the
# same directory - the bundled compose.prod.yaml does exactly that with a named volume. On
# Kubernetes, or behind more than one app replica, use S3: pods share no disk, and an export written
# on one is invisible to the next.
EXPORT_STORAGE_DSN=local://var/exports
#   EXPORT_STORAGE_DSN=s3://my-bucket?region=eu-central-1&prefix=exports
###< app/exports ###
