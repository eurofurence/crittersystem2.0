msgid "admin.sso.local_login.field.enabled.help"
msgstr "Turn this off once everyone signs in through the identity provider. Administrators keep password access regardless, so an unreachable provider cannot lock you out of your own installation."

msgid "admin.sso.local_login.field.enabled.label"
msgstr "Offer username and password sign-in"

msgid "admin.sso.local_login.help"
msgstr "Controls whether the login page offers the username and password form at all. Switching it off refuses password sign-in outright, not merely the form, so nothing can post credentials past it."

msgid "admin.sso.local_login.requires_sso"
msgstr "This setting only takes effect while SSO is enabled. Without a working identity provider there would be no other way in, so password sign-in stays available."

