{% extends 'base.html.twig' %}
{% import 'components/forms/_macros.twig' as f %}
{% import 'components/data/_macros.twig' as d %}
{% import 'components/icon/_macros.twig' as i %}
{% import _self as ui %}

{#
  The component gallery for templates/components/data/_macros.twig.

  Every example below is rendered live AND shown as copy-pasteable Twig source. All demo
  data is obviously fake (Demo Department …, Sample Volunteer, @demo.invalid) - never put
  real volunteer, user or event data on this page.

  Local helper macros (ui.*) exist only to lay out this gallery; they are NOT components.
#}

{# `code` is captured Twig source: |trim casts the Markup object to a plain string so that |e
   escapes it. Without the cast the source is rendered as HTML instead of shown. #}
{% macro snippet(code) %}
  <pre class="mt-2 mb-0 p-2 bg-body-tertiary border rounded small" style="overflow-x: auto;"><code>{{ code|trim|e }}</code></pre>
{% endmacro %}

{% macro demo_start(title, whatFor, whenNot) %}
  <div class="mb-4">
    <div class="d-flex flex-wrap align-items-baseline gap-2">
      <code class="fs-4">{{ title }}</code>
    </div>
    <p class="text-muted small mb-2">
      <strong>Use it for:</strong> {{ whatFor }}<br>
      <strong>Do not use it when:</strong> {{ whenNot }}
    </p>
    <div class="border rounded p-3">
{% endmacro %}

{% macro demo_end() %}
    </div>
  </div>
{% endmacro %}

{% block title %}{{ pageTitle }}{% endblock %}

{% block body %}
<div class="container-xl py-4">

  {{ d.page_header(pageTitle, {
    subtitle: 'Live gallery of every macro in components/data/_macros.twig. All data is fake.',
