{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}Request links — {{ department.name }}{% endblock %}

{% block body %}
  {{ d.page_header('Availability & invitation links', {
    subtitle: 'Department-bound links for collecting availability or inviting staff to apply.',
    actions: [{label: '← Shift Manager', href: path('app_manage_shifts'), class: 'btn btn-outline-secondary'}]
  }) }}

  {{ d.card_start(null, {bodyClass: 'card-body d-flex flex-wrap align-items-end gap-3'}) }}
      <form method="get" class="d-flex align-items-end gap-2">
        <div>
          <label class="form-label mb-1" for="rl-department">Department</label>
          <select id="rl-department" name="department" class="form-select" onchange="this.form.submit()">
            {% for dept in departments %}
              <option value="{{ dept.uuid }}" {{ dept.uuid == department.uuid ? 'selected' : '' }}>{{ dept.name }}</option>
            {% endfor %}
          </select>
        </div>
      </form>
      <div class="ms-auto small">
        {% if ssoManaged %}
          {{ d.badge('SSO-managed', 'bg-azure-lt') }} membership is never changed by links.
        {% elseif autoMembership %}
          {{ d.badge('Auto-membership on', 'bg-green-lt') }} using a link adds the user to this department.
        {% else %}
          {{ d.badge('Auto-membership off', 'bg-secondary-lt') }} links don't change membership.
        {% endif %}
      </div>
  {{ d.card_end({bodyClass: 'card-body d-flex flex-wrap align-items-end gap-3'}) }}

  {{ d.card_start('Create a link') }}
      <form method="post" action="{{ path('app_request_links_create') }}" class="row g-2 align-items-end">
        <input type="hidden" name="_token" value="{{ csrf_token('request_link') }}">
        <input type="hidden" name="department" value="{{ department.uuid }}">
        <div class="col-12 col-md-4">
          <label class="form-label" for="rl-type">Type</label>
          <select class="form-select" id="rl-type" name="type">
            <option value="availability_request">Availability request</option>
            <option value="shift_invitation">Shift application invitation</option>
          </select>
        </div>
        <div class="col-12 col-md-4">
          <label class="form-label" for="rl-expires">Deadline / expiry (optional)</label>
          <input type="datetime-local" class="form-control" id="rl-expires" name="expires_at">
        </div>
        <div class="col-12 col-md-4">
          <button class="btn btn-primary" type="submit">Create link</button>
        </div>
      </form>
  {{ d.card_end() }}

  {% if links is empty %}
    {{ d.empty_state('No links yet', {message: 'Create an availability request or shift invitation above.'}) }}
  {% else %}
    {{ d.card_start(null, {class: '', bodyClass: ''}) }}
      <div class="table-responsive">
        <table class="table table-vcenter card-table">
          <thead>
            <tr><th>Type</th><th>Link</th><th>Deadline</th><th>Status</th><th></th></tr>
          </thead>
          <tbody>
            {% for link in links %}
              <tr>
                <td>{{ link.type.label }}</td>
                <td>
                  <code class="user-select-all">{{ url('app_request_link_access', {token: link.token}) }}</code>
                </td>
                <td>{{ link.expiresAt ? link.expiresAt|app_datetime : '—' }}</td>
                <td>
                  {% if link.revoked %}{{ d.badge('Revoked', 'bg-red-lt') }}
                  {% elseif link.expired %}{{ d.badge('Expired', 'bg-secondary-lt') }}
                  {% else %}{{ d.badge('Active', 'bg-green-lt') }}{% endif %}
                </td>
                <td class="text-end">
                  {% if not link.revoked %}
                    <form method="post" action="{{ path('app_request_links_revoke', {id: link.uuid}) }}" class="d-inline"
                          data-controller="confirm" data-confirm-message-value="Revoke this link?">
                      <input type="hidden" name="_token" value="{{ csrf_token('request_link_revoke' ~ link.id) }}">
                      <button class="btn btn-sm btn-outline-danger">Revoke</button>
                    </form>
                  {% endif %}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {{ d.card_end({bodyClass: ''}) }}
  {% endif %}
{% endblock %}
