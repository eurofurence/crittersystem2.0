{% extends 'base.html.twig' %}
{% import 'components/notification/_macros.twig' as n %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ pageTitle }}{% endblock %}

{% block body %}
  {{ d.page_header(pageTitle, {
    subtitle: 'alert, flash_messages and toast - templates/components/notification/_macros.twig',
    actions: [
      {label: 'Back to the kit index', href: path('app_navigation_kit'), class: 'btn btn-outline-primary'}
    ]
  }) }}

  {# ------------------------------------------------------------------ flashes #}

  {{ d.card_start('flash_messages', {subtitle: 'Rendered once, for the whole app, by base.html.twig.'}) }}
    <p>
      The three alerts <strong>above the page header</strong> are Symfony flash messages: this
      controller calls <code>addFlash()</code> three times on every GET, and
      <code>base.html.twig</code> renders them with <code>n.flash_messages(app)</code> just
      before <code>{% verbatim %}{% block body %}{% endverbatim %}</code>. Every flash is rendered
      as a <strong>dismissible</strong> alert whose type is the flash key, so use
      <code>success</code> / <code>info</code> / <code>warning</code> / <code>danger</code> as keys.
    </p>
    <p class="text-muted small mb-3">
      Reload the page to get them back. You never need to call <code>flash_messages()</code>
      in a page template - doing so would render them twice.
    </p>

<pre class="mb-0"><code>{% verbatim %}{# in the controller #}
$this-&gt;addFlash('success', 'Demo Department was saved.');

{# in base.html.twig - already done, once, for every page #}
{% import 'components/notification/_macros.twig' as n %}
{{ n.flash_messages(app) }}{% endverbatim %}</code></pre>
  {{ d.card_end() }}

  {# ------------------------------------------------------------------- alerts #}

  {{ d.card_start('alert', {subtitle: 'An inline, in-page message. Types: success, info, warning, danger (and secondary).'}) }}
    {{ n.alert('success', 'Demo Department was saved.') }}
    {{ n.alert('info', 'Demo shifts are published every Monday.') }}
    {{ n.alert('warning', 'example@demo.invalid has not confirmed their address yet.') }}
    {{ n.alert('danger', 'Could not reach the demo server.') }}

    {{ d.section_header('Dismissible', {size: 'h6', subtitle: 'dismissible: true adds the close button (Bootstrap handles it, no JS of ours).'}) }}
    {{ n.alert('success', 'Dismissible success - click the ×.', {dismissible: true}) }}
    {{ n.alert('danger', 'Dismissible danger - click the ×.', {dismissible: true}) }}

    {{ d.section_header('With an icon', {size: 'h6', subtitle: 'icon: a short literal (emoji/glyph) rendered before the message.'}) }}
    {{ n.alert('info', 'Heads up - the demo event starts in 3 days.', {icon: 'ℹ️'}) }}
    {{ n.alert('warning', 'Two demo shifts overlap.', {icon: '⚠️', dismissible: true}) }}

    {{ d.section_header('Overflow: a long message', {size: 'h6', subtitle: 'Long text wraps; it must not push the card sideways.'}) }}
    {{ n.alert('warning', 'The demo import finished with warnings: 14 of the 120 rows in demo-volunteers.csv referenced a department that does not exist ("Demo Department Ω"), 3 rows had an unparseable start time, and 1 row (example@demo.invalid) was skipped because the address is already registered. Nothing was written to the database; fix the file and upload it again, or download the annotated copy to see exactly which rows were rejected and why.', {dismissible: true}) }}

    {{ d.section_header('Overflow: a multi-line message', {size: 'h6', subtitle: 'The message is escaped, so pass plain text with newlines; use <br> only via a captured, trusted set.'}) }}
    {% set multiline %}Demo import summary:
• 106 rows imported
• 14 rows skipped (unknown department)
• 0 rows updated{% endset %}
    <div style="white-space: pre-line;">
      {{ n.alert('info', multiline) }}
    </div>
    <p class="text-muted small">
      <code>alert()</code> escapes its message, so a literal <code>&lt;br&gt;</code> would be
      shown, not rendered. The block above keeps the newlines by putting the alert inside a
      <code>white-space: pre-line</code> wrapper - the only escaping-safe way with the macro as it stands.
    </p>

<pre class="mb-0"><code>{% verbatim %}{% import 'components/notification/_macros.twig' as n %}

{{ n.alert('success', 'Demo Department was saved.') }}
{{ n.alert('danger', 'Could not reach the demo server.', {dismissible: true}) }}
{{ n.alert('info', 'Heads up - the demo event starts in 3 days.', {icon: 'ℹ️'}) }}{% endverbatim %}</code></pre>
  {{ d.card_end() }}

  {# ------------------------------------------------------------------- toasts #}

  {{ d.card_start('toast', {subtitle: 'A transient, floating message. Shown by assets/js/notifications.js on click of [data-toast-target].'}) }}
    <p>
      Render the toast markup once (usually in a fixed-position container), then point any
      button at it with <code>data-toast-target="#itsId"</code>. The click handler is
      delegated on <code>document</code> and re-armed on <code>turbo:load</code>, so it keeps
      working across Turbo navigations. Bootstrap's <code>Toast</code> handles show/hide,
      <code>delay</code> and <code>autohide</code>.
    </p>

    <div class="d-flex gap-2 flex-wrap mb-3">
      <button class="btn btn-outline-primary" type="button" data-toast-target="#demoToast">
        Show toast
      </button>
      <button class="btn btn-outline-danger" type="button" data-toast-target="#demoToastSticky">
        Show sticky toast (no autohide)
      </button>
    </div>

<pre class="mb-0"><code>{% verbatim %}&lt;button type="button" class="btn btn-outline-primary" data-toast-target="#demoToast"&gt;
  Show toast
&lt;/button&gt;

&lt;div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1100;"&gt;
  {{ n.toast('demoToast', 'Heads up!', 'Demo Department was saved.', {type: 'primary', delay: 4000}) }}
  {{ n.toast('demoToastSticky', 'Sticky', 'Dismiss me by hand.', {type: 'danger', autohide: false}) }}
&lt;/div&gt;{% endverbatim %}</code></pre>
  {{ d.card_end() }}

  <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1100;">
    {{ n.toast('demoToast', 'Heads up!', 'Demo Department was saved.', {
      type: 'primary',
      delay: 4000
    }) }}
    {{ n.toast('demoToastSticky', 'Sticky', 'This toast stays until you dismiss it (autohide: false).', {
      type: 'danger',
      autohide: false
    }) }}
  </div>
{% endblock %}
