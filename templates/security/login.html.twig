{% extends 'base.html.twig' %}

{% import 'components/notification/_macros.twig' as n %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ eventName ? 'login.title.event'|trans({'%name%': eventName}) : 'login.title.default'|trans }}{% endblock %}

{% block body %}
    <div class="text-center mb-4">
        <h1 class="display-6 mb-2">{{ eventName ?: 'login.heading.default'|trans }}</h1>
        {% if welcomeMessage %}
            <p class="lead text-muted mb-0">{{ welcomeMessage }}</p>
        {% endif %}
    </div>

    {% set shownDates = timeline|filter(date => date is not null) %}
    {% if shownDates is not empty %}
        <div class="row g-3 justify-content-center mb-4">
            {% for label, date in shownDates %}
                {% set upcoming = date > date() %}
                <div class="col-6 col-md-3">
                    {{ d.card_start(null, {class: 'h-100 text-center ' ~ (upcoming ? '' : 'opacity-75'), bodyClass: 'card-body py-3'}) }}
                            <div class="text-muted small text-uppercase">{{ label|trans }}</div>
                            <div class="fw-semibold">{{ date|app_date }}</div>
                            <div class="small">{{ date|app_time }}</div>
                            {{ d.badge(
                                upcoming ? 'login.timeline.in_days'|trans({'%count%': date.diff(date()).days}) : 'login.timeline.passed'|trans,
                                upcoming ? 'text-bg-primary' : 'text-bg-secondary',
                                {class: 'mt-2'}
                            ) }}
                    {{ d.card_end({bodyClass: 'card-body py-3'}) }}
                </div>
            {% endfor %}
        </div>
    {% endif %}

    <div class="row justify-content-center">
        <div class="col-12 col-md-9 col-lg-6">
            {# With an identity provider connected, SSO is the way in for nearly everyone; the
               credential form is collapsed behind a link so it stops competing for attention.
               It stays expanded after a failed attempt, so the person retrying is not left
               hunting for the fields they just used. #}
            {% set sso = sso_enabled() %}
            {% set collapse_password = sso and passwordLoginEnabled and not error and last_username is empty %}

            {{ d.card_start('login.sign_in'|trans, {class: 'shadow-sm'}) }}
                    {% if error %}
                        {{ n.alert('danger', error.messageKey|trans(error.messageData, 'security'), { icon: '⚠️' }) }}
                    {% endif %}

                    {% if sso %}
                        <a href="{{ path('app_sso_start') }}" class="btn btn-primary btn-lg w-100">
                            🔐 {{ 'login.sso.sign_in_with'|trans({'%provider%': sso_provider_label()}) }}
                        </a>

                        {% if passwordLoginEnabled %}
                            <div class="text-center mt-3">
                                <a class="small text-muted" data-bs-toggle="collapse" href="#password-login"
                                   role="button" aria-expanded="{{ collapse_password ? 'false' : 'true' }}"
                                   aria-controls="password-login">
                                    {{ 'login.use_username_password'|trans }}
                                </a>
                            </div>
                        {% endif %}
                    {% endif %}

                    {% if passwordLoginEnabled %}
                        <div id="password-login" class="{{ collapse_password ? 'collapse' : (sso ? 'collapse show' : '') }}">
                            <form method="post" action="{{ path('app_login') }}" class="{{ sso ? 'mt-3' : '' }}">
                                <div class="mb-3">
                                    <label for="username" class="form-label">{{ 'login.field.username.label'|trans }}</label>
                                    <input type="text" id="username" name="_username"
                                           value="{{ last_username }}" class="form-control"
                                           autocomplete="username" required {% if not sso %}autofocus{% endif %}>
                                </div>

                                <div class="mb-3">
                                    <label for="password" class="form-label">{{ 'login.field.password.label'|trans }}</label>
                                    <input type="password" id="password" name="_password"
                                           class="form-control" autocomplete="current-password" required>
                                </div>

                                {#
                                    `authenticate` is a stateless CSRF id (config/packages/csrf.yaml), so this value is
                                    the sentinel `csrf-token` and the browser is expected to replace it with a random
                                    token it also writes to a cookie. That swap lives in csrf_protection_controller.js,
                                    which is a LAZY Stimulus controller: without this attribute the module is never
                                    loaded on a page built by hand, the form posts the bare sentinel, and the request is
                                    accepted on same origin alone.

                                    That is not merely weaker. SameOriginCsrfTokenManager refuses to let a session
                                    downgrade from double-submit to origin, so once a session has submitted any
                                    form-theme form it can no longer sign in here, and the login page simply
                                    re-renders with nothing to say. Every other form gets this attribute from the form
                                    theme; this one is written out by hand and has to ask for it.
                                #}
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}"
                                       data-controller="csrf-protection">

                                <button class="btn {{ sso ? 'btn-outline-secondary' : 'btn-primary' }} w-100" type="submit">
                                    {{ 'login.sign_in'|trans }}
                                </button>
                            </form>
                        </div>
                    {% endif %}
            {{ d.card_end() }}
        </div>
    </div>
{% endblock %}
