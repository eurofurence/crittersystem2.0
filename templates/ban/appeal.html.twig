{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}
{% block title %}Appeal{% endblock %}
{% block body %}
  {{ d.message_card_start('The Ledger-Keeper', {
    width: 'col-md-6',
    titleTag: 'h2',
    titleClass: 'card-title',
    bodyClass: 'card-body'
  }) }}
    <p>{{ message }}</p>
    {% if extraMessage %}<div class="alert alert-info">{{ extraMessage }}</div>{% endif %}
    {% if done %}
      <p class="text-success">If an account matches, your appeal has been forwarded for review.</p>
    {% else %}
      <p>If you believe this is a mistake, leave your email and we'll ask The Ledger-Keeper to take a look when he's back.</p>
      <form method="post">
        <div class="mb-3"><input type="email" name="email" class="form-control" placeholder="your email" required></div>
        <button class="btn btn-primary">Submit appeal</button>
      </form>
    {% endif %}
  {{ d.message_card_end() }}
{% endblock %}
