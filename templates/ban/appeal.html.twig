{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}
{% block title %}{{ 'ban.appeal.title'|trans }}{% endblock %}
{% block body %}
  {{ d.message_card_start('ban.appeal.heading'|trans, {
    width: 'col-md-6',
    titleTag: 'h2',
    titleClass: 'card-title',
    bodyClass: 'card-body'
  }) }}
    <p>{{ message }}</p>
    {% if extraMessage %}<div class="alert alert-info">{{ extraMessage }}</div>{% endif %}
    {% if done %}
      <p class="text-success">{{ 'ban.appeal.forwarded'|trans }}</p>
    {% else %}
      <p>{{ 'ban.appeal.instructions'|trans }}</p>
      <form method="post">
        <div class="mb-3"><input type="email" name="email" class="form-control" placeholder="{{ 'ban.appeal.email_placeholder'|trans }}" required></div>
        <button class="btn btn-primary">{{ 'ban.appeal.submit'|trans }}</button>
      </form>
    {% endif %}
  {{ d.message_card_end() }}
{% endblock %}
