{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}Certification scan{% endblock %}

{% block body %}
  <div class="row justify-content-center">
    <div class="col-12 col-md-7 col-lg-5">
      <div class="card text-center">
        <div class="card-body">
          <div class="display-6 mb-2">⚠️</div>
          {% if certification is defined %}
            <h1 class="h4 mb-2">{{ certification.title }}</h1>
          {% else %}
            <h1 class="h4 mb-2">Certification scan</h1>
          {% endif %}
          <p class="text-muted">{{ message }}</p>
          <a class="btn btn-outline-primary mt-2" href="{{ path('app_certifications_index') }}">Go to my certifications</a>
        </div>
      </div>
    </div>
  </div>
{% endblock %}
