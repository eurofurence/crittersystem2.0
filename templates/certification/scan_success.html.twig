{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ 'certification.scan.success_title'|trans({'%title%': certification.title}) }}{% endblock %}

{% block body %}
  {% set icon %}<div class="display-6 mb-2">🎉</div>{% endset %}
  {{ d.message_card_start(certification.title, {
    width: 'col-12 col-md-7 col-lg-5',
    class: 'text-center shadow-sm',
    bodyClass: 'card-body',
    titleTag: 'h1',
    titleClass: 'h4 mb-2',
    iconHtml: icon
  }) }}
          <p class="text-muted mb-3">{{ 'certification.scan.approved'|trans({'%name%': app.user.name}) }}</p>

          {% set details = [{ label: 'certification.field.certified_on'|trans, value: record.dateCertified|app_datetime }] %}
          {% if record.dateExpires %}
            {% set details = details|merge([{ label: 'certification.field.valid_until'|trans, value: record.dateExpires|app_date }]) %}
          {% else %}
            {% set details = details|merge([{ label: 'certification.field.validity'|trans, value: 'certification.validity.never'|trans }]) %}
          {% endif %}
          {{ d.definition_list(details, {
            class: 'mb-0 small text-start',
            labelCol: 'col-5',
            valueCol: 'col-7',
            labelClass: '',
            valueClass: ''
          }) }}

          <a class="btn btn-primary mt-3" href="{{ path('app_certifications_index') }}">{{ 'certification.action.my_certifications'|trans }}</a>
  {{ d.message_card_end() }}
{% endblock %}
