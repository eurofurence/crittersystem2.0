{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}Certified — {{ certification.title }}{% endblock %}

{% block body %}
  {% set icon %}<div class="display-6 mb-2">🎉</div>{% endset %}
  {{ d.message_card_start(certification.title, {
    width: 'col-12 col-md-7 col-lg-5',
    class: 'text-center shadow-sm',
    bodyClass: 'card-body',
    titleTag: 'h1',
    titleClass: 'h4 mb-2',
    iconHtml: icon
  }) }}
          <p class="text-muted mb-3">{{ app.user.name }}, your certification has been approved.</p>

          {% set details = [{ label: 'Certified on', value: record.dateCertified|app_datetime }] %}
          {% if record.dateExpires %}
            {% set details = details|merge([{ label: 'Valid until', value: record.dateExpires|app_date }]) %}
          {% else %}
            {% set details = details|merge([{ label: 'Validity', value: 'Never expires' }]) %}
          {% endif %}
          {{ d.definition_list(details, {
            class: 'mb-0 small text-start',
            labelCol: 'col-5',
            valueCol: 'col-7',
            labelClass: '',
            valueClass: ''
          }) }}

          <a class="btn btn-primary mt-3" href="{{ path('app_certifications_index') }}">My certifications</a>
  {{ d.message_card_end() }}
{% endblock %}
