{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}Certifications{% endblock %}

{% block body %}
  {# This page's own status vocabulary, passed into d.status_badge(). #}
  {% set certStyles = {
    'certified':      'text-bg-success',
    'pending':        'text-bg-warning',
    'self_confirmed': 'text-bg-info',
    'revoked':        'text-bg-danger',
    'expired':        'text-bg-secondary',
    'other':          'text-bg-secondary'
  } %}
  {% set certLabels = {
    'certified':      'Certified',
    'pending':        'Pending — scan the QR at the event',
    'self_confirmed': 'Self-confirmed',
    'revoked':        'Revoked',
    'expired':        'Expired'
  } %}

  {{ d.page_header('Certifications', {
    subtitle: 'Apply for the certifications you have. Approval happens in-person by scanning the operator\'s QR.',
    actions: is_granted('global:admin') ? [{label: 'Manage certifications', href: path('app_manage_certification_index'), class: 'btn btn-outline-primary'}] : []
  }) }}

  {% if rows is empty %}
    {{ d.empty_state('No certifications', {message: 'There are no active certifications to apply for.'}) }}
  {% else %}
    <div class="row">
      {% for row in rows %}
        {% set c = row.cert %}{% set r = row.record %}

        {% set bodyExtra %}
          <div class="small text-muted mt-1">
            {% if c.perpetual %}Never expires
            {% elseif c.validityPeriodDays %}{{ c.validityPeriodDays }} days validity
            {% endif %}
            {% if r and r.dateExpires %}<div>Expires {{ r.dateExpires|app_date }}</div>{% endif %}
          </div>
          <div class="mt-2">
            {% if r is null %}
              <span class="text-muted small">Not applied</span>
            {% else %}
              {% set certStatus = r.valid ? 'certified'
                : (r.status == 'pending' ? 'pending'
                : (r.status == 'self_confirmed' ? 'self_confirmed'
                : (r.status == 'revoked' ? 'revoked'
                : (r.expired ? 'expired' : 'other')))) %}
              {{ d.status_badge(certStatus, {
                map: certStyles,
                label: certLabels[certStatus]|default(r.status|capitalize)
              }) }}
            {% endif %}
          </div>
        {% endset %}

        {% set control %}
          {% if r is null %}
            <form method="post" action="{{ path('app_certifications_apply', {id: c.uuid}) }}" class="d-inline">
              <input type="hidden" name="_token" value="{{ csrf_token('cert-apply' ~ c.id) }}">
              <button class="btn btn-sm btn-primary">Apply</button>
            </form>
          {% endif %}
          {% if c.allowSelfConfirmation and (r is null or not r.valid) %}
            <form method="post" action="{{ path('app_certifications_self_confirm', {id: c.uuid}) }}" class="d-inline">
              <input type="hidden" name="_token" value="{{ csrf_token('cert-self' ~ c.id) }}">
              <button class="btn btn-sm btn-outline-success">Self-confirm</button>
            </form>
          {% endif %}
        {% endset %}

        {{ d.certification_card(c, {
          col: 'col-12 col-md-6 col-lg-4',
          infoUrl: path('app_certifications_show', {id: c.uuid}),
          bodyExtra: bodyExtra,
          control: control,
        }) }}
      {% endfor %}
    </div>
  {% endif %}
{% endblock %}
