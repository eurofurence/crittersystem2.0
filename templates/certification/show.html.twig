{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ cert.title }}{% endblock %}

{% block body %}
  {{ d.page_header(cert.title, {
    actions: [{label: 'certification.action.back_to_list'|trans, href: path('app_certifications_index'), class: 'btn btn-outline-secondary'}]
  }) }}

  <div class="row g-4">
    <div class="col-12 col-lg-7">
      {{ d.card_start(null, {class: ''}) }}
        {% if cert.description %}<p>{{ cert.description }}</p>{% else %}<p class="text-muted">{{ 'certification.field.no_description'|trans }}</p>{% endif %}

        {% set rows = [] %}
        {% set rows = rows|merge([{label: 'certification.field.validity'|trans, value: cert.perpetual ? 'certification.validity.never'|trans : (cert.validityPeriodDays ? 'certification.validity.days_short'|trans({'%count%': cert.validityPeriodDays}) : '-')}]) %}
        {% if cert.location %}{% set rows = rows|merge([{label: 'common.label.location'|trans, value: cert.location}]) %}{% endif %}
        {% if cert.contactPerson %}{% set rows = rows|merge([{label: 'certification.field.contact'|trans, value: cert.contactPerson}]) %}{% endif %}
        {% if cert.contactEmail %}{% set rows = rows|merge([{label: 'certification.field.contact_email'|trans, value: cert.contactEmail}]) %}{% endif %}
        {% set rows = rows|merge([{label: 'certification.field.self_confirmation'|trans, value: cert.allowSelfConfirmation ? 'certification.value.allowed'|trans : 'certification.value.not_allowed'|trans}]) %}

        {{ d.definition_list(rows) }}
      {{ d.card_end() }}
    </div>
  </div>
{% endblock %}
