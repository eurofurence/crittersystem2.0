{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ 'admin.sso.status.page.title'|trans }}{% endblock %}

{% block body %}
  {{ d.page_header('admin.sso.status.page.heading'|trans, {subtitle: 'admin.sso.status.page.subtitle'|trans}) }}

  {{ d.card_start(null, {class: ''}) }}
      <dl class="row mb-0">
        <dt class="col-sm-4">{{ 'common.state.enabled'|trans }}</dt>
        <dd class="col-sm-8">{% if enabled %}{{ d.badge('common.state.yes'|trans, 'text-bg-success') }}{% else %}{{ d.badge('common.state.no'|trans, 'text-bg-secondary') }}{% endif %}</dd>
        <dt class="col-sm-4">{{ 'admin.sso.status.field.provider'|trans }}</dt><dd class="col-sm-8">{{ provider }}</dd>
        <dt class="col-sm-4">{{ 'admin.sso.status.field.client_id'|trans }}</dt><dd class="col-sm-8"><code>{{ clientId }}</code></dd>
        <dt class="col-sm-4">{{ 'admin.sso.status.field.configuration'|trans }}</dt>
        <dd class="col-sm-8">{{ usesDiscovery ? 'admin.sso.status.config.automatic'|trans : 'admin.sso.status.config.manual'|trans }}{% if usesDiscovery %}<div class="text-muted small">{{ discoveryUrl }}</div>{% endif %}</dd>
        <dt class="col-sm-4">{{ 'admin.sso.status.field.discovery'|trans }}</dt>
        <dd class="col-sm-8">
          {% if discovery.ok %}{{ d.badge('admin.sso.status.reachable'|trans, 'text-bg-success') }}
          {% else %}{{ d.badge('admin.sso.status.unavailable'|trans, 'text-bg-danger') }} <span class="text-muted small">{{ discovery.error }}</span>{% endif %}
        </dd>
        {% if discovery.endpoints %}
          <dt class="col-sm-4">{{ 'admin.sso.status.field.authorization'|trans }}</dt><dd class="col-sm-8"><code class="small">{{ discovery.endpoints.authorization }}</code></dd>
          <dt class="col-sm-4">{{ 'admin.sso.status.field.token'|trans }}</dt><dd class="col-sm-8"><code class="small">{{ discovery.endpoints.token }}</code></dd>
          <dt class="col-sm-4">{{ 'admin.sso.status.field.userinfo'|trans }}</dt><dd class="col-sm-8"><code class="small">{{ discovery.endpoints.userinfo }}</code></dd>
        {% endif %}
        <dt class="col-sm-4">{{ 'admin.sso.status.field.redirect_uri'|trans }}</dt>
        <dd class="col-sm-8"><code class="small">{{ redirectUri }}</code><div class="text-muted small">{{ 'admin.sso.status.redirect_help'|trans }}</div></dd>
      </dl>
  {{ d.card_end() }}

  {% if enabled and app.user and app.user.isSsoManaged %}
    {{ d.card_start('admin.sso.status.userinfo.title'|trans, {class: 'mt-3'}) }}
        <p class="text-muted">{{ 'admin.sso.status.userinfo.help'|trans }}</p>
        {% if userinfo is not null %}
          {% if userinfo is empty %}
            <p class="text-muted">{{ 'admin.sso.status.userinfo.empty'|trans }}</p>
          {% else %}
            <div>
              <pre>
                {% if userinfo is iterable %}
                  {{ userinfo|json_encode(constant('JSON_PRETTY_PRINT')) }}
                {% else %}
                  {{ userinfo }}
                {% endif %}
              </pre>
            </div>
            <!-- <dl class="row mb-3">
              {% for key, value in userinfo %}
                <dt class="col-sm-4"><code>{{ key }}</code></dt>
                <dd class="col-sm-8"><code class="small">{% if value is iterable %}{{ value|json_encode }}{% else %}{{ value }}{% endif %}</code></dd>
              {% endfor %}
            </dl> -->
          {% endif %}
        {% endif %}
        <a href="{{ path('app_admin_sso_userinfo') }}" class="btn btn-primary">{{ 'admin.sso.status.userinfo.fetch'|trans }}</a>
    {{ d.card_end() }}
  {% endif %}

  {{ d.card_start('admin.sso.status.registration.title'|trans, {class: 'mt-3'}) }}
      <p class="text-muted">{{ 'admin.sso.status.registration.help'|trans }}</p>
      {{ form_start(registrationApiForm) }}
        {{ form_row(registrationApiForm.apiUrl) }}
        <button class="btn btn-primary">{{ 'common.action.save'|trans }}</button>
      {{ form_end(registrationApiForm) }}
  {{ d.card_end() }}
{% endblock %}
