{% extends 'base.html.twig' %}
{% import 'components/forms/_macros.twig' as f %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ 'admin.sso.roles.page.title'|trans }}{% endblock %}

{% block body %}
  {{ d.page_header('admin.sso.roles.page.title'|trans, {
    subtitle: 'admin.sso.roles.page.subtitle'|trans,
    actions: [{label: 'admin.sso.roles.back'|trans, href: path('app_manage'), class: 'btn btn-outline-secondary'}]
  }) }}

  {{ form_start(form) }}
    {{ d.card_start('admin.sso.roles.positions.title'|trans) }}
        <p class="mb-2 text-secondary">
          {{ 'admin.sso.roles.positions.intro'|trans|raw }}
        </p>
        <ul class="text-secondary">
          <li>{{ 'admin.sso.roles.positions.item.department_manager'|trans|raw }}</li>
          <li>{{ 'admin.sso.roles.positions.item.shift_manager'|trans|raw }}</li>
          <li>{{ 'admin.sso.roles.positions.item.department_staff'|trans|raw }}</li>
        </ul>
        <p class="text-secondary">
          {{ 'admin.sso.roles.positions.note'|trans }}
        </p>
        <div class="row">
          {{ f.field(form.departmentManagerRole, {col: 'col-12 col-md-6'}) }}
          {{ f.field(form.shiftManagerRole, {col: 'col-12 col-md-6'}) }}
        </div>
    {{ d.card_end() }}

    {{ d.card_start('admin.sso.roles.global.title'|trans) }}
        <p class="mb-2 text-secondary">
          {{ 'admin.sso.roles.global.intro'|trans|raw }}
        </p>
        <p class="text-secondary">
          {{ 'admin.sso.roles.global.note'|trans }}
        </p>
        <div class="row">
          {{ f.field(form.globalAdminRole, {col: 'col-12 col-md-6'}) }}
          {{ f.field(form.subAdminRole, {col: 'col-12 col-md-6'}) }}
        </div>
    {{ d.card_end() }}

    <button class="btn btn-primary">{{ 'common.action.save'|trans }}</button>
  {{ form_end(form) }}
{% endblock %}
