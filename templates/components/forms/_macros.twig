{% macro check(row, options = {}) %}
  {# options: col, label, help #}
  {% set col = options.col|default('col-12 col-md-6') %}
  <div class="{{ col }} mb-2">
    <div class="form-check">
      {% set cls = (row.vars.attr.class|default('') ~ ' form-check-input')|trim %}
      {{ form_widget(row, {'attr': row.vars.attr|merge({'class': cls}) }) }}
      {{ form_label(row, options.label|default(null), {'label_attr': {'class': 'form-check-label'}}) }}
    </div>
    {% if options.help is defined %}
      <div class="form-text">{{ options.help }}</div>
    {% endif %}
    {{ form_errors(row) }}
  </div>
{% endmacro %}

{# ------------------------------------------------------------------------------------------------------------------ #}

{% macro switch(row, options = {}) %}
  {# A checkbox rendered as a Bootstrap/Tabler toggle switch (.form-check.form-switch).
     Same contract as check(); options: col, label, help, attr (merged onto the input,
     e.g. Stimulus data-* wiring). #}
  {% set col = options.col|default('col-12 col-md-6') %}
  <div class="{{ col }} mb-2">
    <div class="form-check form-switch">
      {% set attr = row.vars.attr|merge(options.attr|default({})) %}
      {% set cls = (attr.class|default('') ~ ' form-check-input')|trim %}
      {{ form_widget(row, {'attr': attr|merge({'class': cls}) }) }}
      {{ form_label(row, options.label|default(null), {'label_attr': {'class': 'form-check-label'}}) }}
    </div>
    {% if options.help is defined %}
      <div class="form-text">{{ options.help }}</div>
    {% endif %}
    {{ form_errors(row) }}
  </div>
{% endmacro %}

