{% macro user_select(name, options = {}) %}
  {# Tag-style type-ahead user picker (username search). Submits one hidden `<name>[]` input per
     picked user, so it drops into a plain POST form. Behaviour is the user_select Stimulus controller.
     options:
       - url (required): JSON search endpoint, {results: [{id, name, staff, avatar}]}
       - label: field label (pass false to omit); default "Add users"
       - placeholder, help, col
       - minChars: characters before searching (default 1)
       - staffSuffix: append " (staff)" to staff names (default true)
       - selected: [{id, name, staff, avatar}] to pre-render as chips
  #}
  {% set col = options.col|default('col-12') %}
  {% set id = options.id|default('user-select-' ~ name) %}
  {% set withSuffix = options.staffSuffix is defined ? options.staffSuffix : true %}
  <div class="{{ col }} mb-3">
    {% if options.label is not same as(false) %}
      <label class="form-label" for="{{ id }}-input">{{ options.label|default('Add users') }}</label>
    {% endif %}
    <div class="user-select"
         data-controller="user-select"
         data-user-select-url-value="{{ options.url }}"
         data-user-select-name-value="{{ name }}"
         data-user-select-min-chars-value="{{ options.minChars|default(1) }}"
         data-user-select-staff-suffix-value="{{ withSuffix ? 'true' : 'false' }}">
      <div class="form-control user-select-control" data-user-select-target="control" data-action="click->user-select#focusInput">
        <span data-user-select-target="chips" class="d-contents">
          {% for u in options.selected|default([]) %}
            <span class="user-select-chip badge d-inline-flex align-items-center gap-1" data-user-select-id="{{ u.id }}">
              <span class="avatar avatar-xs"{% if u.avatar %} style="background-image: url('{{ u.avatar }}')"{% endif %}>{% if not u.avatar %}{{ u.name|slice(0, 2)|upper }}{% endif %}</span>
              <span>{{ u.name }}{{ withSuffix and u.staff ? ' (staff)' : '' }}</span>
              <button type="button" class="btn-close" aria-label="Remove {{ u.name }}"></button>
            </span>
          {% endfor %}
        </span>
        <input type="text" class="user-select-input" id="{{ id }}-input" autocomplete="off"
               placeholder="{{ options.placeholder|default('Type a username…') }}"
               data-user-select-target="input"
               data-action="input->user-select#onInput focus->user-select#onInput keydown->user-select#onKeydown">
      </div>
      <div class="dropdown-menu user-select-menu" data-user-select-target="menu" role="listbox"></div>
      <span data-user-select-target="hidden">
        {% for u in options.selected|default([]) %}
          <input type="hidden" name="{{ name }}[]" value="{{ u.id }}">
        {% endfor %}
      </span>
    </div>
    {% if options.help is defined %}
      <div class="form-text">{{ options.help }}</div>
    {% endif %}
  </div>
{% endmacro %}
