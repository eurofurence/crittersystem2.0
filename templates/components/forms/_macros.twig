{% macro search_input(name, options = {}) %}
  {# options:
     - col: string             -- wrapper column classes, default 'col-12'
     - id, label, placeholder, help
     - hideLabel: bool         -- keep the label for screen readers only (table-header searches)
     - turboFrame: string      -- id of the frame to swap; without it the input does nothing on its own
     - url: string             -- base URL for the request; needed when the frame has no src yet
     - param: string           -- query parameter to carry the term, default 'q'. Give each search on
                                  a page its own so several tables can be searched independently.
     - resetParams: list       -- query parameters dropped on every search, e.g. that table's page
                                  number, so a new term always lands on page 1
     - value: string           -- current term, so the box survives a reload
     - debounceMs: int         -- default 250
  #}
  {% set col = options.col|default('col-12') %}
  {% set id = options.id|default('search_' ~ name) %}
  {% set marginClass = options.col is defined and options.col == '' ? '' : ' mb-3' %}
  <div class="{{ col }}{{ marginClass }}">
    <label class="form-label{{ options.hideLabel|default(false) ? ' visually-hidden' : '' }}" for="{{ id }}">{{ options.label|default('common.action.search'|trans) }}</label>
    <input
      id="{{ id }}"
      name="{{ name }}"
      type="search"
      class="form-control"
      placeholder="{{ options.placeholder|default('common.search.placeholder'|trans) }}"
      autocomplete="off"
      value="{{ options.value|default('') }}"
      data-search-debounce="{{ options.debounceMs|default(250) }}"
      data-search-param="{{ options.param|default('q') }}"
      {% if options.resetParams is defined %}data-search-reset-params="{{ options.resetParams|join(',') }}"{% endif %}
      {% if options.url is defined %}data-search-url="{{ options.url }}"{% endif %}
      {% if options.turboFrame is defined %}data-search-turbo-frame="{{ options.turboFrame }}"{% endif %}
    />
    {% if options.help is defined %}
      <div class="form-text">{{ options.help }}</div>
    {% endif %}
  </div>
{% endmacro %}

