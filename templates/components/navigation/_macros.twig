{# Tabler navigation components. `options.icon` is a Tabler icon *slug*
   (see components/icon/_macros.twig), not an emoji.

   Twig's `|default` also fires on `''` and `false`, so options whose empty value is
   meaningful (`exact: false`, `active: false`) are read with `is defined ?`. #}

{# ------------------------------------------------------------------------------------------------------------------ #}

{% macro nav_item(label, routeName = null, options = {}) %}
{# options:
    - href (string)   -- use instead of routeName for a plain/external link
    - active (bool)   -- force the active state, for links the router cannot resolve
    - icon (Tabler icon slug, optional)
    - exact (bool, default true)
    - params (route params)
    - badge (optional)
    - class (optional)
#}
{% import 'components/icon/_macros.twig' as i %}
{% set params = options.params|default({}) %}
{% set current = app.request.attributes.get('_route') %}
{% set href = options.href|default(routeName ? path(routeName, params) : '#') %}
{% set isActive = options.active is defined ? options.active : false %}
{% if routeName and not isActive %}
    {% if options.exact is defined ? options.exact : true %}
        {% set isActive = (current == routeName) %}
    {% else %}
        {% set isActive = current starts with routeName %}
    {% endif %}
{% endif %}

<li class="nav-item {% if isActive %}active{% endif %}">
    <a class="nav-link {{ options.class|default('') }}"
       href="{{ href }}"
       {% if isActive %}aria-current="page"{% endif %}>
        {% if options.icon is defined %}
            <span class="nav-link-icon d-md-none d-lg-inline-block">{{ i.icon(options.icon) }}</span>
        {% endif %}
        <span class="nav-link-title">{{ label }}</span>
        {% if options.badge is defined %}<span class="badge bg-secondary-lt ms-2">{{ options.badge }}</span>{% endif %}
    </a>
</li>
{% endmacro %}

{# ------------------------------------------------------------------------------------------------------------------ #}

{% macro sidebar_item(label, routeName = null, options = {}) %}
{# Vertical list-group style entry.
   options:
    - href: string  -- use instead of routeName for a plain/external link
    - active: bool  -- force the active state, for links the router cannot resolve
                       (e.g. an in-page anchor like href="#profile")
    - icon, exact (default true), params, badge
#}
{% import 'components/icon/_macros.twig' as i %}
{% set params = options.params|default({}) %}
{% set current = app.request.attributes.get('_route') %}
{% set href = options.href|default(routeName ? path(routeName, params) : '#') %}

{% set isActive = options.active is defined ? options.active : false %}
{% if routeName and not isActive %}
    {% if options.exact is defined ? options.exact : true %}
        {% set isActive = (current == routeName) %}
    {% else %}
        {% set isActive = current starts with routeName %}
    {% endif %}
{% endif %}

<a class="list-group-item list-group-item-action d-flex align-items-center gap-2
            {% if isActive %}active{% endif %}"
    href="{{ href }}"
    {% if isActive %}aria-current="page"{% endif %}>
    {% if options.icon is defined %}{{ i.icon(options.icon, {class: 'icon-1 text-muted'}) }}{% endif %}
    <span class="flex-grow-1">{{ label }}</span>
    {% if options.badge is defined %}<span class="badge bg-secondary-lt">{{ options.badge }}</span>{% endif %}
</a>
{% endmacro %}

{# ------------------------------------------------------------------------------------------------------------------ #}

{% macro sidebar(title, contentHtml) %}
<div class="card">
    <div class="card-header"><h3 class="card-title">{{ title }}</h3></div>
    <div class="list-group list-group-flush">
    {{ contentHtml|raw }}
    </div>
</div>
{% endmacro %}
