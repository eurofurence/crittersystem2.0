{# Generic, reusable Tabler UI structures. Rules for everything in this file:

   - No business logic and no authorization decisions. A macro renders what it is given;
     the caller decides whether the user may see it (`{% if is_granted(...) %}`).
   - No CSRF tokens are minted here. `delete_form()` takes a token; it never creates one.
   - Values are escaped by default. The only parameters that accept trusted HTML are the
     ones named `...Html` or documented as "captured markup" — pass a `{% set x %}…{% endset %}`
     block, never user input.
   - `attrs` maps render as literal HTML attributes: keys are written verbatim (so they must
     be developer-authored, not user input), values are escaped.
   - Twig's `|default` also fires on `''` and `false`. Options where an empty string or false
     is meaningful (`class: ''`, `bodyClass: ''`, `exact: false`) MUST be read with
     `options.x is defined ? options.x : <fallback>`, never with `|default`.

   See docs/ui-components.md for the full reference.
#}

{# {id: 'x', 'data-foo': 'bar'} -> id="x" data-foo="bar" #}
{% macro attrs(attrs = {}) %}
  {%- for name, value in attrs %} {{ name }}="{{ value }}"{% endfor -%}
{% endmacro %}

{# ------------------------------------------------------------------------------------------------------------------ #}

{% macro page_header(title, options = {}) %}
  {# options:
     - subtitle: string
     - actions: array of {label, href, class}  -- plain links, the common case
     - actionsHtml: markup -- trusted captured HTML, rendered after the links. The escape hatch
                              for a header that needs a form, a dropdown or an icon button, so
                              such a page does not have to fork this macro.
  #}
  <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-md-between gap-2 mb-3">
    <div>
      <h1 class="h3 mb-0">{{ title }}</h1>
      {% if options.subtitle is defined and options.subtitle %}
        <div class="text-muted">{{ options.subtitle }}</div>
      {% endif %}
    </div>

    {% if (options.actions is defined and options.actions) or options.actionsHtml is defined %}
      <div class="d-flex gap-2">
        {% for a in options.actions|default([]) %}
          <a href="{{ a.href }}" class="{{ a.class|default('btn btn-primary') }}">
            {{ a.label }}
          </a>
        {% endfor %}
        {% if options.actionsHtml is defined %}{{ options.actionsHtml|raw }}{% endif %}
      </div>
    {% endif %}
  </div>
{% endmacro %}

{# ------------------------------------------------------------------------------------------------------------------ #}

{% macro section_header(title, options = {}) %}
  {# A heading *inside* a page (not the page title — that is page_header).
     options:
     - level: int (2..6, default 2)     -- semantic heading level
     - size: string (default 'h5')      -- visual size class
     - subtitle: string
     - class: string                    -- extra classes on the wrapper
  #}
  {% set level = options.level|default(2) %}
  <div class="{{ options.class is defined ? options.class : 'mt-3 mb-2' }}">
    <h{{ level }} class="{{ options.size|default('h5') }} mb-0">{{ title }}</h{{ level }}>
    {% if options.subtitle is defined and options.subtitle %}
      <div class="text-muted small">{{ options.subtitle }}</div>
    {% endif %}
  </div>
{% endmacro %}

{# ------------------------------------------------------------------------------------------------------------------ #}

{% macro card_start(title = null, options = {}) %}
  {# Opens a card, and (unless bodyClass is '') its card-body. Pair with card_end();
     `bodyClass` and `tag` must match on both calls.

     options:
     - class: string           -- extra classes on .card (e.g. 'h-100', 'border-danger')
     - tag: 'div'|'form'       -- 'form' renders <form class="card">
     - attrs: map              -- literal attributes (method/action on a form, data-*, id, …)
     - subtitle: string
     - titleTag: string        -- default 'h3'
     - titleClass: string      -- default 'card-title mb-0'; override for headers whose title is
                                  not a .card-title (e.g. 'fw-semibold')
     - headerActions: markup   -- trusted captured HTML, right-aligned in the header
     - headerClass: string
     - bodyClass: string       -- default 'card-body'; pass '' for a card that wraps a
                                  .card-table or a .table-responsive directly
  #}
  {% set tag = options.tag|default('div') %}
  {% set hasHeader = title is not empty or options.headerActions is defined %}
  <{{ tag }} class="{{ ('card ' ~ (options.class is defined ? options.class : 'mb-3'))|trim }}"{{ _self.attrs(options.attrs|default({})) }}>
    {% if hasHeader %}
      <div class="{{ options.headerClass is defined ? options.headerClass : 'card-header' }}{% if options.headerActions is defined %} d-flex justify-content-between align-items-center{% endif %}">
        {% if title is not empty %}
          <div>
            <{{ options.titleTag|default('h3') }} class="{{ options.titleClass is defined ? options.titleClass : 'card-title mb-0' }}">{{ title }}</{{ options.titleTag|default('h3') }}>
            {% if options.subtitle is defined and options.subtitle %}
              <div class="text-muted small">{{ options.subtitle }}</div>
            {% endif %}
          </div>
        {% endif %}
        {% if options.headerActions is defined %}
          <div class="d-flex gap-2 align-items-center">{{ options.headerActions|raw }}</div>
        {% endif %}
      </div>
    {% endif %}
    {% set bodyClass = options.bodyClass is defined ? options.bodyClass : 'card-body' %}
    {% if bodyClass is not empty %}
      <div class="{{ bodyClass }}">
    {% endif %}
{% endmacro %}

{% macro card_end(options = {}) %}
  {# options:
     - bodyClass: string   -- must match the card_start() call (only matters when it was '')
     - footer: markup      -- trusted captured HTML
     - footerClass: string -- default 'card-footer'
     - tag: 'div'|'form'   -- must match the card_start() call
  #}
  {% set bodyClass = options.bodyClass is defined ? options.bodyClass : 'card-body' %}
  {% if bodyClass is not empty %}
      </div>
  {% endif %}
  {% if options.footer is defined %}
    <div class="{{ options.footerClass is defined ? options.footerClass : 'card-footer' }}">{{ options.footer|raw }}</div>
  {% endif %}
  </{{ options.tag|default('div') }}>
{% endmacro %}

{# ------------------------------------------------------------------------------------------------------------------ #}

{% macro message_card_start(title, options = {}) %}
  {# The centred single-message page (confirm / done / invalid / scanned). Content between
     start and end goes inside the card body, under the title — typically a <p> and an
     optional form.

     options:
     - width: string      -- default 'col-md-6 col-lg-5'
     - class: string      -- extra classes on .card
     - titleTag: string   -- default 'h1' (this IS the page's heading)
     - titleClass: string -- default 'card-title'
     - bodyClass: string  -- default 'card-body text-center'; pass 'card-body' for a page
                             whose body is left-aligned (e.g. a form)
     - iconHtml: markup   -- trusted captured HTML rendered ABOVE the title (the emoji/status
                             glyph these pages lead with)
  #}
  <div class="row justify-content-center">
    <div class="{{ options.width|default('col-md-6 col-lg-5') }}">
      <div class="{{ ('card ' ~ options.class|default(''))|trim }}">
        <div class="{{ options.bodyClass is defined ? options.bodyClass : 'card-body text-center' }}">
          {% if options.iconHtml is defined %}{{ options.iconHtml|raw }}{% endif %}
          <{{ options.titleTag|default('h1') }} class="{{ options.titleClass is defined ? options.titleClass : 'card-title' }}">{{ title }}</{{ options.titleTag|default('h1') }}>
{% endmacro %}

{% macro message_card_end() %}
        </div>
      </div>
    </div>
  </div>
{% endmacro %}

{# ------------------------------------------------------------------------------------------------------------------ #}

{% macro action_card(title, options = {}) %}
  {# A tile in a dashboard/index grid: icon + title + description, whole card clickable.
     Wrap a set of these in <div class="row row-cards">.
     options:
     - text: string
     - href: string          -- makes the whole card clickable (stretched-link)
     - iconHtml: markup      -- trusted captured HTML (e.g. an i.icon() call or an emoji span)
     - col: string           -- default 'col-sm-6 col-lg-4'
     - class: string         -- extra classes on .card
  #}
  <div class="{{ options.col|default('col-sm-6 col-lg-4') }}">
    <div class="{{ ('card card-link h-100 ' ~ options.class|default(''))|trim }}">
      <div class="card-body">
        <div class="d-flex align-items-center gap-2 mb-1">
          {% if options.iconHtml is defined %}<span class="text-muted">{{ options.iconHtml|raw }}</span>{% endif %}
          <h3 class="card-title mb-0">
            {% if options.href is defined and options.href %}
              <a href="{{ options.href }}" class="stretched-link text-reset text-decoration-none">{{ title }}</a>
            {% else %}
              {{ title }}
            {% endif %}
          </h3>
        </div>
        {% if options.text is defined and options.text %}
          <div class="text-muted">{{ options.text }}</div>
        {% endif %}
      </div>
    </div>
  </div>
{% endmacro %}

{# ------------------------------------------------------------------------------------------------------------------ #}

{% macro stat_card(value, label, options = {}) %}
  {# Big number + caption. Wrap a set of these in <div class="row">.
     options:
     - col: string   -- default 'col-6 col-md-3'
     - size: string  -- default 'fs-3' (font-size class for the value)
     - class: string -- extra classes on .card
  #}
  <div class="{{ options.col|default('col-6 col-md-3') }}">
    <div class="{{ ('card text-center ' ~ options.class|default(''))|trim }}">
      <div class="card-body">
        <div class="{{ options.size|default('fs-3') }}">{{ value }}</div>
        <div class="text-muted small">{{ label }}</div>
      </div>
    </div>
  </div>
{% endmacro %}

{# ------------------------------------------------------------------------------------------------------------------ #}

{% macro definition_list(items, options = {}) %}
  {# items: array of {label, value} (values are escaped).
     options:
     - labelCol / valueCol: string -- default 'col-5' / 'col-7'
     - labelClass / valueClass: string -- the <dt>/<dd> utility classes ('' is allowed)
     - class: string -- classes on the <dl>
  #}
  {% set labelClass = options.labelClass is defined ? options.labelClass : 'text-muted fw-normal' %}
  {% set valueClass = options.valueClass is defined ? options.valueClass : 'mb-1' %}
  <dl class="row {{ options.class is defined ? options.class : 'mb-0' }}">
    {% for item in items %}
      <dt class="{{ (options.labelCol|default('col-5') ~ ' ' ~ labelClass)|trim }}">{{ item.label }}</dt>
      <dd class="{{ (options.valueCol|default('col-7') ~ ' ' ~ valueClass)|trim }}">{{ item.value }}</dd>
    {% endfor %}
  </dl>
{% endmacro %}

{# ------------------------------------------------------------------------------------------------------------------ #}

{% macro badge(text, style = 'text-bg-secondary', options = {}) %}
  {# options:
     - class: string -- extra utility classes (me-1, d-block, …)
     - attrs: map    -- title, aria-label, data-*
  #}
  <span class="badge {{ style }}{% if options.class is defined %} {{ options.class }}{% endif %}"{{ _self.attrs(options.attrs|default({})) }}>{{ text }}</span>
{% endmacro %}

{% macro status_badge(status, options = {}) %}
  {# Maps a status word to a Tabler soft "-lt" badge.
     options:
     - map: {status(lowercase): style} -- merged over the defaults, so callers with their own
                                          vocabulary extend the map instead of forking this macro
     - class / attrs: passed through to badge()
     - label: string -- display text, when it differs from the status key
  #}
  {% set styles = {
    'active': 'bg-green-lt', 'enabled': 'bg-green-lt', 'open': 'bg-green-lt', 'ok': 'bg-green-lt', 'approved': 'bg-green-lt',
    'pending': 'bg-yellow-lt', 'waiting': 'bg-yellow-lt', 'draft': 'bg-yellow-lt',
    'disabled': 'bg-secondary-lt', 'closed': 'bg-secondary-lt', 'inactive': 'bg-secondary-lt',
    'error': 'bg-red-lt', 'blocked': 'bg-red-lt', 'rejected': 'bg-red-lt', 'failed': 'bg-red-lt'
  }|merge(options.map|default({})) %}
  {% set style = styles[status|lower]|default('bg-blue-lt') %}
  {{ _self.badge(options.label|default(status), style, options) }}
{% endmacro %}

{# ------------------------------------------------------------------------------------------------------------------ #}

{% macro empty_state(title, options = {}) %}
  {# The full-height Tabler .empty block — for a whole page/section with no content.
     For "this small list is empty", use empty_inline(); inside a table, empty_row().
     options:
     - message: string
     - iconHtml: markup -- trusted captured HTML
     - actionLabel/actionHref/actionClass
  #}
  <div class="empty">
    {% if options.iconHtml is defined %}
      <div class="empty-icon">{{ options.iconHtml|raw }}</div>
    {% endif %}
    <p class="empty-title">{{ title }}</p>
    {% if options.message is defined and options.message %}
      <p class="empty-subtitle text-secondary">{{ options.message }}</p>
    {% endif %}

    {% if options.actionLabel is defined and options.actionHref is defined %}
      <div class="empty-action">
        <a href="{{ options.actionHref }}" class="{{ options.actionClass|default('btn btn-primary') }}">
          {{ options.actionLabel }}
        </a>
      </div>
    {% endif %}
  </div>
{% endmacro %}

{% macro empty_inline(message, options = {}) %}
  {# The lightweight "nothing here" line, for use inside a card, where empty_state()'s
     full-height block is too heavy.
     options:
     - tag: string   -- default 'p'
     - class: string -- default 'text-muted mb-0'
  #}
  {% set tag = options.tag|default('p') %}
  <{{ tag }} class="{{ options.class|default('text-muted mb-0') }}">{{ message }}</{{ tag }}>
{% endmacro %}

{% macro empty_row(colspan, message, options = {}) %}
  {# An empty-state row inside a <tbody>. #}
  <tr>
    <td colspan="{{ colspan }}" class="{{ options.class|default('text-secondary text-center py-3') }}">{{ message }}</td>
  </tr>
{% endmacro %}

{# ------------------------------------------------------------------------------------------------------------------ #}

{% macro table_start(options = {}) %}
  {# options:
     - striped (default true), hover (default true), compact (default false)
     - class: string        -- extra classes (e.g. 'table-vcenter card-table', 'align-middle')
     - responsive: bool     -- default true; pass false inside a card that uses .card-table
     - attrs: map
     Pair with table_end(), passing the SAME `responsive` value.
  #}
  {% set classes = ['table'] %}
  {% if options.striped is defined ? options.striped : true %}{% set classes = classes|merge(['table-striped']) %}{% endif %}
  {% if options.hover is defined ? options.hover : true %}{% set classes = classes|merge(['table-hover']) %}{% endif %}
  {% if options.compact is defined ? options.compact : false %}{% set classes = classes|merge(['table-sm']) %}{% endif %}
  {% if options.class is defined %}{% set classes = classes|merge([options.class]) %}{% endif %}

  {% if options.responsive is defined ? options.responsive : true %}
  <div class="table-responsive">
  {% endif %}
    <table class="{{ classes|join(' ') }}"{{ _self.attrs(options.attrs|default({})) }}>
{% endmacro %}

{% macro table_end(options = {}) %}
    </table>
  {% if options.responsive is defined ? options.responsive : true %}
  </div>
  {% endif %}
{% endmacro %}

{# ------------------------------------------------------------------------------------------------------------------ #}

{% macro delete_form(action, token, options = {}) %}
  {# The destructive-action form used across the CRUD index pages: a POST form with a CSRF
     token and the `confirm` Stimulus controller (never window.confirm()).

     The CSRF token is ALWAYS supplied by the caller: `csrf_token('delete' ~ x.id)`. This
     macro must not mint one — a generic UI component makes no security decisions.

     options:
     - label: string   -- button text, default 'Delete'
     - message: string -- confirm text, default 'Are you sure?'
     - class: string   -- button classes, default 'btn btn-sm btn-outline-danger'
     - tokenName: string -- name of the hidden field, default '_token'
     - confirmTitle / confirmLabel / variant: string
                       -- the confirm modal's title, its confirm-button label, and its variant
                          (see assets/controllers/confirm_controller.js)
     - attrs: map      -- extra attributes on the <form>
  #}
  <form method="post" action="{{ action }}" class="d-inline"
        data-controller="confirm" data-confirm-message-value="{{ options.message|default('Are you sure?') }}"
        {%- if options.confirmTitle is defined %} data-confirm-title-value="{{ options.confirmTitle }}"{% endif %}
        {%- if options.confirmLabel is defined %} data-confirm-confirm-label-value="{{ options.confirmLabel }}"{% endif %}
        {%- if options.variant is defined %} data-confirm-variant-value="{{ options.variant }}"{% endif %}
        {{- _self.attrs(options.attrs|default({})) }}>
    <input type="hidden" name="{{ options.tokenName|default('_token') }}" value="{{ token }}">
    <button class="{{ options.class|default('btn btn-sm btn-outline-danger') }}">{{ options.label|default('Delete') }}</button>
  </form>
{% endmacro %}

{% macro row_actions(actions = [], options = {}) %}
  {# The trailing action cell of a CRUD table row.
     actions: array of {label, href, class}. Permission checks belong in the CALLER — build
     the array conditionally; this macro renders whatever it is handed.
     For a destructive action, render delete_form() inside `extraHtml`.

     options:
     - extraHtml: markup -- trusted captured HTML appended after the links (e.g. delete_form)
     - cell: bool        -- default true; wrap in <td>. false = just the buttons.
     - class: string     -- classes on the <td>
  #}
  {% set cell = options.cell is defined ? options.cell : true %}
  {% if cell %}<td class="{{ options.class|default('text-end text-nowrap') }}">{% endif %}
    {% for a in actions %}
      <a href="{{ a.href }}" class="{{ a.class|default('btn btn-sm btn-outline-primary') }}">{{ a.label }}</a>
    {% endfor %}
    {% if options.extraHtml is defined %}{{ options.extraHtml|raw }}{% endif %}
  {% if cell %}</td>{% endif %}
{% endmacro %}

{# ------------------------------------------------------------------------------------------------------------------ #}

{% macro certification_card(cert, options = {}) %}
  {# One certification as a card: title + description, with a caller-supplied control in the
     footer (a toggle switch when picking requirements, apply/self-confirm buttons on the
     volunteer-facing list). Wrap a set of these in <div class="row">.
     cert: anything exposing .title and .description (the Certification entity).
     options:
     - col: string          -- default 'col-md-6 col-lg-3'
     - infoUrl: string      -- renders a "More information" link in the footer when truthy
     - control: markup       -- trusted captured HTML shown at the footer's right (switch, buttons)
     - bodyExtra: markup     -- trusted captured HTML appended under the description (status, validity)
  #}
  {% set hasBody = cert.description or (options.bodyExtra is defined and options.bodyExtra) %}
  {% set hasFooter = (options.infoUrl is defined and options.infoUrl) or (options.control is defined and options.control) %}
  <div class="{{ options.col|default('col-md-6 col-lg-3') }} mb-3">
    <div class="card h-100">
      <div class="card-header">
        <h3 class="card-title">{{ cert.title }}</h3>
      </div>
      {% if hasBody %}
        <div class="card-body">
          {% if cert.description %}<p class="text-secondary{{ (options.bodyExtra is defined and options.bodyExtra) ? '' : ' mb-0' }}">{{ cert.description }}</p>{% endif %}
          {% if options.bodyExtra is defined %}{{ options.bodyExtra|raw }}{% endif %}
        </div>
      {% endif %}
      {% if hasFooter %}
        <div class="card-footer mt-auto">
          <div class="row align-items-center">
            <div class="col-auto">
              {% if options.infoUrl is defined and options.infoUrl %}<a href="{{ options.infoUrl }}">More information</a>{% endif %}
            </div>
            <div class="col-auto ms-auto">
              {% if options.control is defined %}{{ options.control|raw }}{% endif %}
            </div>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
{% endmacro %}
