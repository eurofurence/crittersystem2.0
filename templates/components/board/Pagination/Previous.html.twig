{# The kit ships these icons via ux-icons, which this project does not install; the shared icon
   macro is used instead. Components installed by the toolkit are ours to edit. #}
{# @prop text string The label text. #}
{%- props text = 'Previous' -%}
<twig:Pagination:Link
    aria-label="Go to previous page"
    size="default"
    class="{{ ('ltr:pl-1.5! rtl:ps-1.5! ' ~ attributes.render('class'))|tailwind_merge }}"
    {{ ...attributes.without('class') }}
>
    {% import 'components/icon/_macros.twig' as icons %}{{ icons.icon('chevron-left', {class: 'rtl:rotate-180'}) }}
    <span class="hidden sm:block">{{ text }}</span>
</twig:Pagination:Link>
