{# The kit ships these icons via ux-icons, which this project does not install; the shared icon
   macro is used instead. Components installed by the toolkit are ours to edit. #}
<span
    aria-hidden="true"
    data-slot="pagination-ellipsis"
    class="{{ ('flex size-8 items-center justify-center [&_svg:not([class*=\'size-\'])]:size-4 ' ~ attributes.render('class'))|tailwind_merge }}"
    {{ attributes.without('class') }}
>
    {% import 'components/icon/_macros.twig' as icons %}{{ icons.icon('point') }}
    <span class="sr-only">More pages</span>
</span>
