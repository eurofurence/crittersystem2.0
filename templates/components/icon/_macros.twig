{#
   Inline Tabler SVG icons (https://tabler.io/icons), 24×24 stroke icons that
   inherit `currentColor`, so they pick up the active theme automatically.

   Usage:
     {% import 'components/icon/_macros.twig' as i %}
     {{ i.icon('home') }}
     {{ i.icon('plus', {class: 'icon-2'}) }}

   `name` is a Tabler icon slug from the map below. Add an icon by pasting its
   inner `<path>` markup from https://tabler.io/icons. Unknown names fall back
   to a neutral dot so a typo never breaks the layout.
#}

{% macro icon(name, options = {}) %}
{# options:
    - class: extra classes (e.g. 'icon-2' for a larger Tabler size)

   The icon map lives inside the macro because a Twig macro is isolated and cannot
   read a variable set at file level.
#}
