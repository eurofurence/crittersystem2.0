{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{# Intentionally untranslated. This page is a fixed reference/mural: the wording is
   the same in every locale, so the text is written inline rather than through the
   translation catalogs. #}

{% block title %}About the Critter System{% endblock %}

{% block body %}
  {{ d.page_header('About the Critter System', {subtitle: 'Volunteer Management System (VMS)'}) }}

  <div class="row g-3">
    <div class="col-12 col-lg-8">
      {{ d.card_start('What this is') }}
        <p class="mb-2">
          The Volunteer Management System (VMS) coordinates the people who make an event happen:
          their accounts, roles, departments, shifts, and sign-ups.
        </p>
        <p class="mb-2">
          At Eurofurence we call it: <strong>The Critter Management System (CMS)</strong>
        </p>
        <p class="mb-2">
          This version is <strong>Critter 2.0</strong>, a ground-up rewrite of the original tool. It covers the
          whole volunteer lifecycle: registration and onboarding, department and role management,
          shift planning and sign-up, check-in, and reporting.
        </p>
        <p class="mb-2">
          The goal is simple: give organisers a clear view of who is helping and when, and give volunteers an easy way to find and take the
          shifts that fit them.
        </p>
      {{ d.card_end() }}
    </div>

    <div class="col-12 col-lg-4">
      {{ d.card_start('Credits') }}
        <p class="mb-2">
          Built by and for Eurofurence volunteers (Critters) and Staff Team, and for everyone who gives their time
          to keep the event running.
        </p>
        <p class="mb-0">
          Source code and contributions:
          <a href="https://github.com/eurofurence/crittersystem2.0" target="_blank" rel="noopener noreferrer">github.com/eurofurence/crittersystem2.0</a>.
        </p>
      {{ d.card_end() }}

      {{ d.card_start('Deployment') }}
        <p class="mb-0 text-muted">
          Version: <code>{{ version }}</code>
        </p>
      {{ d.card_end() }}
    </div>
  </div>
{% endblock %}
