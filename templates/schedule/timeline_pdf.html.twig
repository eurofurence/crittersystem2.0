<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    * { font-family: 'DejaVu Sans', sans-serif; }
    body { font-size: 9px; color: #1a2230; }
    h1 { font-size: 14px; margin: 0 0 2px; }
    .sub { color: #666; font-size: 9px; margin: 0 0 8px; }
    table { width: 100%; border-collapse: collapse; }
    th, td { border: 1px solid #cfd6e4; padding: 2px 3px; vertical-align: top; }
    th { background: #eef1f7; text-align: left; }
    .user { width: 90px; font-weight: bold; }
    .block { background: #dbe7fb; border: 1px solid #4b7bd6; border-radius: 2px; padding: 1px 2px; margin-bottom: 2px; }
    .time { font-weight: bold; }
    /* Location rotated 90° so long names fit the narrow print columns. */
    .loc { display: inline-block; transform: rotate(-90deg); transform-origin: left top; color: #33507f; white-space: nowrap; }
  </style>
</head>
<body>
  <h1>{{ 'schedule.page.title'|trans({'%department%': department.name}) }}</h1>
  <p class="sub">{{ 'schedule.pdf.subtitle'|trans }}</p>

  <table>
    <thead>
      <tr>
        <th class="user">{{ 'common.label.user'|trans }}</th>
        {% for day in days %}<th>{{ day.label }}</th>{% endfor %}
      </tr>
    </thead>
    <tbody>
      {% for row in rows %}
        <tr>
          <td class="user">{{ row.user.name }}</td>
          {% for day in days %}
            {% set dayIndex = loop.index0 %}
            <td>
              {% for block in row.blocks|filter(b => b.dayIndex == dayIndex) %}
                <div class="block">
                  <span class="time">{{ block.startsAt|app_time }}–{{ block.endsAt|app_time }}</span>
                  {% if block.location %}<span class="loc">{{ block.location }}</span>{% endif %}
                </div>
              {% endfor %}
            </td>
          {% endfor %}
        </tr>
      {% else %}
        <tr><td colspan="{{ 1 + days|length }}">{{ 'schedule.pdf.empty'|trans }}</td></tr>
      {% endfor %}
    </tbody>
  </table>
</body>
</html>
