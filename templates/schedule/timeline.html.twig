{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ 'schedule.page.title'|trans({'%department%': department.name}) }}{% endblock %}

{% block body %}
  {{ d.page_header('schedule.header.title'|trans, {
    subtitle: 'schedule.header.subtitle'|trans,
    actions: [
      {label: 'schedule.action.download_pdf'|trans, href: path('app_schedule_timeline_pdf', {department: department.uuid}), class: 'btn btn-outline-primary'},
      {label: 'schedule.action.back_to_grid'|trans, href: path('app_department_grid', {department: department.uuid}), class: 'btn btn-outline-secondary'}
    ]
  }) }}

  {{ d.card_start(null, {bodyClass: 'card-body py-2'}) }}
      <form method="get" class="d-flex align-items-end gap-2">
        <div>
          <label class="form-label mb-1" for="sched-department">{{ 'common.label.department'|trans }}</label>
          <select id="sched-department" name="department" class="form-select" onchange="this.form.submit()">
            {% for dept in departments %}
              <option value="{{ dept.uuid }}" {{ dept.uuid == department.uuid ? 'selected' : '' }}>{{ dept.name }}</option>
            {% endfor %}
          </select>
        </div>
      </form>
  {{ d.card_end({bodyClass: 'card-body py-2'}) }}

  {% if rows is empty %}
    {{ d.empty_state('schedule.empty.title'|trans, {message: 'schedule.empty.message'|trans}) }}
  {% else %}
    {# The time column and the name row are frozen: a tick in the middle of a wide schedule means
       nothing once the name or the hour has scrolled off. #}
    <div class="schedule-scroll">
      <table class="table table-sm schedule-table">
        <thead>
          <tr>
            <th class="schedule-corner">{{ 'schedule.table.when'|trans }}</th>
            {% for user in users %}
              <th class="schedule-name" title="{{ user.name }}">{{ user.name }}</th>
            {% else %}
              <th class="schedule-name">{{ 'schedule.table.nobody'|trans }}</th>
            {% endfor %}
          </tr>
        </thead>
        <tbody>
          {% for row in rows %}
            {% if row.kind == 'missing' %}
              <tr class="schedule-missing">
                <th class="schedule-when">
                  {% if row.dayLabel %}<span class="schedule-day">{{ row.dayLabel }}</span>{% endif %}
                  <span class="schedule-time">{{ row.time }}</span>
                </th>
                <td colspan="{{ max(users|length, 1) }}">
                  {{ 'schedule.missing.staff'|trans({
                    '%title%': row.missing.title,
                    '%from%': row.missing.from,
                    '%to%': row.missing.to,
                  }) }}{% if row.missing.task %} · {{ row.missing.task }}{% endif %}{% if row.missing.location %} · {{ row.missing.location }}{% endif %}
                </td>
              </tr>
            {% else %}
              <tr class="{{ row.isDayStart ? 'schedule-day-start' : '' }}">
                <th class="schedule-when">
                  {% if row.dayLabel %}<span class="schedule-day">{{ row.dayLabel }}</span>{% endif %}
                  <span class="schedule-time">{{ row.time }}</span>
                </th>
                {% for user in users %}
                  {% set cell = row.cells[user.id] ?? null %}
                  <td class="{{ cell ? (cell.start ? 'schedule-busy is-start' : 'schedule-busy') : '' }}">
                    {% if cell and cell.start %}
                      {# The shift's own times, not the row's: one running 10:15 to 12:45 is drawn
                         from the 10:00 slot and would otherwise read half an hour out. #}
                      <span class="schedule-hours">{{ cell.from }}–{{ cell.to }}</span>
                      <span class="schedule-title">{{ cell.title }}</span>
                      {% if cell.task %}<span class="schedule-task">{{ cell.task }}</span>{% endif %}
                      {% if cell.location %}<span class="schedule-location">{{ cell.location }}</span>{% endif %}
                    {% endif %}
                  </td>
                {% else %}
                  <td></td>
                {% endfor %}
              </tr>
            {% endif %}
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}
{% endblock %}
