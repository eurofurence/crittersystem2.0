{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ 'planner.page.title_department'|trans({'%name%': department.name}) }}{% endblock %}

{% block body %}
  {{ d.page_header('planner.page.title'|trans, {
    subtitle: 'planner.page.subtitle'|trans,
    actions: [{label: 'planner.action.shift_manager'|trans, href: path('app_manage_shifts'), class: 'btn btn-outline-secondary'}]
  }) }}

  {{ d.card_start(null, {bodyClass: 'card-body d-flex flex-wrap align-items-end gap-3'}) }}
      {# Switching departments is an explicit step: the grid, the publish bar and the discard
         button all act on whichever department is loaded, so a stray change on the select must
         not swap it underneath the manager. #}
      <form method="get" action="{{ path('app_manage_shifts_planner') }}" class="d-flex align-items-end gap-2">
        <div>
          <label class="form-label mb-1 required" for="planner-department">{{ 'common.label.department'|trans }}</label>
          <select id="planner-department" name="department" class="form-select" required>
            {% for dept in departments %}
              <option value="{{ dept.uuid }}" {{ dept.uuid == department.uuid ? 'selected' : '' }}>{{ dept.name }}</option>
            {% endfor %}
          </select>
          <div class="form-hint">{{ 'planner.field.department_hint'|trans }}</div>
        </div>
        <button type="submit" class="btn btn-outline-primary">{{ 'planner.choose.submit'|trans }}</button>
      </form>

      <div class="ms-auto text-secondary small">
        <span class="planner-legend-swatch planner-audience-public"></span> {{ 'common.state.public'|trans }}
        <span class="planner-legend-swatch planner-audience-staff ms-2"></span> {{ 'planner.legend.staff_only'|trans }}
        <span class="planner-legend-swatch planner-phase-setup ms-2"></span> {{ 'planner.legend.setup_teardown'|trans }}
      </div>
  {{ d.card_end({bodyClass: 'card-body d-flex flex-wrap align-items-end gap-3'}) }}

  <div class="row g-3">
    <div class="col-12 col-lg-8 col-xl-9">
      {% include 'planner/_toolbar.html.twig' %}

      {# The paint defaults are seeded from the server rather than waited for on the toolbar's
         change event: until the manager touches a picker no event fires, so a first paint would
         otherwise use the controller's own defaults instead of what the toolbar is showing. #}
      <div
        class="planner"
        data-controller="planner"
        data-planner-department-value="{{ department.uuid }}"
        data-planner-audience-value="department_staff"
        data-planner-task-value="{{ shiftTasks is not empty ? shiftTasks|first.id : 0 }}"
        data-planner-timezone-value="{{ timezone }}"
        data-planner-raster-value="{{ grid.rasterMinutes }}"
        data-planner-paint-url-value="{{ path('app_manage_shifts_planner_paint') }}"
        data-planner-paint-token-value="{{ csrf_token('planner_paint') }}"
        data-planner-edit-token-value="{{ csrf_token('planner_edit') }}"
      >
        {% include 'planner/_grid.html.twig' %}
      </div>
    </div>

    <div class="col-12 col-lg-4 col-xl-3">
      {% include 'planner/_panel.html.twig' %}
    </div>
  </div>

  {% include 'planner/_modal_add.html.twig' %}
{% endblock %}
