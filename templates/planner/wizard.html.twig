{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ 'planner.wizard.title_department'|trans({'%name%': department.name}) }}{% endblock %}

{% block body %}
  {{ d.page_header('planner.wizard.title'|trans, {
    subtitle: 'planner.wizard.subtitle'|trans,
    actions: [{label: 'planner.action.planner'|trans, href: path('app_manage_shifts_planner', {department: department.uuid}), class: 'btn btn-outline-secondary'}]
  }) }}

  {{ d.card_start(null, {
    class: '',
    tag: 'form',
    attrs: {method: 'post', action: path('app_manage_shifts_wizard')}
  }) }}
      <input type="hidden" name="_token" value="{{ csrf_token('shift_wizard') }}">
      <input type="hidden" name="department" value="{{ department.uuid }}">

      <div class="mb-3">
        <label class="form-label">{{ 'planner.wizard.field.days'|trans }}</label>
        <div class="row g-2">
          {% for day in days %}
            <div class="col-6 col-md-3">
              <label class="form-check">
                <input type="checkbox" class="form-check-input" name="dates[]" value="{{ day.iso }}">
                <span class="form-check-label">
                  {{ day.label }}
                  {% if day.phase != 'main' %}<small class="text-secondary">({{ day.phase }})</small>{% endif %}
                </span>
              </label>
            </div>
          {% endfor %}
        </div>
        <div class="mt-2">
          <label class="form-label" for="wiz-custom">{{ 'planner.wizard.field.custom_dates'|trans }}</label>
          <input type="text" class="form-control" id="wiz-custom" name="custom_dates" placeholder="2026-06-02, 2026-06-03">
        </div>
      </div>

      <div class="row g-3">
        <div class="col-6 col-md-3">
          <label class="form-label" for="wiz-start">{{ 'planner.wizard.field.daily_start'|trans }}</label>
          <input type="time" class="form-control" id="wiz-start" name="start_time" value="10:00" required>
        </div>
        <div class="col-6 col-md-3">
          <label class="form-label" for="wiz-end">{{ 'planner.wizard.field.daily_end'|trans }}</label>
          <input type="time" class="form-control" id="wiz-end" name="end_time" value="18:00" required>
        </div>
        <div class="col-6 col-md-3">
          <label class="form-label" for="wiz-slot">{{ 'planner.wizard.field.slot_minutes'|trans }}</label>
          <input type="number" class="form-control" id="wiz-slot" name="slot_minutes" min="30" step="30" value="120" required>
        </div>
        <div class="col-6 col-md-3">
          <label class="form-label" for="wiz-audience">{{ 'planner.field.audience'|trans }}</label>
          <select class="form-select" id="wiz-audience" name="audience">
            {% for a in audiences %}
              <option value="{{ a.value }}" {{ a.value == 'department_staff' ? 'selected' : '' }}>{{ a.label }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="col-6 col-md-4">
          {% include 'planner/_task_picker.html.twig' with {id: 'wiz-task', tasks: shiftTasks, department: department} only %}
        </div>
        <div class="col-6 col-md-4">
          <label class="form-label" for="wiz-location">{{ 'common.label.location'|trans }}</label>
          <select class="form-select" id="wiz-location" name="location">
            <option value="0">{{ 'planner.option.none'|trans }}</option>
            {% for loc in locations %}
              <option value="{{ loc.uuid }}">{{ loc.name }}</option>
            {% endfor %}
          </select>
        </div>
      </div>

      <div class="mt-3">
        <label class="form-label">{{ 'planner.wizard.field.needed'|trans }}</label>
        <div class="row g-2">
          {% for vt in volunteerTypes %}
            <div class="col-6 col-md-3 d-flex align-items-center gap-2">
              <span class="text-truncate flex-grow-1">{{ vt.name }}</span>
              <input type="number" min="0" class="form-control form-control-sm" style="max-width: 5rem;"
                     name="needed[{{ vt.uuid }}]" placeholder="0">
            </div>
          {% else %}
            {{ d.empty_inline('planner.empty.no_volunteer_types'|trans, {tag: 'div', class: 'col-12 text-secondary small'}) }}
          {% endfor %}
        </div>
      </div>
    {% set wizardFooter %}
      <a href="{{ path('app_manage_shifts_planner', {department: department.uuid}) }}" class="btn btn-outline-secondary">{{ 'common.action.cancel'|trans }}</a>
      <button type="submit" class="btn btn-primary">{{ 'planner.wizard.action.generate'|trans }}</button>
    {% endset %}
  {{ d.card_end({tag: 'form', footer: wizardFooter, footerClass: 'card-footer d-flex justify-content-end gap-2'}) }}
{% endblock %}
