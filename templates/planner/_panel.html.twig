{# Selection-driven side panel: overview / single / batch. #}
{% import 'components/data/_macros.twig' as d %}
<div
  class="card planner-panel"
  data-controller="planner-panel"
  data-planner-panel-panel-url-value="{{ path('app_manage_shifts_planner_panel', {id: '__ID__'}) }}"
  data-action="planner:selection@window->planner-panel#update"
>
  <div class="card-body" data-planner-panel-target="overview">
    <h3 class="card-title">{{ 'planner.panel.overview.title'|trans }}</h3>
    <p class="text-secondary">
      {{ 'planner.panel.overview.help'|trans }}
    </p>
    {{ d.definition_list([
      {label: 'common.label.department'|trans,   value: department.name},
      {label: 'planner.panel.shifts_shown'|trans, value: grid.blocks|length}
    ], {class: 'mb-0 small', labelCol: 'col-6', valueCol: 'col-6', labelClass: '', valueClass: ''}) }}
  </div>

  {# The single-shift edit form is fetched into here by the planner-panel controller. #}
  <div data-planner-panel-target="single" hidden></div>

  {# Batch edit exposes only the fields that are compatible across the selection. #}
  <div class="card-body" data-planner-panel-target="batch" hidden>
    <h3 class="card-title">{{ 'planner.panel.batch.edit'|trans }} {{ d.badge(0, 'bg-blue-lt', {attrs: {'data-planner-panel-target': 'count'}}) }} {{ 'planner.panel.batch.shifts'|trans }}</h3>
    <form
      method="post"
      action="{{ path('app_manage_shifts_planner_batch') }}"
      data-controller="planner-form"
    >
      <input type="hidden" name="_token" value="{{ csrf_token('planner_edit') }}">
      <span data-planner-panel-target="ids"></span>

      <div class="mb-2">
        <label class="form-label" for="batch-duration">{{ 'planner.field.duration'|trans }}</label>
        <input type="number" min="30" step="30" class="form-control" id="batch-duration" name="duration_minutes" placeholder="{{ 'planner.field.duration_placeholder'|trans }}">
      </div>

      <div class="mb-2">
        <label class="form-label" for="batch-task">{{ 'planner.field.shift_task'|trans }}</label>
        <select class="form-select" id="batch-task" name="task">
          <option value="">{{ 'planner.panel.batch.task_unchanged'|trans }}</option>
          {% for task in shiftTasks %}
            <option value="{{ task.uuid }}">{{ task.displayName }}</option>
          {% endfor %}
        </select>
        <small class="text-secondary">{{ 'planner.panel.batch.task_help'|trans }}</small>
      </div>

      {# Shift group. Assigning here puts every selected shift into the group, so a volunteer taking
         one takes all of them. The + creates a group AND puts the selection in it straight away;
         the fields above still need Apply, which the help text says. #}
      <div class="mb-2"
           data-controller="shift-group-create"
           data-shift-group-create-url-value="{{ path('app_manage_shifts_planner_group_create') }}"
           data-shift-group-create-department-value="{{ department.uuid }}"
           data-shift-group-create-token-value="{{ csrf_token('planner_edit') }}"
           data-shift-group-create-blank-message-value="{{ 'planner.batch.group.blank'|trans }}"
           data-shift-group-create-failed-message-value="{{ 'planner.batch.group.failed'|trans }}">
        <label class="form-label" for="batch-shift-group">{{ 'planner.batch.group.label'|trans }}</label>
        <div class="d-flex align-items-center gap-1">
          <select class="form-select" id="batch-shift-group" name="shift_group"
                  data-shift-group-create-target="select">
            <option value="">{{ 'planner.batch.group.unchanged'|trans }}</option>
            <option value="none">{{ 'planner.batch.group.remove'|trans }}</option>
            {% for group in shiftGroups ?? [] %}
              <option value="{{ group.uuid }}">{{ group.name }}</option>
            {% endfor %}
          </select>
          <button type="button" class="btn btn-outline-secondary" data-action="shift-group-create#open"
                  title="{{ 'planner.batch.group.new_aria'|trans }}" aria-label="{{ 'planner.batch.group.new_aria'|trans }}">+</button>
        </div>
        <small class="text-secondary">{{ 'planner.batch.group.help'|trans }}</small>

        <div class="mt-2" data-shift-group-create-target="panel" hidden>
          <div class="input-group input-group-sm">
            <input type="text" class="form-control" data-shift-group-create-target="name"
                   data-action="keydown->shift-group-create#keydown"
                   placeholder="{{ 'planner.batch.group.new_placeholder'|trans }}"
                   aria-label="{{ 'planner.batch.group.new_aria'|trans }}">
            <button type="button" class="btn btn-primary" data-action="shift-group-create#create">{{ 'planner.batch.group.new_submit'|trans }}</button>
            <button type="button" class="btn btn-outline-secondary" data-action="shift-group-create#close">{{ 'common.action.cancel'|trans }}</button>
          </div>
          <div class="form-text">{{ 'planner.batch.group.new_help'|trans }}</div>
          <div class="invalid-feedback d-block" data-shift-group-create-target="error" hidden></div>
        </div>
      </div>

      <fieldset class="mb-2">
        <legend class="form-label">{{ 'planner.field.needed_single'|trans }}</legend>
        <div class="d-flex gap-2">
          <select class="form-select" name="needed_type">
            <option value="">{{ 'planner.option.none'|trans }}</option>
            {% for vt in volunteerTypes ?? [] %}
              <option value="{{ vt.uuid }}">{{ vt.name }}</option>
            {% endfor %}
          </select>
          <input type="number" min="0" class="form-control" name="needed_count" placeholder="{{ 'planner.field.qty_placeholder'|trans }}" style="max-width: 6rem;">
        </div>
        <small class="text-secondary">{{ 'planner.panel.batch.help'|trans }}</small>
      </fieldset>

      <button type="submit" class="btn btn-primary w-100" data-action="planner-form#submit">{{ 'planner.panel.batch.apply'|trans }}</button>
    </form>

    {# A separate form: nesting one inside the batch form is invalid markup, and deleting must not
       be reachable by pressing Enter in the fields above. #}
    <form
      method="post"
      action="{{ path('app_manage_shifts_planner_batch_delete') }}"
      class="mt-2"
      data-controller="planner-form"
      data-planner-form-confirm-value="{{ 'planner.confirm.delete_selected'|trans }}"
    >
      <input type="hidden" name="_token" value="{{ csrf_token('planner_edit') }}">
      <span data-planner-panel-target="ids"></span>
      <button type="submit" class="btn btn-outline-danger w-100" data-action="planner-form#submit">{{ 'planner.panel.batch.delete'|trans }}</button>
    </form>
  </div>
</div>
