{# Standard Planner time×day grid. Blocks are positioned by the percentage offsets
   computed in PlannerPresenter; the `planner` Stimulus controller handles
   paint/move/resize/delete. #}
<div class="planner-grid" data-planner-target="grid">
  <div class="planner-axis">
    <div class="planner-axis-head"></div>
    {% for hour in 0..23 %}
      <div class="planner-axis-hour">{{ '%02d:00'|format(hour) }}</div>
    {% endfor %}
  </div>

  {% for day in grid.days %}
    {% set dayIndex = loop.index0 %}
    {# A day hiding shifts is marked on the column border rather than with a box in the grid, which
       would compete for space with the shifts it is describing. #}
    <div class="planner-day planner-phase-{{ day.phase }}{{ day.hidden > 0 ? ' planner-day-has-hidden' : '' }}{{ day.expanded ? ' planner-day-expanded' : '' }}">
      <div class="planner-day-head">
        {% if day.phase != 'main' %}<span class="planner-phase-tag">{{ day.phase }}</span>{% endif %}
        <span class="planner-day-label">{{ day.label }}</span>
        {% if day.expanded %}
          <a class="planner-day-toggle"
             href="{{ path('app_manage_shifts_planner', app.request.query.all|merge({department: department.uuid, expand: null})) }}"
          >{{ 'planner.grid.collapse'|trans }}</a>
        {% elseif day.hidden > 0 %}
          <a class="planner-day-toggle planner-day-toggle-expand"
             href="{{ path('app_manage_shifts_planner', app.request.query.all|merge({department: department.uuid, expand: day.iso})) }}"
             title="{{ 'planner.grid.overflow_title'|trans({'%count%': day.hidden}) }}"
          >{{ 'planner.grid.overflow'|trans({'%count%': day.hidden}) }}</a>
        {% endif %}
      </div>
      <div
        class="planner-day-body"
        data-planner-target="dayBody"
        data-planner-day="{{ day.iso }}"
      >
        {% for block in grid.blocks|filter(b => b.dayIndex == dayIndex) %}
          {% set shift = block.shift %}
          {# left/width come from the lane assignment: shifts running at the same time share the
             column instead of covering each other. A lone shift is lane 0 of 1, so full width. #}
          <div
            class="planner-block {{ shift.audience.isPublic ? 'planner-audience-public' : 'planner-audience-staff' }} {{ shift.draft ? 'planner-block-draft' : 'planner-block-published' }}{{ block.lanes > 1 ? ' planner-block-shared' : '' }}"
            style="top: {{ block.top }}%; height: {{ block.height }}%; left: {{ block.left }}%; width: calc({{ block.width }}% - 4px);"
            data-lane="{{ block.lane }}"
            data-lanes="{{ block.lanes }}"
            data-shift-id="{{ shift.uuid }}"
            data-planner-target="block"
            data-start="{{ shift.startsAt|date('c') }}"
            data-end="{{ shift.endsAt|date('c') }}"
            data-move-url="{{ path('app_manage_shifts_planner_move', {id: shift.uuid}) }}"
            data-delete-url="{{ path('app_manage_shifts_planner_delete', {id: shift.uuid}) }}"
            tabindex="0"
            role="button"
            aria-label="{{ shift.title }} {{ shift.startsAt|app_time }}–{{ shift.endsAt|app_time }}{{ shift.draft ? ('planner.grid.draft_suffix'|trans) : '' }}"
          >
            <span class="planner-block-time">{{ shift.startsAt|app_time }}–{{ shift.endsAt|app_time }}</span>
            <span class="planner-block-title">{{ shift.shiftTask ? shift.shiftTask.name : shift.title }}</span>
            {% if shift.draft %}<span class="planner-block-badge">{{ 'planner.badge.draft'|trans }}</span>{% endif %}
            {% if block.overnight %}<span class="planner-block-overnight" title="{{ 'planner.grid.overnight_title'|trans }}">▾</span>{% endif %}
            <span class="planner-block-resize" data-planner-target="resizeHandle" aria-hidden="true"></span>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endfor %}
</div>
