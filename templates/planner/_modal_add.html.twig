{# Add Shift modal. Department is fixed to the current planner. #}
{% import 'components/data/_macros.twig' as d %}
<div class="modal fade" id="planner-add-modal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <form
        method="post"
        action="{{ path('app_manage_shifts_planner_create') }}"
        data-controller="planner-form"
        data-planner-form-close-modal-value="planner-add-modal"
      >
        <div class="modal-header">
          <h5 class="modal-title">Add shift — {{ department.name }}</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" name="_token" value="{{ csrf_token('planner_edit') }}">
          <input type="hidden" name="department" value="{{ department.uuid }}">

          <div class="row g-3">
            <div class="col-12">
              <label class="form-label" for="add-title">Title</label>
              <input type="text" class="form-control" id="add-title" name="title" placeholder="Defaults to the task name">
            </div>
            <div class="col-6">
              <label class="form-label" for="add-start">Starts at</label>
              <input type="datetime-local" class="form-control" id="add-start" name="start" required>
            </div>
            <div class="col-6">
              <label class="form-label" for="add-end">Ends at</label>
              <input type="datetime-local" class="form-control" id="add-end" name="end" required>
            </div>
            <div class="col-6">
              <label class="form-label" for="add-task">Shift Task</label>
              <select class="form-select" id="add-task" name="task">
                <option value="0">— None —</option>
                {% for task in shiftTasks %}
                  <option value="{{ task.id }}">{{ task.displayName }}</option>
                {% endfor %}
              </select>
            </div>
            <div class="col-6">
              <label class="form-label" for="add-audience">Audience</label>
              <select class="form-select" id="add-audience" name="audience">
                {% for a in audiences %}
                  <option value="{{ a.value }}" {{ a.value == 'department_staff' ? 'selected' : '' }}>{{ a.label }}</option>
                {% endfor %}
              </select>
            </div>
            <div class="col-6">
              <label class="form-label" for="add-location">Location</label>
              <select class="form-select" id="add-location" name="location">
                <option value="0">— None —</option>
                {% for loc in locations %}
                  <option value="{{ loc.id }}">{{ loc.name }}</option>
                {% endfor %}
              </select>
            </div>
            <div class="col-6 d-flex align-items-end">
              <label class="form-check">
                <input type="checkbox" class="form-check-input" name="require_checkin" value="1">
                <span class="form-check-label">Require check-in</span>
              </label>
            </div>

            <div class="col-12">
              <label class="form-label">Required volunteer types &amp; quantities</label>
              <div class="row g-2">
                {% for vt in volunteerTypes %}
                  <div class="col-6 col-md-4 d-flex align-items-center gap-2">
                    <span class="text-truncate flex-grow-1">{{ vt.name }}</span>
                    <input type="number" min="0" class="form-control form-control-sm" style="max-width: 5rem;"
                           name="needed[{{ vt.id }}]" placeholder="0">
                  </div>
                {% else %}
                  {{ d.empty_inline('No volunteer types configured.', {tag: 'div', class: 'col-12 text-secondary small'}) }}
                {% endfor %}
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary" data-action="planner-form#submit">Create draft</button>
        </div>
      </form>
    </div>
  </div>
</div>
