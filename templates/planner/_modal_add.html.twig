{# Add Shift modal. Department is fixed to the current planner. #}
{% import 'components/data/_macros.twig' as d %}
<div class="modal fade" id="planner-add-modal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <form
        method="post"
        action="{{ path('app_manage_shifts_planner_create') }}"
        data-controller="planner-form"
        data-planner-form-close-modal-value="planner-add-modal"
      >
        <div class="modal-header">
          <h5 class="modal-title">{{ 'planner.modal_add.title'|trans({'%name%': department.name}) }}</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'ui.aria.close'|trans }}"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" name="_token" value="{{ csrf_token('planner_edit') }}">
          <input type="hidden" name="department" value="{{ department.uuid }}">

          <div class="row g-3">
            <div class="col-12">
              <label class="form-label" for="add-title">{{ 'common.label.title'|trans }}</label>
              <input type="text" class="form-control" id="add-title" name="title" placeholder="{{ 'planner.modal_add.title_placeholder'|trans }}">
            </div>
            <div class="col-12">
              <label class="form-label" for="add-description">{{ 'common.label.description'|trans }}</label>
              <textarea class="form-control" id="add-description" name="description" rows="2"
                        maxlength="{{ constant('App\\Entity\\Shift::DESCRIPTION_MAX_LENGTH') }}"></textarea>
            </div>
            <div class="col-6">
              <label class="form-label" for="add-start">{{ 'planner.field.starts_at'|trans }}</label>
              <input type="datetime-local" class="form-control" id="add-start" name="start" required>
            </div>
            <div class="col-6">
              <label class="form-label" for="add-end">{{ 'planner.field.ends_at'|trans }}</label>
              <input type="datetime-local" class="form-control" id="add-end" name="end" required>
            </div>
            <div class="col-6">
              {% include 'planner/_task_picker.html.twig' with {id: 'add-task', tasks: shiftTasks, department: department} only %}
            </div>
            <div class="col-6">
              <label class="form-label" for="add-audience">{{ 'planner.field.audience'|trans }}</label>
              <select class="form-select" id="add-audience" name="audience">
                {% for a in audiences %}
                  <option value="{{ a.value }}" {{ a.value == 'department_staff' ? 'selected' : '' }}>{{ a.label }}</option>
                {% endfor %}
              </select>
            </div>
            <div class="col-6">
              <label class="form-label" for="add-location">{{ 'common.label.location'|trans }}</label>
              <select class="form-select" id="add-location" name="location">
                <option value="0">{{ 'planner.option.none'|trans }}</option>
                {% for loc in locations %}
                  <option value="{{ loc.id }}">{{ loc.name }}</option>
                {% endfor %}
              </select>
            </div>
            <div class="col-6 d-flex align-items-end">
              <label class="form-check">
                <input type="checkbox" class="form-check-input" name="require_checkin" value="1">
                <span class="form-check-label">{{ 'planner.field.require_checkin'|trans }}</span>
              </label>
            </div>

            <div class="col-12">
              <label class="form-label">{{ 'planner.modal_add.needed'|trans }}</label>
              <div class="row g-2">
                {% for vt in volunteerTypes %}
                  <div class="col-6 col-md-4 d-flex align-items-center gap-2">
                    <span class="text-truncate flex-grow-1">{{ vt.name }}</span>
                    <input type="number" min="0" class="form-control form-control-sm" style="max-width: 5rem;"
                           name="needed[{{ vt.id }}]" placeholder="0">
                  </div>
                {% else %}
                  {{ d.empty_inline('planner.empty.no_volunteer_types'|trans, {tag: 'div', class: 'col-12 text-secondary small'}) }}
                {% endfor %}
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ 'common.action.cancel'|trans }}</button>
          <button type="submit" class="btn btn-primary" data-action="planner-form#submit">{{ 'planner.modal_add.submit'|trans }}</button>
        </div>
      </form>
    </div>
  </div>
</div>
