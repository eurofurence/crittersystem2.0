{# Single-shift edit form, fetched into the side panel. Renders no layout. #}
{% import 'components/data/_macros.twig' as d %}
<div class="card-body">
  <h3 class="card-title d-flex align-items-center justify-content-between">
    {{ 'planner.panel.single.title'|trans }}
    <span>
      {% if shift.description is null %}{{ d.badge('shift.list.no_description'|trans, 'bg-yellow-lt', {class: 'me-1'}) }}{% endif %}
      {% if shift.draft %}{{ d.badge('planner.badge.draft'|trans, 'bg-yellow-lt') }}{% else %}{{ d.badge('planner.badge.published'|trans, 'bg-green-lt') }}{% endif %}
    </span>
  </h3>

  <form
    method="post"
    action="{{ path('app_manage_shifts_planner_edit', {id: shift.uuid}) }}"
    data-controller="planner-form"
    {% if not shift.draft and shift.entries|length > 0 %}
      data-planner-form-confirm-value="{{ 'planner.confirm.published_save'|trans({'%count%': shift.entries|length}) }}"
    {% endif %}
  >
    <input type="hidden" name="_token" value="{{ csrf_token('planner_edit') }}">

    <div class="mb-2">
      <label class="form-label" for="edit-title-{{ shift.uuid }}">{{ 'common.label.title'|trans }}</label>
      <input type="text" class="form-control" id="edit-title-{{ shift.uuid }}" name="title" value="{{ shift.title }}">
    </div>
    <div class="mb-2">
      <label class="form-label" for="edit-description-{{ shift.uuid }}">{{ 'common.label.description'|trans }}</label>
      <textarea class="form-control" id="edit-description-{{ shift.uuid }}" name="description" rows="3"
                maxlength="{{ constant('App\\Entity\\Shift::DESCRIPTION_MAX_LENGTH') }}">{{ shift.description }}</textarea>
    </div>
    {# The panel is a narrow sidebar column: side by side these two are too cramped to show a whole
       date AND time, which is exactly what the manager is checking here. #}
    <div class="mb-2">
      <label class="form-label" for="edit-start-{{ shift.uuid }}">{{ 'planner.field.starts'|trans }}</label>
      <input type="datetime-local" class="form-control" id="edit-start-{{ shift.uuid }}" name="start"
             value="{{ shift.startsAt|date('Y-m-d\\TH:i', timezone) }}">
    </div>
    <div class="mb-2">
      <label class="form-label" for="edit-end-{{ shift.uuid }}">{{ 'planner.field.ends'|trans }}</label>
      <input type="datetime-local" class="form-control" id="edit-end-{{ shift.uuid }}" name="end"
             value="{{ shift.endsAt|date('Y-m-d\\TH:i', timezone) }}">
    </div>
    <div class="mb-2">
      {% include 'planner/_task_picker.html.twig' with {
        id: 'edit-task-' ~ shift.uuid,
        tasks: shiftTasks,
        department: shift.department,
        selected: shift.shiftTask ? shift.shiftTask.uuid : null
      } only %}
    </div>
    <div class="mb-2">
      <label class="form-label" for="edit-audience-{{ shift.uuid }}">{{ 'planner.field.audience'|trans }}</label>
      <select class="form-select" id="edit-audience-{{ shift.uuid }}" name="audience">
        {% for a in audiences %}
          <option value="{{ a.value }}" {{ a.value == shift.audience.value ? 'selected' : '' }}>{{ a.label }}</option>
        {% endfor %}
      </select>
    </div>
    <div class="mb-2">
      <label class="form-label" for="edit-location-{{ shift.uuid }}">{{ 'common.label.location'|trans }}</label>
      <select class="form-select" id="edit-location-{{ shift.uuid }}" name="location">
        <option value="0">{{ 'planner.option.none'|trans }}</option>
        {% for loc in locations %}
          <option value="{{ loc.uuid }}" {{ shift.location and shift.location.uuid == loc.uuid ? 'selected' : '' }}>{{ loc.fullName }}</option>
        {% endfor %}
      </select>
    </div>
    <label class="form-check mb-3">
      <input type="checkbox" class="form-check-input" disabled name="require_checkin" value="1" {{ shift.requireCheckin ? 'checked' : '' }}>
      <span class="form-check-label" disabled>{{ 'planner.field.require_checkin'|trans }}</span>
    </label>

    <fieldset class="mb-3">
      <legend class="form-label">{{ 'planner.field.needed_multi'|trans }}</legend>
      {% set neededByType = {} %}
      {% for need in shift.neededVolunteerTypes %}
        {% set neededByType = neededByType|merge({(need.volunteerType.uuid ~ ''): need.count}) %}
      {% endfor %}
      <div class="row g-2">
        {% for vt in volunteerTypes %}
          <div class="col-12 d-flex align-items-center gap-2">
            <span class="text-truncate flex-grow-1">{{ vt.name }}</span>
            <input type="number" min="0" class="form-control form-control-sm" style="max-width: 5rem;"
                   name="needed[{{ vt.uuid }}]" value="{{ neededByType[vt.uuid ~ ''] ?? 0 }}">
          </div>
        {% else %}
          {{ d.empty_inline('planner.empty.no_volunteer_types'|trans, {tag: 'div', class: 'col-12 text-secondary small'}) }}
        {% endfor %}
      </div>
    </fieldset>

    <button type="submit" class="btn btn-primary w-100" data-action="planner-form#submit">{{ 'common.action.save'|trans }}</button>
  </form>

  {% if is_granted('assignment:manage', shift.department) %}
    <a href="{{ path('app_shift_staffing', {id: shift.uuid}) }}" class="btn btn-outline-primary w-100 mt-2" data-turbo="false">
      {{ 'planner.action.manage_staffing'|trans({'%count%': shift.entries|length}) }}
    </a>
  {% endif %}

  <form method="post" action="{{ path('app_manage_shifts_planner_delete', {id: shift.uuid}) }}"
        class="mt-2" data-controller="planner-form" data-planner-form-confirm-value="{{ 'planner.confirm.delete_shift'|trans }}">
    <input type="hidden" name="_token" value="{{ csrf_token('planner_edit') }}">
    <button type="submit" class="btn btn-outline-danger w-100" data-action="planner-form#submit">{{ 'planner.action.delete_shift'|trans }}</button>
  </form>
</div>
