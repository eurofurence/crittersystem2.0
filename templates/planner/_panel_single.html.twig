{# Single-shift edit form, fetched into the side panel. Renders no layout. #}
{% import 'components/data/_macros.twig' as d %}
<div class="card-body">
  <h3 class="card-title d-flex align-items-center justify-content-between">
    {{ 'planner.panel.single.title'|trans }}
    {% if shift.draft %}{{ d.badge('planner.badge.draft'|trans, 'bg-yellow-lt') }}{% else %}{{ d.badge('planner.badge.published'|trans, 'bg-green-lt') }}{% endif %}
  </h3>

  <form
    method="post"
    action="{{ path('app_manage_shifts_planner_edit', {id: shift.uuid}) }}"
    data-controller="planner-form"
    {% if not shift.draft and shift.entries|length > 0 %}
      data-planner-form-confirm-value="{{ 'planner.confirm.published_save'|trans({'%count%': shift.entries|length}) }}"
    {% endif %}
  >
    <input type="hidden" name="_token" value="{{ csrf_token('planner_edit') }}">

    <div class="mb-2">
      <label class="form-label" for="edit-title-{{ shift.id }}">{{ 'common.label.title'|trans }}</label>
      <input type="text" class="form-control" id="edit-title-{{ shift.id }}" name="title" value="{{ shift.title }}">
    </div>
    <div class="row g-2 mb-2">
      <div class="col-6">
        <label class="form-label" for="edit-start-{{ shift.id }}">{{ 'planner.field.starts'|trans }}</label>
        <input type="datetime-local" class="form-control" id="edit-start-{{ shift.id }}" name="start"
               value="{{ shift.startsAt|date('Y-m-d\\TH:i', timezone) }}">
      </div>
      <div class="col-6">
        <label class="form-label" for="edit-end-{{ shift.id }}">{{ 'planner.field.ends'|trans }}</label>
        <input type="datetime-local" class="form-control" id="edit-end-{{ shift.id }}" name="end"
               value="{{ shift.endsAt|date('Y-m-d\\TH:i', timezone) }}">
      </div>
    </div>
    <div class="mb-2">
      <label class="form-label" for="edit-task-{{ shift.id }}">{{ 'planner.field.shift_task'|trans }}</label>
      <select class="form-select" id="edit-task-{{ shift.id }}" name="task">
        <option value="0">{{ 'planner.option.none'|trans }}</option>
        {% for task in shiftTasks %}
          <option value="{{ task.id }}" {{ shift.shiftTask and shift.shiftTask.id == task.id ? 'selected' : '' }}>{{ task.displayName }}</option>
        {% endfor %}
      </select>
    </div>
    <div class="mb-2">
      <label class="form-label" for="edit-audience-{{ shift.id }}">{{ 'planner.field.audience'|trans }}</label>
      <select class="form-select" id="edit-audience-{{ shift.id }}" name="audience">
        {% for a in audiences %}
          <option value="{{ a.value }}" {{ a.value == shift.audience.value ? 'selected' : '' }}>{{ a.label }}</option>
        {% endfor %}
      </select>
    </div>
    <div class="mb-2">
      <label class="form-label" for="edit-location-{{ shift.id }}">{{ 'common.label.location'|trans }}</label>
      <select class="form-select" id="edit-location-{{ shift.id }}" name="location">
        <option value="0">{{ 'planner.option.none'|trans }}</option>
        {% for loc in locations %}
          <option value="{{ loc.id }}" {{ shift.location and shift.location.id == loc.id ? 'selected' : '' }}>{{ loc.name }}</option>
        {% endfor %}
      </select>
    </div>
    <label class="form-check mb-3">
      <input type="checkbox" class="form-check-input" name="require_checkin" value="1" {{ shift.requireCheckin ? 'checked' : '' }}>
      <span class="form-check-label">{{ 'planner.field.require_checkin'|trans }}</span>
    </label>

    <fieldset class="mb-3">
      <legend class="form-label">{{ 'planner.field.needed_multi'|trans }}</legend>
      {# Keys are prefixed because Twig's merge filter renumbers integer keys (array_merge
         semantics), which would drop the volunteer-type id and lose the saved count. #}
      {% set neededByType = {} %}
      {% for need in shift.neededVolunteerTypes %}
        {% set neededByType = neededByType|merge({('vt' ~ need.volunteerType.id): need.count}) %}
      {% endfor %}
      <div class="row g-2">
        {% for vt in volunteerTypes %}
          <div class="col-12 d-flex align-items-center gap-2">
            <span class="text-truncate flex-grow-1">{{ vt.name }}</span>
            <input type="number" min="0" class="form-control form-control-sm" style="max-width: 5rem;"
                   name="needed[{{ vt.id }}]" value="{{ neededByType['vt' ~ vt.id] ?? 0 }}">
          </div>
        {% else %}
          {{ d.empty_inline('planner.empty.no_volunteer_types'|trans, {tag: 'div', class: 'col-12 text-secondary small'}) }}
        {% endfor %}
      </div>
    </fieldset>

    <button type="submit" class="btn btn-primary w-100" data-action="planner-form#submit">{{ 'common.action.save'|trans }}</button>
  </form>

  {% if is_granted('assignment:manage', shift.department) %}
    <a href="{{ path('app_shift_staffing', {id: shift.uuid}) }}" class="btn btn-outline-primary w-100 mt-2" data-turbo="false">
      {{ 'planner.action.manage_staffing'|trans({'%count%': shift.entries|length}) }}
    </a>
  {% endif %}

  <form method="post" action="{{ path('app_manage_shifts_planner_delete', {id: shift.uuid}) }}"
        class="mt-2" data-controller="planner-form" data-planner-form-confirm-value="{{ 'planner.confirm.delete_shift'|trans }}">
    <input type="hidden" name="_token" value="{{ csrf_token('planner_edit') }}">
    <button type="submit" class="btn btn-outline-danger w-100" data-action="planner-form#submit">{{ 'planner.action.delete_shift'|trans }}</button>
  </form>
</div>
