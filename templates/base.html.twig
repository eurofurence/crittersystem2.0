<!DOCTYPE html>
<html lang="en" data-bs-theme="{{ active_theme.type }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
        <title>{% block title %}VMS{% endblock %}</title>

        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {# Theme stylesheet — loaded LAST so its `--tblr-*` / `--bs-*` overrides win the cascade. #}
        <link rel="stylesheet" href="{{ asset(active_theme.assetPath) }}">
    </head>

    <body>
        {% import 'components/navigation/_macros.twig' as nav %}
        {% import 'components/notification/_macros.twig' as n %}
        {% import 'components/icon/_macros.twig' as i %}

        {% block navbar %}
        <div class="page">
            <header class="navbar navbar-expand-md d-print-none layout-fluid">
                <div class="container-xl">
                    <button class="navbar-toggler" type="button"
                            data-bs-toggle="collapse" data-bs-target="#navbar-menu"
                            aria-controls="navbar-menu" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <a href="{{ path('app_home') }}"
                       class="navbar-brand navbar-brand-autodark d-none-navbar-horizontal pe-0 pe-md-3 fw-bold fs-3">
                        VMS
                    </a>

                    <div class="navbar-nav flex-row order-md-last">
                        {% if app.user %}
                            {% include 'operational_status/_widget.html.twig' with {vm: operational_status()} only %}

                            {% include 'notifications/_bell.html.twig' with {vm: notification_bell()} only %}

                            <div class="nav-item dropdown">
                                <a href="#" class="nav-link d-flex lh-1 p-0 px-2" data-bs-toggle="dropdown"
                                   aria-label="Open user menu" aria-expanded="false">
                                    <span class="avatar avatar-sm">{{ app.user.userIdentifier|slice(0, 2)|upper }}</span>
                                    <div class="d-none d-xl-block ps-2">
                                        <div>{{ app.user.userIdentifier }}</div>
                                        <div class="mt-1 small text-secondary">Signed in</div>
                                    </div>
                                </a>
                                <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                                    <a href="{{ path('app_settings') }}" class="dropdown-item">
                                        {{ i.icon('settings', {class: 'icon-1 me-2 text-muted'}) }}Settings
                                    </a>
                                    <a href="{{ path('app_digital_id') }}" class="dropdown-item">
                                        {{ i.icon('id', {class: 'icon-1 me-2 text-muted'}) }}Digital ID
                                    </a>
                                    <a href="{{ path('app_2fa') }}" class="dropdown-item">
                                        {{ i.icon('lock', {class: 'icon-1 me-2 text-muted'}) }}Two-factor auth
                                    </a>
                                    <a href="{{ path('app_profile_telegram') }}" class="dropdown-item">
                                        {{ i.icon('send', {class: 'icon-1 me-2 text-muted'}) }}Telegram
                                    </a>
                                    <a href="{{ path('app_profile_privacy') }}" class="dropdown-item">
                                        {{ i.icon('shield', {class: 'icon-1 me-2 text-muted'}) }}Privacy &amp; my data
                                    </a>
                                    <div class="dropdown-divider"></div>
                                    <a href="{{ path('app_logout') }}" class="dropdown-item">
                                        {{ i.icon('logout', {class: 'icon-1 me-2 text-muted'}) }}Logout
                                    </a>
                                </div>
                            </div>
                        {% else %}
                            <div class="nav-item">
                                <a href="{{ path('app_login') }}" class="btn btn-primary">
                                    {{ i.icon('login', {class: 'icon-2'}) }}Login
                                </a>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </header>

            {% if app.user %}
            <header class="navbar-expand-md d-print-none layout-fluid">
                <div class="collapse navbar-collapse" id="navbar-menu">
                    <div class="navbar">
                        <div class="container-xl">
                            {# Permission-gated items are hidden when not granted; the backend
                               still enforces access on every route. #}
                            <ul class="navbar-nav">
                                {% if is_granted('news:view') %}{{ nav.nav_item('News', 'app_news_index', {icon: 'news', exact: false}) }}{% endif %}
                                {% if is_granted('shift:self') %}{{ nav.nav_item('My Shifts', 'app_my_shifts', {icon: 'checklist'}) }}{% endif %}
                                {% if is_granted('shift:view') %}{{ nav.nav_item('Shifts', 'app_shift_index', {icon: 'clock', exact: false}) }}{% endif %}
                                {% if is_granted('manageshifts:view') %}{{ nav.nav_item('Shift Manager', 'app_manage_shifts', {icon: 'calendar', exact: false}) }}{% endif %}
                                {% if is_granted('volunteertype:view') %}{{ nav.nav_item('Volunteer Types', 'app_membership_index', {icon: 'puzzle'}) }}{% endif %}
                                {% if is_granted('location:view') %}{{ nav.nav_item('Locations', 'app_locations', {icon: 'map-pin', exact: false}) }}{% endif %}
                                {% if is_granted('call:respond') %}{{ nav.nav_item('Bounty Board', 'app_bounty_board', {icon: 'award', exact: false}) }}{% endif %}
                                {% if is_granted('message:use') %}
                                    {% if is_granted('ROLE_STAFF') %}
                                        {{ nav.nav_item('Messages', 'app_messages_index', {icon: 'mail', exact: false}) }}
                                    {% else %}
                                        {{ nav.nav_item('Ask Info Desk', 'app_messages_infodesk', {icon: 'mail', exact: false}) }}
                                    {% endif %}
                                {% endif %}
                                {% if is_granted('certification:view') %}{{ nav.nav_item('Certifications', 'app_certifications_index', {icon: 'award'}) }}{% endif %}
                                {% if is_granted('ROLE_STAFF') %}{{ nav.nav_item('Departments', 'app_departments', {icon: 'building', exact: false}) }}{% endif %}
                                {% if is_granted('backstage:view') %}{{ nav.nav_item('Backstage', 'app_backstage', {icon: 'gift', exact: false}) }}{% endif %}
                                {% if is_granted('faq:view') %}{{ nav.nav_item('FAQ', 'app_faq_index', {icon: 'help'}) }}{% endif %}
                                {% if is_granted('ROLE_ADMIN') %}{{ nav.nav_item('Dashboard', 'app_dashboard', {icon: 'dashboard'}) }}{% endif %}

                                {# Development submenu. The kit routes only exist outside prod
                                   (see config/services.yaml), so path() would throw there. #}
                                {% if is_granted('ROLE_ADMIN') and app.environment != 'prod' %}
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown"
                                       role="button" aria-expanded="false">
                                        <span class="nav-link-icon d-md-none d-lg-inline-block">{{ i.icon('code') }}</span>
                                        <span class="nav-link-title">Development</span>
                                    </a>
                                    <div class="dropdown-menu">
                                        <a class="dropdown-item" href="{{ path('app_navigation_kit') }}">Navigation Kit</a>
                                        <a class="dropdown-item" href="{{ path('app_theme_kit') }}">Theme Kit</a>
                                    </div>
                                </li>
                                {% endif %}

                                {% if is_granted('location:manage') or is_granted('volunteertype:manage') or is_granted('shift:manage') or is_granted('global:admin') or is_granted('config:event') or is_granted('audit:view') %}
                                    {{ nav.nav_item('Manage', 'app_manage', {icon: 'tools', exact: false}) }}
                                {% endif %}
                            </ul>
                        </div>
                    </div>
                </div>
            </header>
            {% endif %}

            <div class="page-wrapper">
                <div class="page-body">
                    <div class="container-xl">
                        {{ n.flash_messages(app) }}

                        {% block body %}{% endblock %}

                    </div>
                </div>
            </div>
        </div>
        {% endblock %}
    </body>
</html>
