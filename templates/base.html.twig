<!DOCTYPE html>
<html lang="en" data-bs-theme="{{ active_theme.type }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}VMS{% endblock %}</title>

        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {# Theme stylesheet — loaded LAST so its `--bs-*` overrides win the cascade. #}
        <link rel="stylesheet" href="{{ asset(active_theme.assetPath) }}">
    </head>
    <body>
        {# COMPONENTS #}
        {% import 'components/navigation/_macros.twig' as nav %}
        {% import 'components/notification/_macros.twig' as n %}

        {# NAVBAR #}
        {% block navbar %}

            {% set left %}
            {{ nav.nav_item('Home', 'app_home', {icon:'🏠'}) }}
            {{ nav.nav_item('Dashboard', 'app_dashboard', {icon:'📊'}) }}
            {% if app.user %}
            {% if is_granted('news') %}{{ nav.nav_item('News', 'app_news_index', {icon:'📰', exact: false}) }}{% endif %}
            {{ nav.nav_item('Shifts', 'app_shift_index', {icon:'🕒', exact: false}) }}
            {{ nav.nav_item('My Shifts', 'app_my_shifts', {icon:'📋'}) }}
            {{ nav.nav_item('Volunteer Types', 'app_membership_index', {icon:'🧩'}) }}
            {% if is_granted('user_messages') %}{{ nav.nav_item('Messages', 'app_messages_index', {icon:'✉️', exact: false}) }}{% endif %}
            {% if is_granted('faq.view') %}{{ nav.nav_item('FAQ', 'app_faq_index', {icon:'❓'}) }}{% endif %}
            {{ nav.nav_item('Certifications', 'app_certifications_index', {icon:'🎖️'}) }}
            {% if is_granted('user.type.staff') %}{{ nav.nav_item('Staff', 'app_staff_overview', {icon:'🦺', exact: false}) }}{% endif %}
            {% if is_granted('backstage.view') %}
            {{ nav.nav_item('Backstage', 'app_backstage', {icon:'🎁', exact: false}) }}
            {% endif %}
            {% endif %}
            {% if app.user and (is_granted('admin_rooms') or is_granted('admin_volunteer_types') or is_granted('admin_shifts') or is_granted('admin') or is_granted('admin_event_config')) %}
            {{ nav.nav_item('Manage', 'app_manage', {icon:'🛠️', exact: false}) }}
            {% endif %}
            {{ nav.nav_item('Navigation Kit', 'app_navigation_kit', {icon:'🧭'}) }}
            {{ nav.nav_item('Theme Kit', 'app_theme_kit', {icon:'🎨'}) }}
            {% endset %}

            {% set right %}
            {% if app.user %}
                <span class="navbar-text me-2">👤 {{ app.user.userIdentifier }}</span>
                <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_logout') }}">Logout</a>
            {% else %}
                <a class="btn btn-primary btn-sm" href="{{ path('app_login') }}">Login</a>
            {% endif %}
            {% endset %}

            {{ nav.navbar('VMS', { left: left, right: right }) }}
        {% endblock %}

        {# FLASH MESSAGES #}
        <div class="container mt-3">
            {{ n.flash_messages(app) }}
        </div>

        {# This section to be removed - commented due to the main layout and side bar
            {% block body %}{% endblock %}
        #}

        {# MAIN LAYOUT #}
        <div class="container py-3">
            <div class="row g-3">
            <aside class="col-12 col-lg-3">
                {% block sidebar %}{% endblock %}
            </aside>

            <main class="col-12 col-lg-9">
                {% block body %}{% endblock %}
            </main>
            </div>
        </div>

    </body>
</html>
