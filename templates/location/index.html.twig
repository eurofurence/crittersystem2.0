{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ 'location.index.page.title'|trans }}{% endblock %}

{% macro branch(nodes) %}
  {% import _self as tree %}
  {# macros get their own scope: the template-level import of the data macros is not visible here #}
  {% import 'components/data/_macros.twig' as d %}
  <ul class="list-unstyled ms-3">
    {% for node in nodes %}
      <li class="mb-1">
        <a href="{{ path('app_location_show', {id: node.location.uuid}) }}">{{ node.location.name }}</a>
        {% if node.location.staffOnly %}{{ d.badge('common.state.staff_only'|trans, 'bg-secondary-lt', {class: 'ms-1'}) }}{% endif %}
        {% if node.children is not empty %}{{ tree.branch(node.children) }}{% endif %}
      </li>
    {% endfor %}
  </ul>
{% endmacro %}

{% block body %}
  {{ d.page_header('location.index.page.title'|trans, {subtitle: 'location.index.page.subtitle'|trans}) }}

  {% if tree is empty %}
    {{ d.empty_state('location.index.empty.title'|trans, {message: 'location.index.empty.message'|trans}) }}
  {% else %}
    {{ d.card_start(null, {class: ''}) }}
      {{ _self.branch(tree) }}
    {{ d.card_end() }}
  {% endif %}
{% endblock %}
