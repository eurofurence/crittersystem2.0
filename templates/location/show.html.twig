{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ location.fullName }}{% endblock %}

{% block body %}
  {{ d.page_header(location.fullName, {
    actions: [{label: 'location.show.action.back'|trans, href: path('app_locations'), class: 'btn btn-outline-secondary'}]
  }) }}

  {{ d.card_start(null, {class: ''}) }}
      {% if location.description %}<p>{{ location.description }}</p>{% endif %}

      {% if location.phone %}
        <p class="mb-2"><strong>{{ 'location.show.phone'|trans }}:</strong>
          <a href="tel:{{ location.phone|replace({' ': ''}) }}">{{ location.phone }}</a></p>
      {% endif %}

      {% if location.departments is not empty %}
        <h3 class="h6">{{ 'location.show.departments'|trans }}</h3>
        {% for dept in location.departments %}{{ d.badge(dept.name, 'bg-secondary-lt', {class: 'me-1'}) }}{% endfor %}
      {% endif %}

      {% if embedSrc %}
        <div class="mt-3 ratio ratio-16x9" style="max-width: 640px;">
          <iframe src="{{ embedSrc }}" title="{{ 'location.show.map_title'|trans({'%name%': location.name}) }}" loading="lazy"
                  referrerpolicy="no-referrer" sandbox="allow-scripts allow-same-origin allow-popups"></iframe>
        </div>
      {% elseif location.mapUrl %}
        <p class="mt-3"><a href="{{ location.mapUrl }}" target="_blank" rel="noopener">{{ 'location.show.open_map'|trans }}</a></p>
      {% endif %}
  {{ d.card_end() }}
{% endblock %}
