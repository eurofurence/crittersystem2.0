{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}My Shifts{% endblock %}

{% block body %}
  {{ d.page_header('My Shifts', {
    subtitle: 'Your sign-ups and credited hours.',
    actions: [{label: 'Browse shifts', href: path('app_shift_index'), class: 'btn btn-outline-primary'}]
  }) }}

  <div class="card mb-3">
    <div class="card-body d-flex justify-content-between align-items-center">
      <span class="fw-semibold">Total credited hours</span>
      <span class="fs-4">{{ totalHours|round(2) }}</span>
    </div>
  </div>

  {% if entries is empty %}
    {{ d.empty_state('No shifts yet', {
      message: 'Sign up for a shift to see it here.',
      actionLabel: 'Browse shifts',
      actionHref: path('app_shift_index')
    }) }}
  {% else %}
    {{ d.table_start() }}
      <thead>
        <tr><th>Shift</th><th>When</th><th>Role</th><th>Hours</th><th class="text-end">Action</th></tr>
      </thead>
      <tbody>
        {% for entry in entries %}
          {% set shift = entry.shift %}
          <tr class="{{ entry.noshow ? 'table-danger' : (shift.past ? 'opacity-75' : '') }}">
            <td><a href="{{ path('app_shift_show', {id: shift.id}) }}">{{ shift.title }}</a></td>
            <td class="small">{{ shift.startsAt|date('D, d M H:i') }} – {{ shift.endsAt|date('H:i') }}</td>
            <td>{{ entry.volunteerType.name }}{% if entry.noshow %} {{ d.badge('No-show', 'text-bg-danger') }}{% endif %}</td>
            <td>{{ perEntryHours[entry.id]|round(2) }}</td>
            <td class="text-end">
              {% if not shift.past %}
                <form method="post" action="{{ path('app_shift_cancel', {id: entry.id}) }}" class="d-inline"
                      onsubmit="return confirm('Cancel this sign-up?');">
                  <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ entry.id) }}">
                  <button class="btn btn-sm btn-outline-danger">Cancel</button>
                </form>
              {% else %}<span class="text-muted small">—</span>{% endif %}
            </td>
          </tr>
        {% endfor %}
      </tbody>
    {{ d.table_end() }}
  {% endif %}
{% endblock %}
