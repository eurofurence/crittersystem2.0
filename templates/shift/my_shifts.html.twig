{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{# Each feed button is offered only to a viewer whose privilege the endpoint actually accepts,
   so nobody is handed a link that answers 403. #}

{% block title %}{{ 'shift.my.page.title'|trans }}{% endblock %}

{% block body %}
  {% set feedActions = [] %}
  {% if is_granted('export:atom') %}
    {% set feedActions = feedActions|merge([
      {label: 'shift.action.feed_atom'|trans, href: url('app_feed_atom', {key: app.user.apiKey}), class: 'btn btn-outline-secondary'}
    ]) %}
  {% endif %}
  {% if is_granted('export:ical') %}
    {% set feedActions = feedActions|merge([
      {label: 'shift.action.feed_ical'|trans, href: url('app_feed_ical', {key: app.user.apiKey}), class: 'btn btn-outline-secondary'}
    ]) %}
  {% endif %}
  {% if is_granted('export:atom') %}
    {% set feedActions = feedActions|merge([
      {label: 'shift.action.feed_rss'|trans, href: url('app_feed_rss', {key: app.user.apiKey}), class: 'btn btn-outline-secondary'}
    ]) %}
  {% endif %}

  {{ d.page_header('shift.my.page.title'|trans, {
    subtitle: 'shift.my.page.subtitle'|trans,
    actions: feedActions|merge([
      {label: 'shift.action.browse_shifts'|trans, href: path('app_shift_index'), class: 'btn btn-outline-primary'}
    ])
  }) }}

  {{ d.card_start(null, {bodyClass: 'card-body d-flex justify-content-between align-items-center'}) }}
      <span class="fw-semibold">{{ 'shift.my.total_hours'|trans }}</span>
      <span class="fs-4">{{ totalHours|round(2) }}</span>
  {{ d.card_end({bodyClass: 'card-body d-flex justify-content-between align-items-center'}) }}

  {% if entries is empty %}
    {{ d.empty_state('shift.my.empty.title'|trans, {
      message: 'shift.my.empty.message'|trans,
      actionLabel: 'shift.action.browse_shifts'|trans,
      actionHref: path('app_shift_index')
    }) }}
  {% else %}
    {{ d.table_start() }}
      <thead>
        <tr><th>{{ 'shift.table.shift'|trans }}</th><th>{{ 'common.label.when'|trans }}</th><th>{{ 'common.label.role'|trans }}</th><th>{{ 'shift.table.hours'|trans }}</th><th class="text-end">{{ 'shift.table.action'|trans }}</th></tr>
      </thead>
      <tbody>
        {% for entry in entries %}
          {% set shift = entry.shift %}
          <tr class="{{ entry.noshow ? 'table-danger' : (shift.past ? 'opacity-75' : '') }}">
            <td>
              <a href="{{ path('app_shift_show', {id: shift.uuid}) }}">{{ shift.title }}</a>
              {% if shift.grouped %}
                {# The commitment is the group, not this row: cancelling any of them cancels all. #}
                <div class="mt-1">{{ d.badge('shift.group.badge'|trans({'%name%': shift.shiftGroup.name, '%count%': shift.shiftGroup.shifts|length}), 'text-bg-info') }}</div>
              {% endif %}
            </td>
            <td class="small">{{ shift.startsAt|app_datetime }} - {{ shift.endsAt|app_time }}</td>
            <td>{{ entry.volunteerType.name }}{% if entry.noshow %} {{ d.badge('common.state.no_show'|trans, 'text-bg-danger') }}{% endif %}</td>
            <td>{{ perEntryHours[entry.id]|round(2) }}</td>
            <td class="text-end">
              {% if not shift.past %}
                <form method="post" action="{{ path('app_shift_cancel', {id: entry.uuid}) }}" class="d-inline"
                      {{ include('shift/_group_attrs.html.twig', {
                        shift: shift,
                        count: shift.grouped ? shift.shiftGroup.shifts|length : 1,
                        mode: 'cancel'
                      }) }}>
                  <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ entry.id) }}">
                  <button class="btn btn-sm btn-outline-danger">{{ 'common.action.cancel'|trans }}</button>
                </form>
              {% else %}<span class="text-muted small">-</span>{% endif %}
            </td>
          </tr>
        {% endfor %}
      </tbody>
    {{ d.table_end() }}
  {% endif %}
{% endblock %}
