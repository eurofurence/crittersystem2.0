{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ shift.title }}{% endblock %}

{% block body %}
  {{ d.page_header(shift.title, {
    subtitle: 'shift.show.subtitle'|trans({'%start%': shift.startsAt|app_datetime, '%end%': shift.endsAt|app_time, '%hours%': shift.durationHours}),
    actions: [{label: 'shift.action.all_shifts'|trans, href: path('app_shift_index'), class: 'btn btn-outline-secondary'}]
  }) }}

  <div class="row g-3">
    <div class="col-12 col-lg-7">
      {{ d.card_start() }}
          {# Not definition_list(): the optional "Link" value is an <a>, not a scalar. #}
          <dl class="row mb-0">
            <dt class="col-4">{{ 'common.label.type'|trans }}</dt><dd class="col-8">{{ shift.shiftTask ? shift.shiftTask.name : '-' }}</dd>
            <dt class="col-4">{{ 'common.label.location'|trans }}</dt><dd class="col-8">{{ shift.location ? shift.location.name : '-' }}</dd>
            {% if shift.url %}<dt class="col-4">{{ 'shift.show.link'|trans }}</dt><dd class="col-8"><a href="{{ shift.url }}">{{ shift.url }}</a></dd>{% endif %}
          </dl>
          {% if shift.description %}<hr><p class="mb-0">{{ shift.description|nl2br }}</p>{% endif %}
      {{ d.card_end() }}

      <h2 class="h5">{{ 'shift.show.staffing'|trans }}</h2>
      {% if availability is empty %}
        {{ d.empty_inline('shift.show.no_roles'|trans, {class: 'text-muted'}) }}
      {% else %}
        {{ d.table_start({hover: false}) }}
          <thead><tr><th>{{ 'common.label.role'|trans }}</th><th>{{ 'shift.show.filled'|trans }}</th><th>{{ 'common.label.status'|trans }}</th></tr></thead>
          <tbody>
            {% for row in availability %}
              <tr>
                <td>{{ row.type.name }}</td>
                <td>{{ row.assigned }} / {{ row.needed }}</td>
                <td>{% if row.assigned >= row.needed %}{{ d.badge('common.state.full'|trans, 'text-bg-success') }}{% else %}{{ d.badge('shift.show.open_count'|trans({'%count%': row.needed - row.assigned}), 'text-bg-warning') }}{% endif %}</td>
              </tr>
            {% endfor %}
          </tbody>
        {{ d.table_end() }}
      {% endif %}
    </div>

    <div class="col-12 col-lg-5">
      {{ d.card_start('shift.show.your_signup'|trans, {class: '', headerClass: 'card-header fw-semibold', titleTag: 'span', titleClass: ''}) }}
          {% if myEntry %}
            <p>{{ 'shift.show.signed_up_as'|trans({'%type%': '<strong>' ~ (myEntry.volunteerType.name|e) ~ '</strong>'})|raw }}</p>
            <form method="post" action="{{ path('app_shift_cancel', {id: myEntry.uuid}) }}"
                  data-controller="confirm" data-confirm-message-value="{{ 'shift.confirm.cancel_signup'|trans }}">
              <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ myEntry.id) }}">
              <button class="btn btn-outline-danger">{{ 'shift.action.cancel_signup'|trans }}</button>
            </form>
          {% elseif shift.past %}
            <p class="text-muted mb-0">{{ 'shift.show.ended'|trans }}</p>
          {% elseif signupOptions is empty %}
            <p class="text-muted mb-0">
              {{ 'shift.show.cannot_signup'|trans({'%link%': '<a href="' ~ path('app_membership_index') ~ '">' ~ 'ui.nav.volunteer_types'|trans ~ '</a>'})|raw }}
            </p>
          {% else %}
            <form method="post" action="{{ path('app_shift_signup', {id: shift.uuid}) }}">
              <input type="hidden" name="_token" value="{{ csrf_token('signup' ~ shift.id) }}">
              <div class="mb-3">
                <label class="form-label" for="volunteer_type">{{ 'shift.show.signup_as_label'|trans }}</label>
                <select id="volunteer_type" name="volunteer_type" class="form-select" required>
                  {% for id, type in signupOptions %}<option value="{{ id }}">{{ type.name }}</option>{% endfor %}
                </select>
              </div>
              <div class="mb-3">
                <label class="form-label" for="comment">{{ 'shift.show.comment_label'|trans }}</label>
                <textarea id="comment" name="comment" class="form-control" rows="2"></textarea>
              </div>
              <button class="btn btn-primary w-100">{{ 'shift.action.signup'|trans }}</button>
            </form>
          {% endif %}
      {{ d.card_end() }}
    </div>
  </div>
{% endblock %}
