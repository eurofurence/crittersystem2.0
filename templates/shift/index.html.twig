{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ 'shift.page.title'|trans }}{% endblock %}

{# This page's own shift-status vocabulary, passed into d.status_badge() via its
   `map`/`label` options. #}
{% set shiftStatusStyles = {
  'signed_up': 'text-bg-success',
  'available': 'text-bg-primary',
  'full': 'text-bg-secondary',
  'overlap': 'text-bg-warning',
  'ineligible': 'text-bg-light',
  'past': 'text-bg-light'
} %}
{% set shiftStatusLabels = {
  'signed_up': 'shift.status.signed_up'|trans,
  'available': 'shift.status.available'|trans,
  'full': 'common.state.full'|trans,
  'overlap': 'shift.status.overlap'|trans,
  'ineligible': 'shift.status.ineligible'|trans,
  'past': 'shift.status.past'|trans
} %}

{% block body %}
  {{ d.page_header('shift.page.title'|trans, {
    subtitle: 'shift.page.subtitle'|trans,
    actions: [{label: 'shift.action.my_shifts'|trans, href: path('app_my_shifts'), class: 'btn btn-primary'}]
  }) }}


    <div class="card mb-4">
        <div class="mt-2 mx-2">
            {# Date links preserve the other active filters. #}
            <nav class="nav nav-segmented nav-2 w-100" role="tablist" aria-label="{{ 'shift.filter.date_aria'|trans }}">
                {% for day in days %}
                    {% set isSel = day == selectedDate|date('Y-m-d') %}
                    <a class="btn nav-link{{ isSel ? ' bg-primary text-primary-fg' : '' }}{{ isSel ? ' active' : '' }}"
                       role="tab"
                       aria-selected="{{ isSel ? 'true' : 'false' }}"
                       href="{{ path('app_shift_index', {date: day, location: filters.location, type: filters.type, available: filters.available ? 1 : null, mine: filters.mine ? 1 : null}) }}">
                        {{ day|date('D d M') }}
                    </a>
                {% endfor %}
                {% if days is empty %}{{ d.empty_inline('shift.empty.no_upcoming'|trans, {tag: 'span', class: 'text-muted small'}) }}{% endif %}
            </nav>
        </div>



        {# The filter controls auto-submit; the form carries the selected date. #}
        {{ d.card_start(null, {tag: 'form', class: 'mx-2 my-2', attrs: {method: 'get', action: path('app_shift_index')}}) }}
        <input type="hidden" name="date" value="{{ selectedDate|date('Y-m-d') }}">
        <div class="row g-2 align-items-end">
            <div class="col-6 col-md-3">
                <label class="form-label small mb-0" for="f-loc">{{ 'common.label.location'|trans }}</label>
                <select id="f-loc" name="location" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">{{ 'shift.filter.all'|trans }}</option>
                    {% for l in locations %}<option value="{{ l.uuid }}" {{ filters.location == l.uuid ? 'selected' }}>{{ l.name }}</option>{% endfor %}
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small mb-0" for="f-type">{{ 'shift.filter.type_label'|trans }}</label>
                <select id="f-type" name="type" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">{{ 'shift.filter.all'|trans }}</option>
                    {% for t in shiftTasks %}<option value="{{ t.uuid }}" {{ filters.type == t.uuid ? 'selected' }}>{{ t.name }}</option>{% endfor %}
                </select>
            </div>
            <div class="col-6 col-md-3 d-flex gap-3 align-bottom">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="available" value="1" id="f-avail" {{ filters.available ? 'checked' }} onchange="this.form.submit()">
                    <label class="form-check-label small" for="f-avail">{{ 'shift.filter.available'|trans }}</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="mine" value="1" id="f-mine" {{ filters.mine ? 'checked' }} onchange="this.form.submit()">
                    <label class="form-check-label small" for="f-mine">{{ 'shift.filter.mine'|trans }}</label>
                </div>
                <noscript><button class="btn btn-sm btn-primary">{{ 'common.action.apply'|trans }}</button></noscript>
            </div>
        </div>
        {{ d.card_end({tag: 'form'}) }}
    </div>


  {# SHIFTS / HOURS RENDERING #}
  {% if byHour is empty %}
    {{ d.empty_state('shift.empty.title'|trans, {message: 'shift.empty.filtered'|trans({'%date%': selectedDate|app_date})}) }}
  {% else %}
    {% for hour, cards in byHour %}
      {{ d.section_header(hour, {size: 'h2', class: 'mb-1'}) }}
      {% for card in cards %}
        {% set shift = card.shift %}
        {{ d.card_start(null, {
          class: ('mb-2 ' ~ (shift.past ? 'opacity-75' : ''))|trim,
          bodyClass: 'card-body py-2'
        }) }}
            <div class="d-flex justify-content-between align-items-start gap-2">
              <div>
                <a href="{{ path('app_shift_show', {id: shift.uuid}) }}" class="fw-semibold text-decoration-none">{{ shift.title }}</a>
                <div class="text-muted small">
                  {{ shift.startsAt|app_time }}-{{ shift.endsAt|app_time }}
                  {% if shift.location %} · {{ shift.location.name }}{% endif %}
                  {% if shift.shiftTask %} · {{ 'shift.browse.task_label'|trans }} {{ shift.shiftTask.name }}{% endif %}
                </div>
                {% if card.groupSize > 1 %}
                  {# Counted, not listed: the members are described in the dialog, which is rendered
                     server-side and leaves out any shift this viewer may not see. #}
                  <div class="mt-1">
                    {{ d.badge('shift.group.badge'|trans({'%name%': shift.shiftGroup.name, '%count%': card.groupSize}), 'text-bg-info') }}
                  </div>
                {% endif %}
                {% if shift.description %}
                  <div class="text-secondary small mt-1">
                    {{ shift.description|length > 120 ? shift.description|slice(0, 120) ~ '…' : shift.description|raw }}
                  </div>
                {% endif %}
              </div>
              {{ d.status_badge(card.status, {map: shiftStatusStyles, label: shiftStatusLabels[card.status]}) }}
            </div>

            {% if card.availability is not empty %}
              <div class="d-flex flex-wrap gap-1 mt-2">
                {% for row in card.availability %}
                  {{ d.badge(
                    row.type.name ~ ' ' ~ row.assigned ~ '/' ~ row.needed,
                    row.assigned >= row.needed ? 'text-bg-success' : 'text-bg-secondary'
                  ) }}
                {% endfor %}
              </div>
            {% endif %}

            <div class="d-flex flex-wrap gap-2 mt-2">
              {% if card.myEntry %}
                {% if card.groupSize > 1 %}
                  <form method="post" action="{{ path('app_shift_cancel', {id: card.myEntry.uuid}) }}"
                        {{ include('shift/_group_attrs.html.twig', {shift: shift, count: card.groupSize, mode: 'cancel'}) }}>
                    <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ card.myEntry.id) }}">
                    <button class="btn btn-sm btn-outline-danger">{{ 'shift.action.cancel_signup'|trans }}</button>
                  </form>
                {% else %}
                  {{ d.delete_form(
                    path('app_shift_cancel', {id: card.myEntry.uuid}),
                    csrf_token('cancel' ~ card.myEntry.id),
                    {label: 'shift.action.cancel_signup'|trans, message: 'shift.confirm.cancel_signup'|trans}
                  ) }}
                {% endif %}
              {% elseif card.options is not empty %}
                <form method="post" action="{{ path('app_shift_signup', {id: shift.uuid}) }}" class="d-flex gap-2 align-items-center"
                      {% if card.groupSize > 1 %}
                        {{ include('shift/_group_attrs.html.twig', {shift: shift, count: card.groupSize, mode: 'apply'}) }}
                      {% endif %}>
                  <input type="hidden" name="_token" value="{{ csrf_token('signup' ~ shift.id) }}">
                  <select name="volunteer_type" class="form-select form-select-sm" style="width:auto">
                    {% for id, type in card.options %}<option value="{{ id }}">{{ type.name }}</option>{% endfor %}
                  </select>
                  <button class="btn btn-sm btn-primary">{{ 'shift.action.signup'|trans }}</button>
                  {% if card.groupSize > 1 %}
                    <a href="#" class="small" data-action="shift-group#info">{{ 'shift.group.info_link_short'|trans }}</a>
                  {% endif %}
                </form>
              {% endif %}

              {% if is_granted('shift:manage') %}
                <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_manage_shift_needs', {id: shift.uuid}) }}">{{ 'shift.action.manage'|trans }}</a>
              {% endif %}
            </div>
        {{ d.card_end({bodyClass: 'card-body py-2'}) }}
      {% endfor %}
    {% endfor %}
  {% endif %}
{% endblock %}
