{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}
{% import 'components/notification/_macros.twig' as n %}

{% block title %}{{ 'shift.page.title'|trans }}{% endblock %}

{# This page's own shift-status vocabulary, passed into d.status_badge() via its
   `map`/`label` options. #}
{% set shiftStatusStyles = {
  'signed_up': 'text-bg-success',
  'available': 'text-bg-warning',
  'full': 'text-bg-secondary',
  'overlap': 'text-bg-danger',
  'ineligible': 'text-bg-light',
  'past': 'text-bg-light'
} %}
{% set shiftStatusLabels = {
  'signed_up': 'shift.status.signed_up'|trans,
  'available': 'shift.status.available'|trans,
  'full': 'common.state.full'|trans,
  'overlap': 'shift.status.overlap'|trans,
  'ineligible': 'shift.status.ineligible'|trans,
  'past': 'shift.status.past'|trans
} %}

{# The same six states on the card's time column, in solid colours rather than the badge's soft
   ones, so a long list is scannable without reading every badge. #}
{% set shiftTimeStyles = {
  'signed_up': 'bg-green',
  'available': 'bg-blue',
  'full': 'bg-secondary',
  'overlap': 'bg-secondary',
  'ineligible': 'bg-secondary',
  'past': 'bg-secondary'
} %}

{% block body %}
  {{ d.page_header('shift.page.title'|trans, {
    subtitle: 'shift.page.subtitle'|trans,
    actions: [{label: 'shift.action.my_shifts'|trans, href: path('app_my_shifts'), class: 'btn btn-primary'}]
  }) }}

  {% if checkInMessage %}
    {% set checkInBanner %}
      <strong>{{ 'shift.checkin.banner.title'|trans }}</strong> {{ checkInMessage }}
    {% endset %}
    {{ n.alert('warning', null, {messageHtml: checkInBanner}) }}
  {% endif %}

  {% if is_granted('manageshifts:view') %}
    {% set staffBanner %}
      <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2">
        <div>
          <strong>{{ 'shift.staff_apply.banner.title'|trans }}</strong>
          <div>{{ 'shift.staff_apply.banner.body'|trans }}</div>
        </div>
        <a class="btn btn-info" href="{{ path('app_manage_shifts_apply') }}">{{ 'shift.staff_apply.banner.action'|trans }}</a>
      </div>
    {% endset %}
    {{ n.alert('info', null, {messageHtml: staffBanner}) }}
  {% endif %}


    <div class="card mb-4">
        <div class="mt-2 mx-2">
            {# Date links preserve the other active filters. #}
            <nav class="nav nav-segmented nav-2 w-100" role="tablist" aria-label="{{ 'shift.filter.date_aria'|trans }}">
                {% for day in days %}
                    {% set isSel = day == selectedDate|date('Y-m-d') %}
                    <a class="btn nav-link{{ isSel ? ' bg-primary text-primary-fg' : '' }}{{ isSel ? ' active' : '' }}"
                       role="tab"
                       aria-selected="{{ isSel ? 'true' : 'false' }}"
                       href="{{ path('app_shift_index', {date: day, location: filters.location, type: filters.type, available: filters.available ? 1 : null, mine: filters.mine ? 1 : null}) }}">
                        {{ day|date('D d M') }}
                    </a>
                {% endfor %}
                {% if days is empty %}{{ d.empty_inline('shift.empty.no_upcoming'|trans, {tag: 'span', class: 'text-muted small'}) }}{% endif %}
            </nav>
        </div>



        {# The filter controls auto-submit; the form carries the selected date. #}
        {{ d.card_start(null, {tag: 'form', class: 'mx-2 my-2', attrs: {method: 'get', action: path('app_shift_index')}}) }}
        <input type="hidden" name="date" value="{{ selectedDate|date('Y-m-d') }}">
        <div class="row g-2 align-items-end">
            <div class="col-6 col-md-3">
                <label class="form-label small mb-0" for="f-loc">{{ 'common.label.location'|trans }}</label>
                <select id="f-loc" name="location" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">{{ 'shift.filter.all'|trans }}</option>
                    {% for l in locations %}<option value="{{ l.uuid }}" {{ filters.location == l.uuid ? 'selected' }}>{{ l.fullName }}</option>{% endfor %}
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small mb-0" for="f-type">{{ 'shift.filter.type_label'|trans }}</label>
                <select id="f-type" name="type" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">{{ 'shift.filter.all'|trans }}</option>
                    {% for t in shiftTasks %}<option value="{{ t.uuid }}" {{ filters.type == t.uuid ? 'selected' }}>{{ t.name }}</option>{% endfor %}
                </select>
            </div>
            <div class="col-6 col-md-3 d-flex gap-3 align-bottom">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="available" value="1" id="f-avail" {{ filters.available ? 'checked' }} onchange="this.form.submit()">
                    <label class="form-check-label small" for="f-avail">{{ 'shift.filter.available'|trans }}</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="mine" value="1" id="f-mine" {{ filters.mine ? 'checked' }} onchange="this.form.submit()">
                    <label class="form-check-label small" for="f-mine">{{ 'shift.filter.mine'|trans }}</label>
                </div>
                <noscript><button class="btn btn-sm btn-primary">{{ 'common.action.apply'|trans }}</button></noscript>
            </div>
        </div>
        {{ d.card_end({tag: 'form'}) }}
    </div>


  {# SHIFTS / HOURS RENDERING #}
  {% if byHour is empty %}
    {{ d.empty_state('shift.empty.title'|trans, {message: 'shift.empty.filtered'|trans({'%date%': selectedDate|app_date})}) }}
  {% else %}
    {% for hour, cards in byHour %}
      <div class="hr-text hr-text-start mb-4"><h1 class="m-0 text-primary">{{ hour }}</h1></div>
        <div class="row">
        {% for card in cards %}
          {{ include('shift/_card.html.twig', {
            card: card,
            statusStyles: shiftStatusStyles,
            statusLabels: shiftStatusLabels,
            timeStyles: shiftTimeStyles
          }) }}
        {% endfor %}

        </div>


    {% endfor %}
  {% endif %}
{% endblock %}
