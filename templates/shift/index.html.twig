{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}Shifts{% endblock %}

{# This page's own shift-status vocabulary, passed into d.status_badge() via its
   `map`/`label` options. #}
{% set shiftStatusStyles = {
  'signed_up': 'text-bg-success',
  'available': 'text-bg-primary',
  'full': 'text-bg-secondary',
  'overlap': 'text-bg-warning',
  'ineligible': 'text-bg-light',
  'past': 'text-bg-light'
} %}
{% set shiftStatusLabels = {
  'signed_up': 'Signed up',
  'available': 'Open',
  'full': 'Full',
  'overlap': 'Overlaps',
  'ineligible': 'Not eligible',
  'past': 'Past'
} %}

{% block body %}
  {{ d.page_header('Shifts', {
    subtitle: 'Browse and sign up for shifts.',
    actions: [{label: 'My shifts', href: path('app_my_shifts'), class: 'btn btn-outline-primary'}]
  }) }}

  {# Date links preserve the other active filters. #}
  <div class="d-flex flex-wrap gap-1 mb-2" role="group" aria-label="Date">
    {% for day in days %}
      {% set isSel = day == selectedDate|date('Y-m-d') %}
      <a class="btn btn-sm {{ isSel ? 'btn-primary' : 'btn-outline-secondary' }}"
         href="{{ path('app_shift_index', {date: day, location: filters.location, type: filters.type, available: filters.available ? 1 : null, mine: filters.mine ? 1 : null}) }}">
        {{ day|date('D d M') }}
      </a>
    {% endfor %}
    {% if days is empty %}{{ d.empty_inline('No upcoming shifts.', {tag: 'span', class: 'text-muted small'}) }}{% endif %}
  </div>

  {# The filter controls auto-submit; the form carries the selected date. #}
  {{ d.card_start(null, {tag: 'form', class: 'mb-3', attrs: {method: 'get', action: path('app_shift_index')}}) }}
      <input type="hidden" name="date" value="{{ selectedDate|date('Y-m-d') }}">
      <div class="row g-2 align-items-end">
        <div class="col-6 col-md-3">
          <label class="form-label small mb-0" for="f-loc">Location</label>
          <select id="f-loc" name="location" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">All</option>
            {% for l in locations %}<option value="{{ l.id }}" {{ filters.location == l.id ? 'selected' }}>{{ l.name }}</option>{% endfor %}
          </select>
        </div>
        <div class="col-6 col-md-3">
          <label class="form-label small mb-0" for="f-type">Shift type</label>
          <select id="f-type" name="type" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">All</option>
            {% for t in shiftTasks %}<option value="{{ t.id }}" {{ filters.type == t.id ? 'selected' }}>{{ t.name }}</option>{% endfor %}
          </select>
        </div>
        <div class="col-12 col-md-6 d-flex gap-3 pb-1">
          <div class="form-check">
            <input class="form-check-input" type="checkbox" name="available" value="1" id="f-avail" {{ filters.available ? 'checked' }} onchange="this.form.submit()">
            <label class="form-check-label small" for="f-avail">Only ones I can join</label>
          </div>
          <div class="form-check">
            <input class="form-check-input" type="checkbox" name="mine" value="1" id="f-mine" {{ filters.mine ? 'checked' }} onchange="this.form.submit()">
            <label class="form-check-label small" for="f-mine">Only my roles</label>
          </div>
          <noscript><button class="btn btn-sm btn-primary">Apply</button></noscript>
        </div>
      </div>
  {{ d.card_end({tag: 'form'}) }}

  {% if byHour is empty %}
    {{ d.empty_state('No shifts', {message: 'No shifts match your filters for ' ~ selectedDate|app_date ~ '.'}) }}
  {% else %}
    {% for hour, cards in byHour %}
      {{ d.section_header(hour, {size: 'h2', class: 'mt-3'}) }}
      {% for card in cards %}
        {% set shift = card.shift %}
        {{ d.card_start(null, {
          class: ('mb-2 ' ~ (shift.past ? 'opacity-75' : ''))|trim,
          bodyClass: 'card-body py-2'
        }) }}
            <div class="d-flex justify-content-between align-items-start gap-2">
              <div>
                <a href="{{ path('app_shift_show', {id: shift.uuid}) }}" class="fw-semibold text-decoration-none">{{ shift.title }}</a>
                <div class="text-muted small">
                  {{ shift.startsAt|app_time }}-{{ shift.endsAt|app_time }}
                  {% if shift.location %} · {{ shift.location.name }}{% endif %}
                  {% if shift.shiftTask %} · {{ 'Task:' | trans }} {{ shift.shiftTask.name }}{% endif %}
                </div>
              </div>
              {{ d.status_badge(card.status, {map: shiftStatusStyles, label: shiftStatusLabels[card.status]}) }}
            </div>

            {% if card.availability is not empty %}
              <div class="d-flex flex-wrap gap-1 mt-2">
                {% for row in card.availability %}
                  {{ d.badge(
                    row.type.name ~ ' ' ~ row.assigned ~ '/' ~ row.needed,
                    row.assigned >= row.needed ? 'text-bg-success' : 'text-bg-secondary'
                  ) }}
                {% endfor %}
              </div>
            {% endif %}

            <div class="d-flex flex-wrap gap-2 mt-2">
              {% if card.myEntry %}
                {{ d.delete_form(
                  path('app_shift_cancel', {id: card.myEntry.uuid}),
                  csrf_token('cancel' ~ card.myEntry.id),
                  {label: 'Cancel sign-up', message: 'Cancel your sign-up?'}
                ) }}
              {% elseif card.options is not empty %}
                <form method="post" action="{{ path('app_shift_signup', {id: shift.uuid}) }}" class="d-flex gap-2">
                  <input type="hidden" name="_token" value="{{ csrf_token('signup' ~ shift.id) }}">
                  <select name="volunteer_type" class="form-select form-select-sm" style="width:auto">
                    {% for id, type in card.options %}<option value="{{ id }}">{{ type.name }}</option>{% endfor %}
                  </select>
                  <button class="btn btn-sm btn-primary">Sign up</button>
                </form>
              {% endif %}

              {% if is_granted('shift:manage') %}
                <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_manage_shift_needs', {id: shift.uuid}) }}">Manage</a>
              {% endif %}
            </div>
        {{ d.card_end({bodyClass: 'card-body py-2'}) }}
      {% endfor %}
    {% endfor %}
  {% endif %}
{% endblock %}
