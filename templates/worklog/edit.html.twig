{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}Edit worklog{% endblock %}

{% block body %}
  {{ d.page_header('Edit worklog entry', {
    actions: [{label: '← Profile', href: path('app_profile'), class: 'btn btn-outline-secondary'}]
  }) }}

  {{ form_start(form) }}
    {% set worklogFooter %}
      <button class="btn btn-primary">Save</button>
    {% endset %}
    {{ d.card_start(null, {class: '', attrs: {style: 'max-width: 32rem;'}}) }}
        {{ form_row(form.hours) }}
        {{ form_row(form.workedAt) }}
        {{ form_row(form.comment) }}
    {{ d.card_end({footer: worklogFooter}) }}
  {{ form_end(form) }}
{% endblock %}
