{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ 'availability.page.title'|trans }}{% endblock %}

{% block body %}
  {{ d.page_header('availability.page.title'|trans, {
    subtitle: 'availability.page.subtitle'|trans
  }) }}

  <form method="post" action="{{ path('app_availability_submit') }}"
        data-controller="availability"
        data-availability-ranges-value="{{ ranges|json_encode|e('html_attr') }}"
        data-availability-overlays-value="{{ overlays|json_encode|e('html_attr') }}"
        data-availability-raster-value="{{ rasterMinutes }}">
    <input type="hidden" name="_token" value="{{ csrf_token('availability_submit') }}">
    <input type="hidden" name="ranges" data-availability-target="payload">

    {{ d.card_start(null, {bodyClass: 'card-body d-flex flex-wrap align-items-center gap-3'}) }}
        <div class="btn-group" role="group" aria-label="{{ 'availability.value_aria'|trans }}">
          {% for value in values %}
            <input type="radio" class="btn-check" name="paint-value" id="pv-{{ value.value }}"
                   value="{{ value.value }}" {{ value.value == 'available' ? 'checked' : '' }}
                   data-availability-target="valueInput" data-action="availability#setValue">
            <label class="btn btn-outline-secondary avail-swatch-{{ value.value }}" for="pv-{{ value.value }}">{{ value.label }}</label>
          {% endfor %}
          <input type="radio" class="btn-check" name="paint-value" id="pv-erase" value=""
                 data-availability-target="valueInput" data-action="availability#setValue">
          <label class="btn btn-outline-secondary" for="pv-erase">{{ 'availability.action.erase'|trans }}</label>
        </div>
        <div class="text-secondary small">{{ 'availability.hint'|trans }}</div>
        <button type="submit" class="btn btn-primary ms-auto">{{ 'availability.action.save'|trans }}</button>
    {{ d.card_end({bodyClass: 'card-body d-flex flex-wrap align-items-center gap-3'}) }}

      {{ d.card_start(null, {class: 'mb-3'}) }}
      <label class="form-label" for="avail-comment">{{ 'availability.comment_label'|trans }}</label>
      <textarea class="form-control" id="avail-comment" name="comment" rows="2">{{ comment }}</textarea>
      {{ d.card_end() }}

    <div class="planner mb-3" data-availability-target="grid">
      <div class="planner-grid">
        <div class="planner-axis">
          <div class="planner-axis-head mb-2"></div>
          {% for hour in 0..23 %}
            <div class="planner-axis-hour">{{ '%02d:00'|format(hour) }}</div>
          {% endfor %}
        </div>
        {% for day in days %}
          <div class="planner-day planner-phase-{{ day.phase }}">
            <div class="planner-day-head">
              {{ day.label }}
              {% if day.phase != 'main' %}<span class="planner-phase-tag">{{ day.phase }}</span>{% endif %}
            </div>
            <div class="planner-day-body avail-day-body" data-availability-target="dayBody" data-day="{{ day.iso }}"></div>
          </div>
        {% endfor %}
      </div>
    </div>

  </form>
{% endblock %}
