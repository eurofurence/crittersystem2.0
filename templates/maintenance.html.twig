{% extends 'install/_layout.html.twig' %}

{% block title %}Maintenance · VMS{% endblock %}

{% block content %}
    <div class="empty">
        <div class="empty-img">
            <svg class="img" xmlns="http://www.w3.org/2000/svg" height="180" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"
                 style="color: var(--tblr-primary)">
                <path d="M0 0h24v24H0z" stroke="none"/>
                <path d="M7 10h3v-3l-3.5 -3.5a6 6 0 0 1 8 8l6 6a2 2 0 0 1 -3 3l-6 -6a6 6 0 0 1 -8 -8l3.5 3.5"/>
            </svg>
        </div>
        <p class="empty-title">Temporarily down for maintenance</p>
        <p class="empty-subtitle text-secondary">
            We’re applying a database update right now. The system will be back online automatically as soon
            as it finishes — please try again in a moment.
        </p>
        <div class="empty-action">
            <a href="." class="btn btn-primary">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-2">
                    <path d="M0 0h24v24H0z" stroke="none"/>
                    <path d="M20 11a8.1 8.1 0 0 0 -15.5 -2m-.5 -4v4h4"/>
                    <path d="M4 13a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4"/>
                </svg>
                Retry
            </a>
        </div>
    </div>
{% endblock %}
