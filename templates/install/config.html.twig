{% extends 'install/_layout.html.twig' %}

{% block title %}Configuration · Setup · VMS{% endblock %}

{% block content %}
    {% include 'install/_brand.html.twig' %}

    <form class="card card-md" method="post" action="{{ path('app_install_config') }}" data-turbo="false">
        <div class="card-body">
            <h2 class="mb-1">Optional configuration</h2>
            <p class="text-secondary">
                You can set a few basics now, or skip and configure everything later from
                <em>Manage → Configuration</em>.
            </p>

            {% include 'install/_flashes.html.twig' %}
            <input type="hidden" name="_token" value="{{ csrf_token('install_config') }}">

            <div class="mb-3">
                <label class="form-label">Event name</label>
                <input type="text" name="event_name" class="form-control" value="{{ eventName }}" placeholder="e.g. Eurofurence 28">
            </div>
            <div class="mb-3">
                <label class="form-label">Timezone</label>
                <select name="timezone" class="form-select">
                    {% for tz in timezones %}
                        <option value="{{ tz }}" {{ tz == timezone ? 'selected' : '' }}>{{ tz }}</option>
                    {% endfor %}
                </select>
                <small class="form-hint">Used to display dates/times. Data is always stored in UTC.</small>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Date format</label>
                    <input type="text" name="date_format" class="form-control" value="{{ dateFormat }}">
                    <small class="form-hint">PHP date() format, e.g. <code>D, d M Y</code>.</small>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Time format</label>
                    <input type="text" name="time_format" class="form-control" value="{{ timeFormat }}">
                    <small class="form-hint">PHP date() format, e.g. <code>H:i</code>.</small>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <div class="btn-list justify-content-end">
                <button type="submit" name="action" value="skip" class="btn btn-link link-secondary">Skip for now</button>
                <button type="submit" name="action" value="save" class="btn btn-primary">Save &amp; finish</button>
            </div>
        </div>
    </form>

    {% embed 'install/_progress.html.twig' %}
        {% block buttons %}{% endblock %}
    {% endembed %}
{% endblock %}
