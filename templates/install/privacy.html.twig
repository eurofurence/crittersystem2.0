{% extends 'install/_layout.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}Privacy notice · Setup · VMS{% endblock %}

{% block content %}
    {% include 'install/_brand.html.twig' %}

    {% set privacyFooter %}
        <div class="btn-list justify-content-end">
            <button type="submit" name="action" value="skip" class="btn btn-link link-secondary">Skip for now</button>
            <button type="submit" name="action" value="save" class="btn btn-primary">Save &amp; finish</button>
        </div>
    {% endset %}
    {{ d.card_start(null, {
        tag: 'form',
        class: 'card-md',
        attrs: {method: 'post', action: path('app_install_privacy'), 'data-turbo': 'false'}
    }) }}
            <h2 class="mb-1">Privacy notice</h2>
            <p class="text-secondary">
                The essentials for the GDPR privacy notice and the onboarding consent shown to
                volunteers. You can write the full notice text later from
                <em>Manage → Privacy notice</em>.
            </p>

            {% include 'install/_flashes.html.twig' %}
            <input type="hidden" name="_token" value="{{ csrf_token('install_privacy') }}">

            <div class="mb-3">
                <label class="form-label">Event name</label>
                <input type="text" name="event_name" class="form-control" value="{{ eventName }}" placeholder="e.g. Eurofurence 28">
            </div>
            <div class="mb-3">
                <label class="form-label">Data controller</label>
                <input type="text" name="controller_org" class="form-control" value="{{ controllerOrg }}" placeholder="Organization responsible for the data">
            </div>
            <div class="row">
                <div class="col-md-7 mb-3">
                    <label class="form-label">Privacy contact email</label>
                    <input type="email" name="contact_email" class="form-control" value="{{ contactEmail }}" placeholder="privacy@example.org">
                </div>
                <div class="col-md-5 mb-3">
                    <label class="form-label">Days until data deletion</label>
                    <input type="number" name="deletion_days" class="form-control" min="1" value="{{ deletionDays }}">
                    <small class="form-hint">Personal data is purged this many days after the event.</small>
                </div>
            </div>
    {{ d.card_end({tag: 'form', footer: privacyFooter}) }}

    {% embed 'install/_progress.html.twig' %}
        {% block buttons %}{% endblock %}
    {% endembed %}
{% endblock %}
