{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}
{% block title %}{{ 'two_factor.index.title'|trans }}{% endblock %}
{% block body %}
  {{ d.page_header('two_factor.index.title'|trans, {subtitle: 'two_factor.index.subtitle'|trans}) }}
  {{ d.card_start(null, {class: ''}) }}
    {% if user.twoFactorEnabled %}
      <p>{{ d.badge('common.state.enabled'|trans, 'text-bg-success') }} {{ 'two_factor.index.active'|trans }}</p>

      {% set remaining = user.backupCodes|length %}
      <div class="mb-4">
        <h3 class="h4">{{ 'two_factor.recovery_codes'|trans }}</h3>
        {% if remaining == 0 %}
          <p class="text-danger mb-2">{{ d.badge('two_factor.index.badge_none'|trans, 'text-bg-danger') }} {{ 'two_factor.index.none_warning'|trans }}</p>
        {% else %}
          <p class="mb-2">
            {{ d.badge('two_factor.index.badge_remaining'|trans({'%count%': remaining}), remaining <= 2 ? 'text-bg-warning' : 'text-bg-secondary') }}
            {{ 'two_factor.index.remaining_hint'|trans }}
            {% if remaining <= 2 %}<span class="text-warning">{{ 'two_factor.index.running_low'|trans }}</span>{% endif %}
          </p>
        {% endif %}
        <p class="text-muted small mb-2">{{ 'two_factor.index.regen_note'|trans }}</p>
        <form method="post" action="{{ path('app_2fa_recovery_regenerate') }}" class="row g-2 align-items-end" style="max-width:28rem"
              data-controller="confirm" data-confirm-message-value="{{ 'two_factor.index.regen_confirm'|trans }}">
          <div class="col-auto"><label class="form-label">{{ 'two_factor.index.confirm_code_label'|trans }}</label><input name="code" class="form-control" autocomplete="one-time-code" required></div>
          <div class="col-auto"><button class="btn btn-outline-primary">{{ 'two_factor.index.regenerate_btn'|trans }}</button></div>
        </form>
      </div>

      {% if not user.mustUseTwoFactor %}
        <form method="post" action="{{ path('app_2fa_disable') }}" class="row g-2 align-items-end" style="max-width:24rem">
          <div class="col-auto"><label class="form-label">{{ 'two_factor.index.disable_code_label'|trans }}</label><input name="code" class="form-control" autocomplete="one-time-code" required></div>
          <div class="col-auto"><button class="btn btn-outline-danger">{{ 'two_factor.index.disable_btn'|trans }}</button></div>
        </form>
      {% else %}
        <p class="text-muted small">{{ 'two_factor.mandatory'|trans }}</p>
      {% endif %}
    {% else %}
      <p>{{ d.badge('two_factor.index.badge_not_set'|trans, 'text-bg-secondary') }} {{ 'two_factor.index.not_set_hint'|trans }}</p>
      <a class="btn btn-primary" href="{{ path('app_2fa_setup') }}">{{ 'two_factor.setup_action'|trans }}</a>
    {% endif %}
  {{ d.card_end() }}
{% endblock %}
