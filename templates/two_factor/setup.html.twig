{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}
{% block title %}{{ 'two_factor.setup.title'|trans }}{% endblock %}
{% block body %}
  {{ d.page_header('two_factor.setup_action'|trans) }}
  <div class="row g-4">
    <div class="col-md-6">
      <p>{{ 'two_factor.setup.step1'|trans }}</p>
      <img src="{{ qr }}" alt="{{ 'two_factor.setup.qr_alt'|trans }}" class="border rounded mb-2">
      <p class="small">{{ 'two_factor.setup.secret_label'|trans }} <code>{{ secret }}</code></p>
    </div>
    <div class="col-md-6">
      <p>{{ 'two_factor.setup.step2'|trans }}</p>
      <form method="post">
        <div class="mb-3"><input name="code" class="form-control" autocomplete="one-time-code" inputmode="numeric" placeholder="123456" required></div>
        <button class="btn btn-primary">{{ 'two_factor.setup.enable'|trans }}</button>
        <a class="btn btn-link" href="{{ path('app_2fa') }}">{{ 'common.action.cancel'|trans }}</a>
      </form>
    </div>
  </div>
{% endblock %}
