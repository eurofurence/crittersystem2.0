{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}
{% block title %}{{ 'ui.nav.bounty_board'|trans }}{% endblock %}
{% block body %}
  {{ d.page_header('ui.nav.bounty_board'|trans, {subtitle: 'call.page.subtitle'|trans}) }}
  {# Two topics. The shared one carries a call being raised, filled or cancelled, which concerns
     everybody who may answer; the personal one carries a refusal, which concerns one person and
     would be noise on every other board. Either way the signal only says something changed, and the
     re-fetched board applies eligibility server-side exactly as on a full page load. #}
  <div data-controller="live-stream"
       data-live-stream-topic-value="{{ mercure_topic('all_calls') }} {{ mercure_topic('user_calls') }}"
       data-live-stream-url-value="{{ path('app_bounty_frame') }}">
    {% include 'call/_bounty_list.html.twig' with {calls: calls} only %}
  </div>
{% endblock %}
