{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ 'dashboard.page.title'|trans }}{% endblock %}

{% block body %}
    {% set user = app.user %}

    {{ d.page_header('dashboard.header.welcome'|trans({'%name%': user.userIdentifier}), {
        subtitle: 'dashboard.header.subtitle'|trans,
        actions: [
            {label: 'ui.user_menu.digital_id'|trans, href: path('app_digital_id'), class: 'btn btn-outline-secondary'},
            {label: 'ui.user_menu.settings'|trans, href: path('app_settings'), class: 'btn btn-outline-secondary'}
        ]
    }) }}

    {{ d.card_start('dashboard.card.account'|trans) }}
            {# Not definition_list(): the "Roles" value is a list of badges, not a scalar. #}
            <dl class="row mb-0">
                <dt class="col-sm-3">{{ 'common.label.username'|trans }}</dt>
                <dd class="col-sm-9">{{ user.name }}</dd>

                <dt class="col-sm-3">{{ 'common.label.email'|trans }}</dt>
                <dd class="col-sm-9">{{ user.email }}</dd>

                <dt class="col-sm-3">{{ 'dashboard.field.last_login'|trans }}</dt>
                <dd class="col-sm-9">{{ user.lastLoginAt ? user.lastLoginAt|app_datetime : '-' }}</dd>

                <dt class="col-sm-3">{{ 'dashboard.field.roles'|trans }}</dt>
                <dd class="col-sm-9">
                    {% for role in user.roles %}
                        {{ d.badge(role, 'bg-primary-lt') }}
                    {% endfor %}
                </dd>
            </dl>
    {{ d.card_end() }}

    {{ d.card_start('dashboard.card.groups'|trans) }}
            {% for group in user.groups %}
                {{ d.badge(group.name, 'bg-blue-lt') }}
            {% else %}
                {{ d.empty_inline('dashboard.empty.groups'|trans, {tag: 'span', class: 'text-muted'}) }}
            {% endfor %}
    {{ d.card_end() }}

    {{ d.card_start('dashboard.card.privileges'|trans({'%count%': user.privilegeNames|length})) }}
            {% for privilege in user.privilegeNames|sort %}
                <code class="d-inline-block me-2 mb-1">{{ privilege }}</code>
            {% else %}
                {{ d.empty_inline('dashboard.empty.privileges'|trans, {tag: 'span', class: 'text-muted'}) }}
            {% endfor %}
    {{ d.card_end() }}

    {{ d.card_start('dashboard.card.voter_check'|trans, {class: ''}) }}
            <p class="text-muted small">{{ 'dashboard.voter_check.help'|trans }} <code>is_granted()</code>.</p>
            <ul class="list-unstyled mb-0">
                {% for privilege in ['user:view', 'news:manage', 'goodie:manage', 'shift:view'] %}
                    <li>
                        {% if is_granted(privilege) %}✅{% else %}⛔{% endif %}
                        <code>{{ privilege }}</code>
                    </li>
                {% endfor %}
            </ul>
    {{ d.card_end() }}
{% endblock %}
