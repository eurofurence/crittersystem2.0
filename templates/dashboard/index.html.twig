{% extends 'base.html.twig' %}

{% block title %}Dashboard · Critter{% endblock %}

{% block body %}
    {% set user = app.user %}

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h1 class="h3 mb-0">Welcome, {{ user.userIdentifier }} 👋</h1>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_digital_id') }}">🪪 Digital ID</a>
            <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_settings') }}">⚙️ Settings</a>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header fw-semibold">Account</div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Username</dt>
                <dd class="col-sm-9">{{ user.name }}</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">{{ user.email }}</dd>

                <dt class="col-sm-3">Last login</dt>
                <dd class="col-sm-9">{{ user.lastLoginAt ? user.lastLoginAt|date('Y-m-d H:i') : '—' }}</dd>

                <dt class="col-sm-3">Roles</dt>
                <dd class="col-sm-9">
                    {% for role in user.roles %}
                        <span class="badge text-bg-primary">{{ role }}</span>
                    {% endfor %}
                </dd>
            </dl>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header fw-semibold">Groups</div>
        <div class="card-body">
            {% for group in user.groups %}
                <span class="badge text-bg-secondary">{{ group.name }}</span>
            {% else %}
                <span class="text-muted">No groups assigned.</span>
            {% endfor %}
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header fw-semibold">Effective privileges ({{ user.privilegeNames|length }})</div>
        <div class="card-body">
            {% for privilege in user.privilegeNames|sort %}
                <code class="d-inline-block me-2 mb-1">{{ privilege }}</code>
            {% else %}
                <span class="text-muted">No privileges.</span>
            {% endfor %}
        </div>
    </div>

    <div class="card">
        <div class="card-header fw-semibold">Privilege voter check (live)</div>
        <div class="card-body">
            <p class="text-muted small">Demonstrates the fine-grained privilege voter via <code>is_granted()</code>.</p>
            <ul class="list-unstyled mb-0">
                {% for privilege in ['admin_user', 'admin_news', 'backstage.goodies.admin', 'user_shifts'] %}
                    <li>
                        {% if is_granted(privilege) %}✅{% else %}⛔{% endif %}
                        <code>{{ privilege }}</code>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>
{% endblock %}
