{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}Dashboard · Critter{% endblock %}

{% block body %}
    {% set user = app.user %}

    {{ d.page_header('Welcome, ' ~ user.userIdentifier, {
        subtitle: 'Your account at a glance.',
        actions: [
            {label: 'Digital ID', href: path('app_digital_id'), class: 'btn btn-outline-secondary'},
            {label: 'Settings', href: path('app_settings'), class: 'btn btn-outline-secondary'}
        ]
    }) }}

    {{ d.card_start('Account') }}
            {# Not definition_list(): the "Roles" value is a list of badges, not a scalar. #}
            <dl class="row mb-0">
                <dt class="col-sm-3">Username</dt>
                <dd class="col-sm-9">{{ user.name }}</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">{{ user.email }}</dd>

                <dt class="col-sm-3">Last login</dt>
                <dd class="col-sm-9">{{ user.lastLoginAt ? user.lastLoginAt|app_datetime : '—' }}</dd>

                <dt class="col-sm-3">Roles</dt>
                <dd class="col-sm-9">
                    {% for role in user.roles %}
                        {{ d.badge(role, 'bg-primary-lt') }}
                    {% endfor %}
                </dd>
            </dl>
    {{ d.card_end() }}

    {{ d.card_start('Groups') }}
            {% for group in user.groups %}
                {{ d.badge(group.name, 'bg-blue-lt') }}
            {% else %}
                {{ d.empty_inline('No groups assigned.', {tag: 'span', class: 'text-muted'}) }}
            {% endfor %}
    {{ d.card_end() }}

    {{ d.card_start('Effective privileges (' ~ user.privilegeNames|length ~ ')') }}
            {% for privilege in user.privilegeNames|sort %}
                <code class="d-inline-block me-2 mb-1">{{ privilege }}</code>
            {% else %}
                {{ d.empty_inline('No privileges.', {tag: 'span', class: 'text-muted'}) }}
            {% endfor %}
    {{ d.card_end() }}

    {{ d.card_start('Privilege voter check (live)', {class: ''}) }}
            <p class="text-muted small">Demonstrates the fine-grained privilege voter via <code>is_granted()</code>.</p>
            <ul class="list-unstyled mb-0">
                {% for privilege in ['user:view', 'news:manage', 'goodie:manage', 'shift:view'] %}
                    <li>
                        {% if is_granted(privilege) %}✅{% else %}⛔{% endif %}
                        <code>{{ privilege }}</code>
                    </li>
                {% endfor %}
            </ul>
    {{ d.card_end() }}
{% endblock %}
