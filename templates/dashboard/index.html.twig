{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}Dashboard · Critter{% endblock %}

{% block body %}
    {% set user = app.user %}

    {{ d.page_header('Welcome, ' ~ user.userIdentifier, {
        subtitle: 'Your account at a glance.',
        actions: [
            {label: 'Digital ID', href: path('app_digital_id'), class: 'btn btn-outline-secondary'},
            {label: 'Settings', href: path('app_settings'), class: 'btn btn-outline-secondary'}
        ]
    }) }}

    <div class="card mb-3">
        <div class="card-header"><h3 class="card-title">Account</h3></div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Username</dt>
                <dd class="col-sm-9">{{ user.name }}</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">{{ user.email }}</dd>

                <dt class="col-sm-3">Last login</dt>
                <dd class="col-sm-9">{{ user.lastLoginAt ? user.lastLoginAt|app_datetime : '—' }}</dd>

                <dt class="col-sm-3">Roles</dt>
                <dd class="col-sm-9">
                    {% for role in user.roles %}
                        <span class="badge bg-primary-lt">{{ role }}</span>
                    {% endfor %}
                </dd>
            </dl>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header"><h3 class="card-title">Groups</h3></div>
        <div class="card-body">
            {% for group in user.groups %}
                <span class="badge bg-blue-lt">{{ group.name }}</span>
            {% else %}
                <span class="text-muted">No groups assigned.</span>
            {% endfor %}
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header"><h3 class="card-title">Effective privileges ({{ user.privilegeNames|length }})</h3></div>
        <div class="card-body">
            {% for privilege in user.privilegeNames|sort %}
                <code class="d-inline-block me-2 mb-1">{{ privilege }}</code>
            {% else %}
                <span class="text-muted">No privileges.</span>
            {% endfor %}
        </div>
    </div>

    <div class="card">
        <div class="card-header"><h3 class="card-title">Privilege voter check (live)</h3></div>
        <div class="card-body">
            <p class="text-muted small">Demonstrates the fine-grained privilege voter via <code>is_granted()</code>.</p>
            <ul class="list-unstyled mb-0">
                {% for privilege in ['user:view', 'news:manage', 'goodie:manage', 'shift:view'] %}
                    <li>
                        {% if is_granted(privilege) %}✅{% else %}⛔{% endif %}
                        <code>{{ privilege }}</code>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>
{% endblock %}
