{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}Apply to staff shifts{% endblock %}

{% block body %}
  {{ d.page_header('Apply to staff shifts', {
    subtitle: 'Staff shifts you are eligible to see and apply for.',
    actions: [{label: '← Shift Manager', href: path('app_manage_shifts'), class: 'btn btn-outline-secondary'}]
  }) }}

  {% if recommendedMax > 0 %}
    <div class="alert {{ overHours > 0 ? 'alert-warning' : 'alert-info' }} d-flex align-items-center">
      <div>
        You have <strong>{{ plannedHours|round(1) }}</strong> planned hours
        (recommended max {{ recommendedMax }}).
        {% if overHours > 0 %}<strong>{{ overHours|round(1) }} h over</strong> the recommendation.{% endif %}
      </div>
    </div>
  {% endif %}

  {% set hasAny = groups.member|length > 0 or groups.other|length > 0 %}
  {% if not hasAny %}
    {{ d.empty_state('No staff shifts available', {message: 'There are no published staff shifts you can apply to right now.'}) }}
  {% else %}
    {% for section, label in {'member': 'Your departments', 'other': 'Other departments'} %}
      {% for group in groups[section] %}
        <div class="card mb-3">
          <div class="card-header">
            <h3 class="card-title">{{ group.department.name }}</h3>
            <span class="ms-2 badge {{ section == 'member' ? 'bg-green-lt' : 'bg-secondary-lt' }}">{{ label }}</span>
          </div>
          <div class="list-group list-group-flush">
            {% for row in group.shifts %}
              {# Each row is its own Turbo Frame, polled for live capacity/status.
                 Keep the frame ids stable — the server responses target them by id. #}
              <turbo-frame id="apply-row-{{ row.shift.id }}"
                           src="{{ path('app_manage_shifts_apply_frame', {id: row.shift.uuid}) }}"
                           data-controller="live-refresh"
                           data-live-refresh-frame-value="apply-row-{{ row.shift.id }}"
                           data-live-refresh-interval-value="20000">
                {% include 'shift_manager/_apply_row.html.twig' with {row: row, signupOptions: []} only %}
              </turbo-frame>
            {% endfor %}
          </div>
        </div>
      {% endfor %}
    {% endfor %}
  {% endif %}
{% endblock %}
