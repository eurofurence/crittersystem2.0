{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ 'shift_manager.apply.title'|trans }}{% endblock %}

{% block body %}
  {{ d.page_header('shift_manager.apply.title'|trans, {
    subtitle: 'shift_manager.apply.subtitle'|trans,
    actions: [{label: 'shift_manager.action.back_to_manager'|trans, href: path('app_manage_shifts'), class: 'btn btn-outline-secondary'}]
  }) }}

  {% if recommendedMax > 0 %}
    <div class="alert {{ overHours > 0 ? 'alert-warning' : 'alert-info' }} d-flex align-items-center">
      <div>
        {{ 'shift_manager.apply.planned_hours'|trans({'%hours%': plannedHours|round(1), '%max%': recommendedMax})|raw }}
        {% if overHours > 0 %}{{ 'shift_manager.apply.over_hours'|trans({'%amount%': overHours|round(1)})|raw }}{% endif %}
      </div>
    </div>
  {% endif %}

  {% set hasAny = groups.member|length > 0 or groups.other|length > 0 %}
  {% if not hasAny %}
    {{ d.empty_state('shift_manager.apply.empty.title'|trans, {message: 'shift_manager.apply.empty.message'|trans}) }}
  {% else %}
    {% for section, label in {'member': 'shift_manager.apply.your_departments'|trans, 'other': 'shift_manager.apply.other_departments'|trans} %}
      {% for group in groups[section] %}
        <div class="card mb-3">
          <div class="card-header">
            <h3 class="card-title">{{ group.department.name }}</h3>
            <span class="ms-2 badge {{ section == 'member' ? 'bg-green-lt' : 'bg-secondary-lt' }}">{{ label }}</span>
          </div>
          {# One live region per department, not one per row.
             Every row used to be its own Turbo Frame with its own twenty-second timer, so a
             sixty-shift day cost a hundred and eighty requests a minute from a single viewer, each
             running its own availability, eligibility and hours queries. Now one signal on the
             department's topic refreshes the whole group in one request, and only when something
             actually changed. #}
          <div class="list-group list-group-flush"
               data-controller="live-stream"
               data-live-stream-topic-value="{{ mercure_topic_department(group.department) }}"
               data-live-stream-url-value="{{ path('app_manage_shifts_apply_department', {id: group.department.uuid}) }}">
            {% include 'shift_manager/_apply_rows.html.twig' with {rows: group.shifts} only %}
          </div>
        </div>
      {% endfor %}
    {% endfor %}
  {% endif %}
{% endblock %}
