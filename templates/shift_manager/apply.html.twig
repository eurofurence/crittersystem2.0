{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}
{% import 'components/forms/_macros.twig' as f %}

{% block title %}{{ 'shift_manager.apply.title'|trans }}{% endblock %}

{% block body %}
  {{ d.page_header('shift_manager.apply.title'|trans, {
    subtitle: 'shift_manager.apply.subtitle'|trans,
    actions: [{label: 'shift_manager.action.back_to_manager'|trans, href: path('app_manage_shifts'), class: 'btn btn-outline-secondary'}]
  }) }}

  {% if grid.recommendedMax > 0 %}
    <div class="alert {{ grid.overHours > 0 ? 'alert-warning' : 'alert-info' }} d-flex align-items-center">
      <div>
        {{ 'shift_manager.apply.planned_hours'|trans({'%hours%': grid.planned|round(1), '%max%': grid.recommendedMax})|raw }}
        {% if grid.overHours > 0 %}{{ 'shift_manager.apply.over_hours'|trans({'%amount%': grid.overHours|round(1)})|raw }}{% endif %}
      </div>
    </div>
  {% endif %}

  <div data-controller="apply-grid"
       data-apply-grid-detail-url-value="{{ path('app_manage_shifts_apply_detail', {id: '__ID__'}) }}"
       data-apply-grid-grid-url-value="{{ path('app_manage_shifts_apply_grid') }}">

    {{ d.card_start(null, {bodyClass: 'card-body py-2'}) }}
      <form method="get" action="{{ path('app_manage_shifts_apply') }}"
            class="d-flex flex-wrap align-items-end gap-3"
            data-apply-grid-target="filters">
        <div>
          <label class="form-label mb-1 small" for="apply-day">{{ 'shift_manager.apply.filter.day'|trans }}</label>
          <select id="apply-day" name="day" class="form-select form-select-sm" data-action="change->apply-grid#submitFilters">
            {% for day in grid.days %}
              <option value="{{ day.iso }}" {{ day.iso == grid.day ? 'selected' : '' }}>
                {{ day.label }} ({{ day.count }})
              </option>
            {% else %}
              <option value="">{{ 'shift_manager.apply.filter.no_days'|trans }}</option>
            {% endfor %}
          </select>
        </div>

        <div>
          {# The hidden field is what an unticked box posts: without it the parameter would be absent,
             which is how a first visit looks, and unticking would silently do nothing. #}
          <input type="hidden" name="scope" value="all">
          <label class="form-check mb-1">
            <input type="checkbox" class="form-check-input" name="scope" value="mine"
                   {{ grid.mineOnly ? 'checked' : '' }} data-action="change->apply-grid#submitFilters">
            <span class="form-check-label">{{ 'shift_manager.apply.filter.mine_only'|trans }}</span>
          </label>
        </div>

        {{ f.checkbox_dropdown('departments', grid.departments|map(option => {
          value: option.department.uuid,
          label: option.department.name,
          hint: option.count,
          badge: option.member ? 'shift_manager.apply.filter.member'|trans : null,
          checked: option.selected,
        }), {
          label: 'shift_manager.apply.filter.departments'|trans,
          allLabel: 'shift_manager.apply.filter.all_departments'|trans,
          someLabel: 'shift_manager.apply.filter.some_departments'|trans({'%count%': '%count%'}),
          submitLabel: 'shift_manager.apply.filter.show'|trans,
          emptyLabel: 'shift_manager.apply.filter.no_departments'|trans,
        }) }}

        <noscript><button class="btn btn-sm btn-primary" type="submit">{{ 'shift_manager.apply.filter.show'|trans }}</button></noscript>
      </form>
    {{ d.card_end({bodyClass: 'card-body py-2'}) }}

    <div data-apply-grid-target="grid">
      {% include 'shift_manager/_apply_grid.html.twig' %}
    </div>

    {# Inside the controller element, because a Stimulus target outside it is not a target at all:
       the dialog would never be found and clicking a shift would do nothing.
       Filled by the server for whichever shift was clicked, so what may be done with it, and every
       reason it may not, is decided there rather than in the browser. #}
    <div class="modal fade" id="apply-shift-modal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content" data-apply-grid-target="dialog"></div>
      </div>
    </div>
  </div>
{% endblock %}
