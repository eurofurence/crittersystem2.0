{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}
{% import 'components/icon/_macros.twig' as i %}

{% block title %}{{ 'shift_manager.page.title'|trans }}{% endblock %}

{% block body %}
  {{ d.page_header('shift_manager.page.title'|trans, {subtitle: 'shift_manager.page.subtitle'|trans}) }}

  {#
    One tile per action. `priv: null` = available to every staff member in the module;
    otherwise the tile is gated by that privilege (checked here, never in a macro).
    These are not d.action_card() tiles: the `data-action` hook and the empty
    stretched-link anchor are part of this page's contract.
  #}
  {% set actions = [
    {action: 'apply',    priv: null,             route: 'app_manage_shifts_apply',   icon: 'checklist', color: 'text-blue',  title: 'shift_manager.apply.title'|trans,           text: 'shift_manager.action.apply.text'|trans},
    {action: 'overview', priv: null,             route: 'app_my_shifts',             icon: 'clock',     color: 'text-blue',  title: 'shift_manager.action.overview.title'|trans, text: 'shift_manager.action.overview.text'|trans},
    {action: 'manage',   priv: 'shift:manage',   route: 'app_manage_shifts_planner', icon: 'dashboard', color: 'text-green', title: 'shift_manager.action.manage.title'|trans,   text: 'shift_manager.action.manage.text'|trans},
    {action: 'create',   priv: 'shift:manage',   route: 'app_manage_shifts_planner', icon: 'plus',      color: 'text-green', title: 'shift_manager.action.create.title'|trans,   text: 'shift_manager.action.create.text'|trans},
    {action: 'grid',     priv: 'shift:manage',   route: 'app_department_grid',       icon: 'checklist', color: 'text-green', title: 'shift_manager.action.grid.title'|trans,     text: 'shift_manager.action.grid.text'|trans},
    {action: 'links',    priv: 'invite:manage',  route: 'app_request_links',         icon: 'mail',      color: 'text-green', title: 'shift_manager.action.links.title'|trans,    text: 'shift_manager.action.links.text'|trans}
  ] %}

  <div class="row row-cards">
    {% for c in actions %}
      {% if c.priv is null or is_granted(c.priv) %}
        <div class="col-sm-6 col-lg-4">
          {{ d.card_start(null, {class: 'card-link h-100', attrs: {'data-action': c.action}}) }}
              <div class="mb-2 {{ c.color }}">{{ i.icon(c.icon) }}</div>
              <h3 class="card-title mb-1">{{ c.title }}</h3>
              <p class="text-secondary">{{ c.text }}</p>
              <a href="{{ path(c.route) }}" class="stretched-link"></a>
          {{ d.card_end() }}
        </div>
      {% endif %}
    {% endfor %}
  </div>
{% endblock %}
