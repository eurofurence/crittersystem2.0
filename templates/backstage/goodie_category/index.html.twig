{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ 'backstage.goodie.category.title'|trans }}{% endblock %}

{% block body %}
  {{ d.page_header('backstage.goodie.category.title'|trans, {
    subtitle: 'backstage.goodie.category.subtitle'|trans,
    actions: [
      {label: 'backstage.action.back_to_backstage'|trans, href: path('app_backstage'), class: 'btn btn-outline-secondary'},
      {label: 'backstage.goodie.category.action.new'|trans, href: path('app_backstage_goodie_category_new'), class: 'btn btn-primary'}
    ]
  }) }}

  {% if categories is empty %}
    {{ d.empty_state('backstage.goodie.category.empty.title'|trans, {
      message: 'backstage.goodie.category.empty.message'|trans,
      actionLabel: 'backstage.goodie.category.action.new'|trans,
      actionHref: path('app_backstage_goodie_category_new')
    }) }}
  {% else %}
    {{ d.table_start() }}
      <thead><tr><th>{{ 'common.label.name'|trans }}</th><th>{{ 'backstage.goodie.table.order'|trans }}</th><th>{{ 'backstage.goodie.table.items'|trans }}</th><th>{{ 'common.label.status'|trans }}</th><th class="text-end">{{ 'common.label.actions'|trans }}</th></tr></thead>
      <tbody>
        {% for c in categories %}
          <tr class="{{ c.active ? '' : 'opacity-75' }}">
            <td>
              <div class="fw-semibold">{{ c.name }}</div>
              {% if c.description %}<div class="text-muted small">{{ c.description }}</div>{% endif %}
            </td>
            <td>{{ c.displayOrder }}</td>
            <td>{{ c.items|length }}</td>
            <td>{% if c.active %}{{ d.badge('common.state.active'|trans, 'text-bg-success') }}{% else %}{{ d.badge('common.state.inactive'|trans, 'text-bg-secondary') }}{% endif %}</td>
            {% set del %}
              {{ d.delete_form(path('app_backstage_goodie_category_delete', {id: c.uuid}), csrf_token('delete' ~ c.id), {
                message: 'backstage.goodie.category.confirm.delete'|trans({'%name%': c.name})
              }) }}
            {% endset %}
            {{ d.row_actions([
              {label: 'common.action.edit'|trans, href: path('app_backstage_goodie_category_edit', {id: c.uuid})}
            ], {extraHtml: del}) }}
          </tr>
        {% endfor %}
      </tbody>
    {{ d.table_end() }}
  {% endif %}
{% endblock %}
