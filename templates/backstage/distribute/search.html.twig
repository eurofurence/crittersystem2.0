{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}Distribute Goodies{% endblock %}

{% block body %}
  {{ d.page_header('Distribute Goodies', {
    subtitle: 'Find a volunteer to review their hours and hand out goodies.',
    actions: [{label: '← Backstage', href: path('app_backstage'), class: 'btn btn-outline-secondary'}]
  }) }}

  <form method="get" action="{{ path('app_backstage_distribute') }}" class="row g-2 mb-3">
    <div class="col-12 col-md-8">
      <input type="search" name="q" value="{{ q }}" class="form-control" placeholder="Search by name, email, or ID…" autofocus>
    </div>
    <div class="col-12 col-md-4"><button class="btn btn-primary w-100">Search</button></div>
  </form>

  {% if q != '' %}
    {% if results is empty %}
      {{ d.empty_state('No matches', {message: 'No volunteers match "' ~ q ~ '".'}) }}
    {% else %}
      {{ d.table_start() }}
        <thead><tr><th>Name</th><th>Email</th><th class="text-end"></th></tr></thead>
        <tbody>
          {% for u in results %}
            <tr>
              <td class="fw-semibold">{{ u.name }}</td>
              <td class="small">{{ u.email }}</td>
              <td class="text-end">
                <a class="btn btn-sm btn-primary" href="{{ path('app_backstage_distribute_user', {id: u.id}) }}">Open</a>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      {{ d.table_end() }}
    {% endif %}
  {% endif %}
{% endblock %}
