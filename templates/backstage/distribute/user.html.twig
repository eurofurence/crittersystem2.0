{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}
{% import 'components/icon/_macros.twig' as i %}
{% import 'components/goodies/_macros.twig' as g %}

{% block title %}{{ 'backstage.locate.user.title'|trans({'%name%': user.name}) }}{% endblock %}

{# The desk works three panels side by side - progress, hand-out, shifts - which needs more room
   than the app's usual reading width. #}
{% block container_class %}container-fluid{% endblock %}

{% block body %}
  <div data-controller="restore-view">
  {% set headerActions = [{label: 'backstage.locate.action.back_to_search'|trans, href: path('app_backstage_distribute'), class: 'btn btn-outline-secondary'}] %}
  {% if canViewProfile %}
    {% set headerActions = headerActions|merge([{label: 'backstage.locate.action.view_profile'|trans, href: path('app_profile_show', {id: user.uuid}), class: 'btn btn-outline-primary'}]) %}
  {% endif %}

  {# Email is a mining vector: only a fresh-stepped-up PII viewer sees the raw address. #}
  {{ d.page_header('backstage.locate.user.heading'|trans({'%name%': user.name}), {
    subtitle: can_see_pii() ? user.email : 'backstage.locate.volunteer'|trans,
    actions: headerActions
  }) }}

  {% set arrived = user.state and user.state.arrived %}
  {% set canViewGoodies = is_granted('goodie:view') %}
  {% set canGiveGoodies = is_granted('goodie:distribute') %}
  {% set canViewShifts = is_granted('shift:view') %}

  <div class="row row-deck row-cards mb-3">
    {% if canViewProfile %}
      {# The same facts /users/{uuid} opens with, so the desk does not have to leave this page for them.
         Check-in is deliberately absent: it belongs beside the button that changes it, in the next card. #}
      <div class="col-12 col-md-6 col-lg-4 col-xl-3">
        {{ d.card_start(null, {class: 'position-relative', bodyClass: ''}) }}
          {% if header.priorityBadge %}
            <span class="badge fs-3 bg-purple-lt position-absolute top-0 end-0 m-3">{{ header.priorityBadge.name }}</span>
          {% endif %}

          <div class="card-header">
            <h2 class="mb-0 me-6">{{ user|display_name }}</h2>
          </div>

          <div class="card-body">
            <div class="d-flex flex-column flex-md-row align-items-md-center gap-3">
              <div>{{ d.avatar(user, {size: 'xl'}) }}</div>
              <div class="flex-grow-1">
                {{ d.definition_list([
                  {label: 'common.label.status'|trans, value: header.status},
                  {label: 'profile.field.planned_arrival'|trans, value: header.plannedArrival ? header.plannedArrival|app_date : '-'},
                  {label: 'profile.field.next_shift'|trans, value: header.nextShiftAt ? header.nextShiftAt|app_datetime : '-'},
                  {label: 'profile.field.total_shifts'|trans, value: header.totalShifts}
                ]) }}
              </div>
            </div>
          </div>
        {{ d.card_end({bodyClass: ''}) }}
      </div>
    {% endif %}

    <div class="col-12 col-sm-5 col-lg-4 col-xl-3">
      {# The border answers the desk's first question from across the counter. #}
      {{ d.card_start(null, {class: 'border-2 ' ~ (arrived ? 'border-success' : 'border-danger'), bodyClass: ''}) }}
        <div class="card-body pb-2">
          <div class="d-flex justify-content-between align-items-baseline">
            <div class="text-muted">{{ 'backstage.locate.registration_number'|trans }}</div>
            <div class="fs-3">{{ user.personalData and user.personalData.badgeNumber ? user.personalData.badgeNumber : '-' }}</div>
          </div>
        </div>

        <div class="card-body py-2">
          <div class="text-muted small">{{ 'backstage.locate.checked_in'|trans }}</div>
          <div class="mb-2">
            {% if arrived %}
              {{ d.badge('common.state.yes'|trans ~ (user.state.arrivalDate ? ' · ' ~ user.state.arrivalDate|app_datetime : ''), 'bg-green-lt') }}
            {% else %}
              {{ d.badge('backstage.locate.not_yet'|trans, 'bg-secondary-lt') }}
            {% endif %}
          </div>
          {% if is_granted('user:arrive') %}
            <form method="post" action="{{ path('app_backstage_distribute_checkin', {id: user.uuid}) }}"
                  {% if arrived %}data-controller="confirm" data-confirm-message-value="{{ 'backstage.locate.confirm.remove_checkin'|trans({'%name%': user.name}) }}"{% endif %}>
              <input type="hidden" name="_token" value="{{ csrf_token('checkin' ~ user.id) }}">
              <input type="hidden" name="arrived" value="{{ arrived ? '0' : '1' }}">
              <button class="btn btn-sm w-100 {{ arrived ? 'btn-outline-danger' : 'btn-success' }}">{{ arrived ? 'backstage.locate.action.remove_checkin'|trans : 'backstage.locate.action.check_in'|trans }}</button>
            </form>
          {% endif %}
        </div>

        <div class="card-body pt-2">
          <div class="d-flex flex-wrap gap-2">
            {% if canDirectMessage %}
              <a class="btn btn-sm btn-primary" href="{{ path('app_messages_with', {id: user.uuid}) }}">
                {{ i.icon('message', {class: 'icon-1 me-1'}) }}{{ 'backstage.locate.action.message'|trans }}
              </a>
            {% endif %}
            <div class="dropdown">
              <button class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">{{ 'backstage.locate.contact_options'|trans }}</button>
              <div class="dropdown-menu dropdown-menu-end">
                {% for m in contactMethods %}
                  {% if m.type == 'message' %}
                    {% if canDirectMessage %}
                      <a class="dropdown-item" href="{{ path('app_messages_with', {id: user.uuid}) }}">{{ i.icon('message', {class: 'icon-1 me-1'}) }}{{ m.label }}</a>
                    {% endif %}
                  {% elseif m.href %}
                    <a class="dropdown-item" href="{{ m.href }}">{{ i.icon('mail', {class: 'icon-1 me-1'}) }}{{ m.label }}</a>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          </div>
        </div>
      {{ d.card_end({bodyClass: ''}) }}
    </div>

    <div class="col">
      {{ d.card_start() }}
        <div class="d-flex justify-content-between align-items-center mb-3">
          <div>
            <span class="fw-semibold">{{ 'backstage.locate.credited_hours'|trans }}</span>
            <span class="fs-2 ms-2">{{ cache.totalHours|round(2) }}</span>
          </div>
          {% if canGiveGoodies %}
            <form method="post" action="{{ path('app_backstage_distribute_refresh', {id: user.uuid}) }}">
              <input type="hidden" name="_token" value="{{ csrf_token('refresh' ~ user.id) }}">
              <button class="btn btn-sm btn-outline-secondary">{{ i.icon('refresh', {class: 'icon-1 me-1'}) }}{{ 'backstage.locate.action.recalculate'|trans }}</button>
            </form>
          {% endif %}
        </div>
        <div class="row text-center small text-muted">
          <div class="col border-end"><div class="fs-3 fw-bold text-body">{{ cache.dayShiftsHours|round(2) }}</div>{{ 'backstage.hours.day'|trans }}</div>
          <div class="col border-end"><div class="fs-3 fw-bold text-body">{{ cache.nightShiftsHours|round(2) }}</div>{{ 'backstage.hours.night'|trans }}</div>
          <div class="col border-end"><div class="fs-3 fw-bold text-body">{{ cache.noshowPenaltyHours|round(2) }}</div>{{ 'common.state.no_show'|trans }}</div>
          <div class="col border-end"><div class="fs-3 fw-bold text-body">{{ cache.worklogHours|round(2) }}</div>{{ 'backstage.hours.worklog'|trans }}</div>
          <div class="col"><div class="fs-3 fw-bold text-body">{{ cache.completedShiftsCount }}</div>{{ 'ui.nav.shifts'|trans }}</div>
        </div>
        <div class="text-muted small mt-3">{{ 'backstage.locate.last_calculated'|trans }} {{ cache.lastCalculatedAt|app_datetime }}</div>
      {{ d.card_end() }}
    </div>
  </div>

  {% set eligible = eligibility.rows|filter(r => r.tier == 'eligible') %}
  {% set pending = eligibility.rows|filter(r => r.tier == 'pending') %}
  {% set claimed = eligibility.rows|filter(r => r.tier == 'claimed') %}
  {% set blocked = eligibility.rows|filter(r => r.tier == 'blocked') %}

  {# Each panel takes the room the ones the viewer may not see would have used. #}
  <div class="row row-deck-forced row-cards">
    {% if canViewGoodies %}
      <div class="{{ canViewShifts ? 'col-12 col-lg-6 col-xl-3' : 'col-12 col-lg-5' }}">
        {{ d.card_start('backstage.locate.progress.title'|trans, {class: 'h-100', bodyClass: 'card-body reward'}) }}
          {% if timeline is empty %}
            {{ d.empty_inline('backstage.locate.empty.no_goodies'|trans) }}
          {% else %}
            <div class="deck-scroll">
              {{ g.reward_timeline(timeline, {
                showStatus: true,
                blockedNote: 'goodie.timeline.certification_required'|trans,
                labels: {
                  collected: 'goodie.timeline.status.collected'|trans,
                  available: 'goodie.timeline.status.available'|trans,
                  next: 'goodie.timeline.status.next'|trans,
                  locked: 'goodie.timeline.status.locked'|trans
                }
              }) }}
            </div>
          {% endif %}
        {{ d.card_end() }}
      </div>

      <div class="{{ canViewShifts ? 'col-12 col-lg-6 col-xl-4' : 'col-12 col-lg-7' }}">
        <div class="card h-100">
          <div class="card-header">
            <h3 class="card-title mb-0">{{ 'backstage.locate.distribution.title'|trans }}</h3>
          </div>
          <ul class="nav nav-tabs px-2 pt-2" role="tablist">
            <li class="nav-item" role="presentation">
              <a href="#goodie-pane-open" class="nav-link active" data-bs-toggle="tab" role="tab" aria-selected="true">
                {{ 'backstage.locate.tab.open'|trans }} <span class="badge bg-secondary-lt ms-1">{{ eligible|length }}</span>
              </a>
            </li>
            {% if canGiveGoodies %}
              <li class="nav-item" role="presentation">
                <a href="#goodie-pane-blocked" class="nav-link" data-bs-toggle="tab" role="tab" aria-selected="false" tabindex="-1">
                  {{ 'backstage.locate.tab.blocked'|trans }} <span class="badge bg-yellow-lt ms-1">{{ blocked|length }}</span>
                </a>
              </li>
            {% endif %}
            <li class="nav-item" role="presentation">
              <a href="#goodie-pane-pending" class="nav-link" data-bs-toggle="tab" role="tab" aria-selected="false" tabindex="-1">
                {{ 'backstage.locate.tab.pending'|trans }} <span class="badge bg-secondary-lt ms-1">{{ pending|length }}</span>
              </a>
            </li>
            <li class="nav-item" role="presentation">
              <a href="#goodie-pane-claimed" class="nav-link" data-bs-toggle="tab" role="tab" aria-selected="false" tabindex="-1">
                {{ 'backstage.locate.tab.claimed'|trans }} <span class="badge bg-secondary-lt ms-1">{{ claimed|length }}</span>
              </a>
            </li>
            <li class="nav-item" role="presentation">
              <a href="#goodie-pane-history" class="nav-link" data-bs-toggle="tab" role="tab" aria-selected="false" tabindex="-1">
                {{ 'backstage.locate.tab.history'|trans }} <span class="badge bg-secondary-lt ms-1">{{ history|length }}</span>
              </a>
            </li>
          </ul>

          <div class="tab-content">
            {# One form over the whole table: the row buttons post it with `only` set, so ticking
               several items and handing over a single one take the same path and the same rules. #}
            <div id="goodie-pane-open" class="tab-pane active show" role="tabpanel">
              {% if canGiveGoodies %}
                <div data-controller="bulk-select">
                <form method="post" action="{{ path('app_backstage_distribute_give_bulk', {id: user.uuid}) }}">
                  <input type="hidden" name="_token" value="{{ csrf_token('give-bulk' ~ user.id) }}">
              {% endif %}
              <div class="deck-scroll">
                {{ d.table_start({responsive: false, hover: false, class: 'table-vcenter card-table table-thead-sticky'}) }}
                  <thead>
                    <tr>
                      {% if canGiveGoodies %}
                        <th class="w-1">
                          <input type="checkbox" class="form-check-input m-0" data-bulk-select-target="all"
                                 data-action="change->bulk-select#toggleAll" aria-label="{{ 'backstage.locate.action.select_all'|trans }}">
                        </th>
                      {% endif %}
                      <th>{{ 'backstage.table.item'|trans }}</th>
                      <th class="w-1">{{ 'backstage.table.required'|trans }}</th>
                      <th class="w-1">{{ 'backstage.locate.table.left'|trans }}</th>
                      {% if canGiveGoodies %}<th class="w-1">{{ 'backstage.label.qty'|trans }}</th><th class="w-1"></th>{% endif %}
                    </tr>
                  </thead>
                  <tbody>
                    {% for r in eligible %}
                      <tr>
                        {% if canGiveGoodies %}
                          <td>
                            <input type="checkbox" class="form-check-input m-0" name="items[]" value="{{ r.item.uuid }}"
                                   data-bulk-select-target="item" data-action="change->bulk-select#refresh"
                                   aria-label="{{ 'backstage.locate.action.select_item'|trans({'%item%': r.item.name}) }}">
                          </td>
                        {% endif %}
                        <td>
                          {{ r.item.name }}
                          {% if r.item.description %}<div class="text-secondary small">{{ r.item.description }}</div>{% endif %}
                        </td>
                        <td>{{ d.badge(r.item.requiredHours|round(2) ~ ' h', 'bg-secondary-lt') }}</td>
                        <td class="text-secondary">{{ r.remaining is null ? '∞' : r.remaining }}</td>
                        {% if canGiveGoodies %}
                          <td>
                            <input type="number" name="quantities[{{ r.item.uuid }}]" value="1" min="1"
                                   {% if r.remaining is not null %}max="{{ r.remaining }}"{% endif %} style="width: 4.5rem"
                                   class="form-control form-control-sm" aria-label="{{ 'backstage.label.qty'|trans }}">
                          </td>
                          <td>
                            <button name="only" value="{{ r.item.uuid }}" class="btn btn-sm btn-primary text-nowrap">{{ 'backstage.locate.action.give'|trans }}</button>
                          </td>
                        {% endif %}
                      </tr>
                    {% else %}
                      {{ d.empty_row(canGiveGoodies ? 6 : 3, 'backstage.locate.empty.no_claimable'|trans) }}
                    {% endfor %}
                  </tbody>
                {{ d.table_end({responsive: false}) }}
              </div>
              {% if canGiveGoodies %}
                  <div class="card-footer d-flex flex-wrap gap-2 align-items-center">
                    <input type="text" name="notes" maxlength="255" class="form-control form-control-sm w-auto flex-grow-1"
                           placeholder="{{ 'backstage.locate.placeholder.shared_notes'|trans }}" aria-label="{{ 'backstage.locate.placeholder.shared_notes'|trans }}">
                    <button class="btn btn-sm btn-success text-nowrap" data-bulk-select-target="submit" disabled>
                      {{ i.icon('gift', {class: 'icon-1 me-1'}) }}{{ 'backstage.locate.action.give_selected'|trans }}
                      (<span data-bulk-select-target="count">0</span>)
                    </button>
                  </div>
                </form>
                </div>
              {% endif %}
            </div>

            {% if canGiveGoodies %}
              {# Handing over an item whose certification the volunteer does not hold is a deliberate,
                 audit-logged act, so it keeps its own pane and its own reason field rather than
                 sitting one click away in the routine hand-out table. #}
              <div id="goodie-pane-blocked" class="tab-pane" role="tabpanel">
                <div class="deck-scroll">
                  {% if blocked is empty %}
                    <div class="card-body">{{ d.empty_inline('backstage.locate.empty.nothing_blocked'|trans) }}</div>
                  {% else %}
                    <div class="list-group list-group-flush">
                      {% for r in blocked %}
                        <div class="list-group-item">
                          <div class="d-flex justify-content-between align-items-baseline">
                            <div class="fw-semibold">{{ r.item.name }}</div>
                            {{ d.badge(r.item.requiredHours|round(2) ~ ' h', 'bg-secondary-lt') }}
                          </div>
                          <div class="small my-1">
                            {{ 'backstage.locate.missing_certifications'|trans }}
                            {% for certification in r.missingCertifications %}
                              {{ d.badge(certification.title, 'text-bg-warning', {class: 'me-1'}) }}
                            {% endfor %}
                          </div>
                          <form method="post" action="{{ path('app_backstage_distribute_give', {id: user.uuid}) }}" class="row g-2 align-items-end"
                                data-controller="confirm"
                                data-confirm-message-value="{{ 'backstage.locate.confirm.override'|trans({'%name%': r.item.name}) }}"
                                data-confirm-variant-value="warning">
                            <input type="hidden" name="_token" value="{{ csrf_token('give' ~ user.id) }}">
                            <input type="hidden" name="item" value="{{ r.item.uuid }}">
                            <div class="col-4">
                              <label class="form-label small mb-0" for="blocked-qty-{{ r.item.uuid }}">{{ 'backstage.label.qty'|trans }}</label>
                              <input type="number" id="blocked-qty-{{ r.item.uuid }}" name="quantity" value="1" min="1" class="form-control form-control-sm">
                            </div>
                            <div class="col-8">
                              <label class="form-label small mb-0" for="override-{{ r.item.uuid }}">{{ 'backstage.locate.label.override_reason'|trans }}</label>
                              <input type="text" id="override-{{ r.item.uuid }}" name="override_reason" maxlength="255" required
                                     class="form-control form-control-sm" placeholder="{{ 'backstage.locate.placeholder.override_reason'|trans }}">
                            </div>
                            <div class="col-12">
                              <button class="btn btn-sm btn-outline-warning w-100">{{ 'backstage.locate.action.give_anyway'|trans }}</button>
                            </div>
                          </form>
                        </div>
                      {% endfor %}
                    </div>
                  {% endif %}
                </div>
              </div>
            {% endif %}

            <div id="goodie-pane-pending" class="tab-pane" role="tabpanel">
              <div class="deck-scroll">
                {{ d.table_start({responsive: false, hover: false, class: 'table-vcenter card-table table-thead-sticky'}) }}
                  <thead><tr><th>{{ 'backstage.table.item'|trans }}</th><th class="w-1">{{ 'backstage.table.required'|trans }}</th><th class="w-1">{{ 'backstage.table.hours_short'|trans }}</th></tr></thead>
                  <tbody>
                    {% for r in pending %}
                      <tr>
                        <td>{{ r.item.name }}</td>
                        <td>{{ r.item.requiredHours|round(2) }} h</td>
                        <td>{{ d.badge(r.gap|round(2) ~ ' h', 'text-bg-warning') }}</td>
                      </tr>
                    {% else %}
                      {{ d.empty_row(3, 'backstage.locate.empty.nothing_pending'|trans) }}
                    {% endfor %}
                  </tbody>
                {{ d.table_end({responsive: false}) }}
              </div>
            </div>

            <div id="goodie-pane-claimed" class="tab-pane" role="tabpanel">
              <div class="deck-scroll">
                {{ d.table_start({responsive: false, hover: false, class: 'table-vcenter card-table table-thead-sticky'}) }}
                  <thead><tr><th>{{ 'backstage.table.item'|trans }}</th><th class="w-1">{{ 'backstage.table.claimed'|trans }}</th></tr></thead>
                  <tbody>
                    {% for r in claimed %}
                      <tr><td>{{ r.item.name }}</td><td>{{ r.claimed }}</td></tr>
                    {% else %}
                      {{ d.empty_row(2, 'backstage.locate.empty.nothing_claimed'|trans) }}
                    {% endfor %}
                  </tbody>
                {{ d.table_end({responsive: false}) }}
              </div>
            </div>

            {# A revoked handover keeps its row: it stops counting everywhere else, and the desk has
               to be able to see that the correction happened. The quantity fields belong to the
               separate correction form through their `form` attribute, so saving a number does not
               submit the revoke the surrounding form carries. #}
            <div id="goodie-pane-history" class="tab-pane" role="tabpanel">
              {% if canGiveGoodies %}
                {% set correctFormId = 'goodie-correct-form' %}
                <div data-controller="bulk-select">
                <form method="post" action="{{ path('app_backstage_distribute_revoke', {id: user.uuid}) }}"
                      data-controller="confirm"
                      data-confirm-message-value="{{ 'backstage.locate.confirm.revoke'|trans }}"
                      data-confirm-title-value="{{ 'backstage.locate.action.revoke'|trans }}"
                      data-confirm-confirm-label-value="{{ 'backstage.locate.action.revoke'|trans }}">
                  <input type="hidden" name="_token" value="{{ csrf_token('revoke' ~ user.id) }}">
              {% endif %}
              <div class="deck-scroll">
                {{ d.table_start({responsive: false, hover: false, class: 'table-vcenter card-table table-thead-sticky'}) }}
                  <thead>
                    <tr>
                      {% if canGiveGoodies %}
                        <th class="w-1">
                          <input type="checkbox" class="form-check-input m-0" data-bulk-select-target="all"
                                 data-action="change->bulk-select#toggleAll" aria-label="{{ 'backstage.locate.action.select_all'|trans }}">
                        </th>
                      {% endif %}
                      <th>{{ 'common.label.when'|trans }}</th>
                      <th>{{ 'backstage.table.item'|trans }}</th>
                      <th class="w-1">{{ 'backstage.label.qty'|trans }}</th>
                      <th>{{ 'backstage.table.by'|trans }}</th>
                      {% if canGiveGoodies %}<th class="w-1"></th>{% endif %}
                    </tr>
                  </thead>
                  <tbody>
                    {% for dist in history %}
                      {% set revoked = dist.revoked %}
                      <tr class="{{ revoked ? 'opacity-75' : '' }}">
                        {% if canGiveGoodies %}
                          <td>
                            {% if not revoked %}
                              <input type="checkbox" class="form-check-input m-0" name="distributions[]" value="{{ dist.uuid }}"
                                     data-bulk-select-target="item" data-action="change->bulk-select#refresh"
                                     aria-label="{{ 'backstage.locate.action.select_item'|trans({'%item%': dist.itemName}) }}">
                            {% endif %}
                          </td>
                        {% endif %}
                        <td class="small">{{ dist.distributedAt|app_datetime }}</td>
                        <td>
                          <span class="{{ revoked ? 'text-decoration-line-through text-muted' : '' }}">{{ dist.itemName }}</span>
                          <div class="text-secondary small">{{ 'backstage.table.hours_then'|trans }}: {{ dist.hoursAtDistribution|round(2) }}</div>
                          {% if revoked %}
                            <div class="small mt-1">
                              {{ d.badge('backstage.locate.state.revoked'|trans, 'bg-red-lt') }}
                              <span class="text-muted">{{ dist.revokedAt|app_datetime }}{% if dist.revokedBy %} · {{ dist.revokedBy.name }}{% endif %}</span>
                              {% if dist.revokeReason %}<div class="text-muted">{{ dist.revokeReason }}</div>{% endif %}
                            </div>
                          {% elseif dist.quantityCorrected %}
                            <div class="small text-muted mt-1">
                              {{ 'backstage.locate.corrected_from'|trans({'%count%': dist.originalQuantity}) }}
                              {% if dist.correctedBy %} · {{ dist.correctedBy.name }}{% endif %}
                              {% if dist.correctionReason %}<div>{{ dist.correctionReason }}</div>{% endif %}
                            </div>
                          {% endif %}
                        </td>
                        <td>
                          {% if canGiveGoodies and not revoked %}
                            <div class="d-flex gap-1 flex-nowrap">
                              <input type="number" form="{{ correctFormId }}" name="quantities[{{ dist.uuid }}]"
                                     value="{{ dist.quantity }}" min="1" style="width: 4.5rem" class="form-control form-control-sm"
                                     aria-label="{{ 'backstage.label.qty'|trans }}">
                              <button form="{{ correctFormId }}" name="distribution" value="{{ dist.uuid }}"
                                      class="btn btn-sm btn-outline-secondary" title="{{ 'backstage.locate.action.save_quantity'|trans }}">
                                {{ i.icon('check', {class: 'icon-1'}) }}
                              </button>
                            </div>
                          {% else %}
                            {{ dist.quantity }}
                          {% endif %}
                        </td>
                        <td class="small text-muted">{{ dist.distributedBy ? dist.distributedBy.name : '-' }}</td>
                        {% if canGiveGoodies %}
                          <td>
                            {% if not revoked %}
                              <button name="distribution" value="{{ dist.uuid }}" class="btn btn-sm btn-outline-danger text-nowrap">
                                {{ 'backstage.locate.action.revoke'|trans }}
                              </button>
                            {% endif %}
                          </td>
                        {% endif %}
                      </tr>
                    {% else %}
                      {{ d.empty_row(canGiveGoodies ? 6 : 4, 'backstage.locate.empty.no_history'|trans) }}
                    {% endfor %}
                  </tbody>
                {{ d.table_end({responsive: false}) }}
              </div>
              {% if canGiveGoodies %}
                  <div class="card-footer d-flex flex-wrap gap-2 align-items-center">
                    <input type="text" name="reason" maxlength="255" class="form-control form-control-sm w-auto flex-grow-1"
                           placeholder="{{ 'backstage.locate.placeholder.revoke_reason'|trans }}" aria-label="{{ 'backstage.locate.placeholder.revoke_reason'|trans }}">
                    <button class="btn btn-sm btn-outline-danger text-nowrap" data-bulk-select-target="submit" disabled>
                      {{ 'backstage.locate.action.revoke_selected'|trans }}
                      (<span data-bulk-select-target="count">0</span>)
                    </button>
                  </div>
                </form>
                <form method="post" id="{{ correctFormId }}" action="{{ path('app_backstage_distribute_correct', {id: user.uuid}) }}">
                  <input type="hidden" name="_token" value="{{ csrf_token('revoke' ~ user.id) }}">
                </form>
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    {% endif %}

    {% if canViewShifts %}
      <div class="{{ canViewGoodies ? 'col-12 col-xl-5' : 'col-12' }}">
        {{ d.card_start('backstage.locate.shifts.title'|trans, {class: 'h-100', bodyClass: ''}) }}
          <div class="deck-scroll">
            {{ d.table_start({responsive: false, hover: false, class: 'table-vcenter card-table table-thead-sticky'}) }}
              <thead><tr><th>{{ 'common.label.when'|trans }}</th><th>{{ 'backstage.table.shift'|trans }}</th><th>{{ 'common.label.location'|trans }}</th><th class="w-1">{{ 'common.label.status'|trans }}</th></tr></thead>
              <tbody>
                {% for entry in shifts %}
                  {% set shift = entry.shift %}
                  <tr>
                    <td class="small text-nowrap">{{ shift.startsAt|app_date }} · {{ shift.startsAt|app_time }}–{{ shift.endsAt|app_time }}</td>
                    <td>
                      {# Stays a working link without JavaScript: the shift page renders the same dossier. #}
                      <a href="{{ path('app_shift_show', {id: shift.uuid}) }}"
                         data-controller="shift-dossier"
                         data-action="shift-dossier#open"
                         data-shift-dossier-url-value="{{ path('app_shift_info', {id: shift.uuid}) }}"
                         data-shift-dossier-title-value="{{ shift.title }}"
                         data-shift-dossier-close-label-value="{{ 'common.action.close'|trans }}">{{ shift.title }}</a>
                      {% if shift.distinctTaskName %}<div class="text-secondary small">{{ shift.distinctTaskName }}</div>{% endif %}
                      <div class="text-secondary small">
                        {% if shift.department %}{{ shift.department.name }}{% endif %}
                        {% if shift.description is null %}{{ d.badge('shift.list.no_description'|trans, 'bg-yellow-lt', {class: 'ms-1'}) }}{% endif %}
                      </div>
                    </td>
                    <td class="small text-muted">{{ shift.location ? shift.location.fullName : '-' }}</td>
                    <td>
                      {% if entry.noshow %}{{ d.badge('common.state.no_show'|trans, 'bg-red-lt') }}
                      {% else %}{{ d.badge(entry.assignment ? 'backstage.state.assigned'|trans : 'backstage.state.applied'|trans, entry.assignment ? 'bg-green-lt' : 'bg-secondary-lt') }}{% endif %}
                    </td>
                  </tr>
                {% else %}
                  {{ d.empty_row(4, 'backstage.locate.empty.no_shifts'|trans) }}
                {% endfor %}
              </tbody>
            {{ d.table_end({responsive: false}) }}
          </div>
        {{ d.card_end({bodyClass: ''}) }}
      </div>
    {% endif %}
  </div>
  </div>
{% endblock %}
