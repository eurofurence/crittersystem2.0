{% extends 'base.html.twig' %}
{% import 'components/forms/_macros.twig' as f %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ heading }}{% endblock %}

{% block body %}
  {{ d.page_header(heading, {
    actions: [{label: '← Back to items', href: path('app_backstage_goodie_item_index'), class: 'btn btn-outline-secondary'}]
  }) }}

  {{ form_start(form) }}
    <div class="row">
      {{ f.field(form.name, {col: 'col-12 col-md-8'}) }}
      {{ f.choice(form.category, {col: 'col-12 col-md-4'}) }}
      {{ f.field(form.requiredHours, {col: 'col-6 col-md-3'}) }}
      {{ f.field(form.maxPerPerson, {col: 'col-6 col-md-3', help: 'Blank = unlimited'}) }}
      {{ f.field(form.displayOrder, {col: 'col-6 col-md-3'}) }}
      {{ f.field(form.description, {col: 'col-12'}) }}
      {{ f.check(form.isActive, {col: 'col-12'}) }}
    </div>
    <button class="btn btn-primary mt-2">Save</button>
  {{ form_end(form) }}
{% endblock %}
