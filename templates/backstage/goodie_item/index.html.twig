{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}Goodie Items{% endblock %}

{% block body %}
  {{ d.page_header('Goodie Items', {
    subtitle: 'Rewards volunteers can claim once they reach the required hours.',
    actions: [
      {label: '← Backstage', href: path('app_backstage'), class: 'btn btn-outline-secondary'},
      {label: '+ New item', href: path('app_backstage_goodie_item_new'), class: 'btn btn-primary'}
    ]
  }) }}

  {% if items is empty %}
    {{ d.empty_state('No items yet', {
      message: 'Add goodie items for volunteers to earn.',
      actionLabel: '+ New item',
      actionHref: path('app_backstage_goodie_item_new')
    }) }}
  {% else %}
    {{ d.table_start() }}
      <thead><tr><th>Item</th><th>Category</th><th>Required hours</th><th>Max / person</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
      <tbody>
        {% for i in items %}
          <tr class="{{ i.active ? '' : 'opacity-75' }}">
            <td>
              <div class="fw-semibold">{{ i.name }}</div>
              {% if i.description %}<div class="text-muted small">{{ i.description }}</div>{% endif %}
            </td>
            <td>{{ i.category.name }}</td>
            <td>{{ i.requiredHours|round(2) }}</td>
            <td>{{ i.maxPerPerson ?? '∞' }}</td>
            <td>{% if i.active %}{{ d.badge('Active', 'text-bg-success') }}{% else %}{{ d.badge('Inactive', 'text-bg-secondary') }}{% endif %}</td>
            {% set del %}
              {{ d.delete_form(path('app_backstage_goodie_item_delete', {id: i.uuid}), csrf_token('delete' ~ i.id), {
                message: 'Delete "' ~ i.name ~ '"?'
              }) }}
            {% endset %}
            {{ d.row_actions([
              {label: 'Edit', href: path('app_backstage_goodie_item_edit', {id: i.uuid})}
            ], {extraHtml: del}) }}
          </tr>
        {% endfor %}
      </tbody>
    {{ d.table_end() }}
  {% endif %}
{% endblock %}
