{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ 'backstage.goodie.item.title'|trans }}{% endblock %}

{% block body %}
  {{ d.page_header('backstage.goodie.item.title'|trans, {
    subtitle: 'backstage.goodie.item.subtitle'|trans,
    actions: [
      {label: 'backstage.action.back_to_backstage'|trans, href: path('app_backstage'), class: 'btn btn-outline-secondary'},
      {label: 'backstage.goodie.item.action.new'|trans, href: path('app_backstage_goodie_item_new'), class: 'btn btn-primary'}
    ]
  }) }}

  {% if items is empty %}
    {{ d.empty_state('backstage.goodie.item.empty.title'|trans, {
      message: 'backstage.goodie.item.empty.message'|trans,
      actionLabel: 'backstage.goodie.item.action.new'|trans,
      actionHref: path('app_backstage_goodie_item_new')
    }) }}
  {% else %}
    {{ d.table_start() }}
      <thead><tr><th>{{ 'backstage.table.item'|trans }}</th><th>{{ 'backstage.goodie.label.category'|trans }}</th><th>{{ 'backstage.goodie.label.required_hours'|trans }}</th><th>{{ 'backstage.goodie.table.max_per_person'|trans }}</th><th>{{ 'common.label.status'|trans }}</th><th class="text-end">{{ 'common.label.actions'|trans }}</th></tr></thead>
      <tbody>
        {% for i in items %}
          <tr class="{{ i.active ? '' : 'opacity-75' }}">
            <td>
              <div class="fw-semibold">{{ i.name }}</div>
              {% if i.description %}<div class="text-muted small">{{ i.description }}</div>{% endif %}
              {% for certification in i.certifications %}
                {{ d.badge(certification.title, certification.active ? 'bg-purple-lt' : 'bg-secondary-lt', {class: 'me-1 mt-1'}) }}
              {% endfor %}
            </td>
            <td>{{ i.category.name }}</td>
            <td>{{ i.requiredHours|round(2) }}</td>
            <td>{{ i.maxPerPerson ?? '∞' }}</td>
            <td>{% if i.active %}{{ d.badge('common.state.active'|trans, 'text-bg-success') }}{% else %}{{ d.badge('common.state.inactive'|trans, 'text-bg-secondary') }}{% endif %}</td>
            {% set del %}
              {{ d.delete_form(path('app_backstage_goodie_item_delete', {id: i.uuid}), csrf_token('delete' ~ i.id), {
                message: 'backstage.goodie.item.confirm.delete'|trans({'%name%': i.name})
              }) }}
            {% endset %}
            {{ d.row_actions([
              {label: 'common.action.edit'|trans, href: path('app_backstage_goodie_item_edit', {id: i.uuid})}
            ], {extraHtml: del}) }}
          </tr>
        {% endfor %}
      </tbody>
    {{ d.table_end() }}
  {% endif %}
{% endblock %}
