{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}Backstage{% endblock %}

{% block body %}
  {{ d.page_header('Backstage', {subtitle: 'Goodies distribution and rewards.'}) }}

  <div class="row g-3 mb-3">
    {{ d.stat_card(distributedToday, 'Distributed today', {col: 'col-6 col-md-3', size: 'fs-3'}) }}
    {{ d.stat_card(distributedThisWeek, 'This week', {col: 'col-6 col-md-3', size: 'fs-3'}) }}
  </div>

  {# Each card is gated by the privilege that guards its controller. #}
  {% set cards = [
    {priv: 'user:locate', route: 'app_backstage_distribute',            icon: '🔎', title: 'Locate User', text: 'Find a volunteer by email, registration number or badge scan.'},
    {priv: 'goodie:manage', route: 'app_backstage_goodie_category_index', icon: '🗂️', title: 'Goodie Categories', text: 'Manage categories.'},
    {priv: 'goodie:manage', route: 'app_backstage_goodie_item_index',     icon: '🎽', title: 'Goodie Items',      text: 'Manage items and thresholds.'}
  ] %}
  <div class="row g-3 mb-4">
    {% for c in cards %}
      {% if is_granted(c.priv) %}
        {% set cardIcon %}<span class="fs-3" aria-hidden="true">{{ c.icon }}</span>{% endset %}
        {{ d.action_card(c.title, {
          text: c.text,
          href: path(c.route),
          iconHtml: cardIcon,
          col: 'col-12 col-md-6 col-lg-4',
          class: 'shadow-sm'
        }) }}
      {% endif %}
    {% endfor %}
  </div>

  <h2 class="h5">Recent distributions</h2>
  {% if recent is empty %}
    {{ d.empty_inline('No distributions yet.', {class: 'text-muted'}) }}
  {% else %}
    {{ d.table_start({hover: false}) }}
      <thead><tr><th>When</th><th>Volunteer</th><th>Item</th><th>Qty</th><th>By</th></tr></thead>
      <tbody>
        {% for dist in recent %}
          <tr>
            <td class="small">{{ dist.distributedAt|app_datetime }}</td>
            <td>{{ dist.user.name }}</td>
            <td>{{ dist.itemName }}</td>
            <td>{{ dist.quantity }}</td>
            <td class="small text-muted">{{ dist.distributedBy ? dist.distributedBy.name : '—' }}</td>
          </tr>
        {% endfor %}
      </tbody>
    {{ d.table_end() }}
  {% endif %}
{% endblock %}
