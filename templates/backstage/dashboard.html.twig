{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ 'ui.nav.backstage'|trans }}{% endblock %}

{% block body %}
  {{ d.page_header('ui.nav.backstage'|trans, {subtitle: 'backstage.page.subtitle'|trans}) }}

  <div class="row g-3 mb-3">
    {{ d.stat_card(distributedToday, 'backstage.stat.distributed_today'|trans, {col: 'col-6 col-md-3', size: 'fs-3'}) }}
    {{ d.stat_card(distributedThisWeek, 'backstage.stat.this_week'|trans, {col: 'col-6 col-md-3', size: 'fs-3'}) }}
  </div>

  {# Each card is gated by the privilege that guards its controller. #}
  {% set cards = [
    {priv: 'user:locate', route: 'app_backstage_distribute',            icon: '🔎', title: 'backstage.card.locate_user.title'|trans, text: 'backstage.card.locate_user.text'|trans},
    {priv: 'security:checkin', route: 'app_backstage_security',         icon: '🚪', title: 'backstage.card.security.title'|trans, text: 'backstage.card.security.text'|trans},
    {priv: 'goodie:manage', route: 'app_backstage_goodie_category_index', icon: '🗂️', title: 'backstage.goodie.category.title'|trans, text: 'backstage.card.goodie_categories.text'|trans},
    {priv: 'goodie:manage', route: 'app_backstage_goodie_item_index',     icon: '🎽', title: 'backstage.goodie.item.title'|trans,      text: 'backstage.card.goodie_items.text'|trans}
  ] %}
  <div class="row g-3 mb-4">
    {% for c in cards %}
      {% if is_granted(c.priv) %}
        {% set cardIcon %}<span class="fs-3" aria-hidden="true">{{ c.icon }}</span>{% endset %}
        {{ d.action_card(c.title, {
          text: c.text,
          href: path(c.route),
          iconHtml: cardIcon,
          col: 'col-12 col-md-6 col-lg-4',
          class: 'shadow-sm'
        }) }}
      {% endif %}
    {% endfor %}
  </div>

  <h2 class="h5">{{ 'backstage.section.recent'|trans }}</h2>
  {% if recent is empty %}
    {{ d.empty_inline('backstage.empty.no_distributions'|trans, {class: 'text-muted'}) }}
  {% else %}
    {{ d.table_start({hover: false}) }}
      <thead><tr><th>{{ 'common.label.when'|trans }}</th><th>{{ 'backstage.table.volunteer'|trans }}</th><th>{{ 'backstage.table.item'|trans }}</th><th>{{ 'backstage.label.qty'|trans }}</th><th>{{ 'backstage.table.by'|trans }}</th></tr></thead>
      <tbody>
        {% for dist in recent %}
          <tr>
            <td class="small">{{ dist.distributedAt|app_datetime }}</td>
            <td>{{ dist.user.name }}</td>
            <td>{{ dist.itemName }}</td>
            <td>{{ dist.quantity }}</td>
            <td class="small text-muted">{{ dist.distributedBy ? dist.distributedBy.name : '-' }}</td>
          </tr>
        {% endfor %}
      </tbody>
    {{ d.table_end() }}
  {% endif %}
{% endblock %}
