{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ 'ui.nav.messages'|trans }}{% endblock %}

{% block body %}
  {{ d.page_header('ui.nav.messages'|trans, {subtitle: 'message.index.subtitle'|trans}) }}

  <div class="row g-3">
    <div class="col-12 col-lg-4">
      {{ d.card_start(null, {bodyClass: ''}) }}
        <div class="list-group list-group-flush">
          <a href="{{ path('app_messages_conversation', {id: support.uuid}) }}"
             class="list-group-item list-group-item-action d-flex align-items-center">
            <span class="avatar avatar-sm bg-blue-lt me-2">ID</span>
            <span class="fw-bold">{{ 'message.index.info_desk_team'|trans }}</span>
          </a>
          {% for row in mine %}
            {% set c = row.conversation %}
            {% if c.type.value != 'support' or c.subject.id != app.user.id %}
              <a href="{{ path('app_messages_conversation', {id: c.uuid}) }}"
                 class="list-group-item list-group-item-action d-flex align-items-center justify-content-between">
                <span>
                  {% if c.type.value == 'support' %}{{ 'message.index.support_prefix'|trans({'%name%': c.subject ? c.subject.name : '-'}) }}
                  {% else %}
                    {{ c.participants|filter(p => p.user.id != app.user.id)|map(p => p.user.name)|join(', ') }}
                  {% endif %}
                </span>
                {% if row.unread > 0 %}{{ d.badge(row.unread, 'bg-red') }}{% endif %}
              </a>
            {% endif %}
          {% endfor %}
        </div>
      {{ d.card_end({bodyClass: ''}) }}
    </div>

    {% if canClaim %}
      {# The queue changes because of what other people do: someone new writes in, another responder
         claims a conversation, one is closed. Without a live region a responder only learns of a
         waiting conversation by reloading, which for the Info Desk is the whole job.

         Every claim holder receives the queue topic, so the region re-fetches this fragment and the
         server renders it for whoever asked - "claimed by you" is per-viewer and must not be pushed
         as rendered markup. #}
      <div class="col-12 col-lg-8"
           data-controller="live-stream"
           data-live-stream-topic-value="{{ mercure_topic('info_desk_queue') }}"
           data-live-stream-url-value="{{ path('app_messages_queue_frame') }}">
        {% include 'message/_queue.html.twig' with {waiting: waiting, claimed: claimed} only %}
      </div>
    {% endif %}
  </div>
{% endblock %}
