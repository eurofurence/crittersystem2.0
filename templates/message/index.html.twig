{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}Messages{% endblock %}

{% block body %}
  {{ d.page_header('Messages', {subtitle: 'Chat with the Info Desk and your contacts.'}) }}

  <div class="row g-3">
    <div class="col-12 col-lg-4">
      {{ d.card_start(null, {bodyClass: ''}) }}
        <div class="list-group list-group-flush">
          <a href="{{ path('app_messages_conversation', {id: support.uuid}) }}"
             class="list-group-item list-group-item-action d-flex align-items-center">
            <span class="avatar avatar-sm bg-blue-lt me-2">ID</span>
            <span class="fw-bold">Info Desk Team</span>
          </a>
          {% for row in mine %}
            {% set c = row.conversation %}
            {% if c.type.value != 'support' or c.subject.id != app.user.id %}
              <a href="{{ path('app_messages_conversation', {id: c.uuid}) }}"
                 class="list-group-item list-group-item-action d-flex align-items-center justify-content-between">
                <span>
                  {% if c.type.value == 'support' %}Support: {{ c.subject ? c.subject.name : '—' }}
                  {% else %}
                    {{ c.participants|filter(p => p.user.id != app.user.id)|map(p => p.user.name)|join(', ') }}
                  {% endif %}
                </span>
                {% if row.unread > 0 %}{{ d.badge(row.unread, 'bg-red') }}{% endif %}
              </a>
            {% endif %}
          {% endfor %}
        </div>
      {{ d.card_end({bodyClass: ''}) }}
    </div>

    {% if canClaim %}
      <div class="col-12 col-lg-8">
        {{ d.card_start('Waiting (' ~ waiting|length ~ ')', {bodyClass: ''}) }}
          <div class="list-group list-group-flush">
            {% for c in waiting %}
              <a href="{{ path('app_messages_conversation', {id: c.uuid}) }}" class="list-group-item list-group-item-action">
                {{ c.subject ? c.subject.name : 'Unknown' }}
                <span class="text-secondary small">· {{ c.updatedAt|app_datetime }}</span>
              </a>
            {% else %}
              {{ d.empty_inline('No conversations waiting.', {tag: 'div', class: 'list-group-item text-secondary'}) }}
            {% endfor %}
          </div>
        {{ d.card_end({bodyClass: ''}) }}
        {{ d.card_start('Claimed by you (' ~ claimed|length ~ ')', {class: '', bodyClass: ''}) }}
          <div class="list-group list-group-flush">
            {% for c in claimed %}
              <a href="{{ path('app_messages_conversation', {id: c.uuid}) }}" class="list-group-item list-group-item-action">
                {{ c.subject ? c.subject.name : 'Unknown' }} {{ d.badge('claimed', 'bg-green-lt') }}
              </a>
            {% else %}
              {{ d.empty_inline('You have no claimed conversations.', {tag: 'div', class: 'list-group-item text-secondary'}) }}
            {% endfor %}
          </div>
        {{ d.card_end({bodyClass: ''}) }}
      </div>
    {% endif %}
  </div>
{% endblock %}
