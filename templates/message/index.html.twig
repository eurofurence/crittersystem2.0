{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}Messages{% endblock %}

{% block body %}
  {{ d.page_header('Messages', {subtitle: 'Your private conversations.'}) }}

  <form method="get" action="{{ path('app_messages_index') }}" class="row g-2 mb-3">
    <div class="col-12 col-md-8">
      <input type="search" name="q" value="{{ q }}" class="form-control" placeholder="Start a conversation — search by name, email, or ID…">
    </div>
    <div class="col-12 col-md-4"><button class="btn btn-outline-primary w-100">Search</button></div>
  </form>

  {% if q != '' %}
    {% if searchResults is empty %}
      <p class="text-muted">No users match "{{ q }}".</p>
    {% else %}
      <div class="list-group mb-3">
        {% for u in searchResults %}
          <a class="list-group-item list-group-item-action d-flex justify-content-between" href="{{ path('app_messages_conversation', {id: u.id}) }}">
            <span>{{ u.name }}</span><span class="text-muted small">{{ u.email }}</span>
          </a>
        {% endfor %}
      </div>
    {% endif %}
  {% endif %}

  {% if conversations is empty %}
    {{ d.empty_state('No messages yet', {message: 'Search for someone above to start a conversation.'}) }}
  {% else %}
    <div class="list-group">
      {% for c in conversations %}
        <a class="list-group-item list-group-item-action" href="{{ path('app_messages_conversation', {id: c.user.id}) }}">
          <div class="d-flex justify-content-between">
            <span class="fw-semibold">{{ c.user.name }}
              {% if c.unread > 0 %}{{ d.badge(c.unread ~ ' new', 'text-bg-danger') }}{% endif %}
            </span>
            <span class="text-muted small">{{ c.last.createdAt|app_datetime }}</span>
          </div>
          <div class="text-muted small text-truncate">
            {{ c.last.sender.id == app.user.id ? 'You: ' }}{{ c.last.text }}
          </div>
        </a>
      {% endfor %}
    </div>
  {% endif %}
{% endblock %}
