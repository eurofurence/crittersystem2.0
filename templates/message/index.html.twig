{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ 'ui.nav.messages'|trans }}{% endblock %}

{% block body %}
  {{ d.page_header('ui.nav.messages'|trans, {subtitle: 'message.index.subtitle'|trans}) }}

  <div class="row g-3">
    <div class="col-12 col-lg-4">
      {{ d.card_start(null, {bodyClass: ''}) }}
        <div class="list-group list-group-flush">
          <a href="{{ path('app_messages_conversation', {id: support.uuid}) }}"
             class="list-group-item list-group-item-action d-flex align-items-center">
            <span class="avatar avatar-sm bg-blue-lt me-2">ID</span>
            <span class="fw-bold">{{ 'message.index.info_desk_team'|trans }}</span>
          </a>
          {% for row in mine %}
            {% set c = row.conversation %}
            {% if c.type.value != 'support' or c.subject.id != app.user.id %}
              <a href="{{ path('app_messages_conversation', {id: c.uuid}) }}"
                 class="list-group-item list-group-item-action d-flex align-items-center justify-content-between">
                <span>
                  {% if c.type.value == 'support' %}{{ 'message.index.support_prefix'|trans({'%name%': c.subject ? c.subject.name : '-'}) }}
                  {% else %}
                    {{ c.participants|filter(p => p.user.id != app.user.id)|map(p => p.user.name)|join(', ') }}
                  {% endif %}
                </span>
                {% if row.unread > 0 %}{{ d.badge(row.unread, 'bg-red') }}{% endif %}
              </a>
            {% endif %}
          {% endfor %}
        </div>
      {{ d.card_end({bodyClass: ''}) }}
    </div>

    {% if canClaim %}
      <div class="col-12 col-lg-8">
        {{ d.card_start('message.index.waiting'|trans({'%count%': waiting|length}), {bodyClass: ''}) }}
          <div class="list-group list-group-flush">
            {% for c in waiting %}
              <a href="{{ path('app_messages_conversation', {id: c.uuid}) }}" class="list-group-item list-group-item-action">
                {{ c.subject ? c.subject.name : 'message.index.unknown'|trans }}
                <span class="text-secondary small">· {{ c.updatedAt|app_datetime }}</span>
              </a>
            {% else %}
              {{ d.empty_inline('message.index.empty.waiting'|trans, {tag: 'div', class: 'list-group-item text-secondary'}) }}
            {% endfor %}
          </div>
        {{ d.card_end({bodyClass: ''}) }}
        {{ d.card_start('message.index.claimed_by_you'|trans({'%count%': claimed|length}), {class: '', bodyClass: ''}) }}
          <div class="list-group list-group-flush">
            {% for c in claimed %}
              <a href="{{ path('app_messages_conversation', {id: c.uuid}) }}" class="list-group-item list-group-item-action">
                {{ c.subject ? c.subject.name : 'message.index.unknown'|trans }} {{ d.badge('message.index.badge_claimed'|trans, 'bg-green-lt') }}
              </a>
            {% else %}
              {{ d.empty_inline('message.index.empty.claimed'|trans, {tag: 'div', class: 'list-group-item text-secondary'}) }}
            {% endfor %}
          </div>
        {{ d.card_end({bodyClass: ''}) }}
      </div>
    {% endif %}
  </div>
{% endblock %}
