{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}Conversation{% endblock %}

{% block body %}
  {% set owner = queueService.ownerLabel(conversation) %}
  {{ d.page_header(
    conversation.type.value == 'support' ? 'Info Desk — ' ~ (conversation.subject ? conversation.subject.name : '') : 'Conversation',
    {
      subtitle: owner ? 'Claimed by ' ~ owner : (conversation.isOpen ? '' : 'Closed'),
      actions: [{label: '← Messages', href: path('app_messages_index'), class: 'btn btn-outline-secondary'}]
    }
  ) }}

  {% if canClaim and conversation.type.value == 'support' %}
    <div class="mb-3 d-flex gap-2">
      {% if not conversation.isClaimed %}
        <form method="post" action="{{ path('app_messages_claim', {id: conversation.uuid}) }}">
          <input type="hidden" name="_token" value="{{ csrf_token('chat_claim' ~ conversation.id) }}">
          <button class="btn btn-sm btn-primary">Claim</button>
        </form>
      {% elseif conversation.claimedBy.id == app.user.id %}
        <form method="post" action="{{ path('app_messages_unclaim', {id: conversation.uuid}) }}">
          <input type="hidden" name="_token" value="{{ csrf_token('chat_claim' ~ conversation.id) }}">
          <button class="btn btn-sm btn-outline-secondary">Unclaim</button>
        </form>
        <form method="post" action="{{ path('app_messages_close', {id: conversation.uuid}) }}"
              data-controller="confirm" data-confirm-message-value="Close this conversation?">
          <input type="hidden" name="_token" value="{{ csrf_token('chat_claim' ~ conversation.id) }}">
          <button class="btn btn-sm btn-outline-danger">Close</button>
        </form>
      {% endif %}
    </div>
  {% endif %}

  {{ d.card_start(null, {class: '', bodyClass: ''}) }}
    <div
      class="card-body chat-thread"
      data-controller="live-refresh"
      data-live-refresh-url-value="{{ path('app_messages_frame', {id: conversation.uuid}) }}"
      data-live-refresh-interval-value="5000"
    >
      {% include 'message/_thread.html.twig' with {conversation: conversation, messages: messages, chat: chat, typing: []} only %}
    </div>

    {% set conversationCardEnd = {bodyClass: ''} %}
    {% if conversation.isOpen %}
      {% set conversationFooter %}
        <form method="post" action="{{ path('app_messages_send', {id: conversation.uuid}) }}"
              class="d-flex gap-2"
              data-controller="chat-typing"
              data-chat-typing-url-value="{{ path('app_messages_typing', {id: conversation.uuid}) }}">
          <input type="hidden" name="_token" value="{{ csrf_token('chat' ~ conversation.id) }}">
          <input type="text" name="text" class="form-control" placeholder="Type a message…" autocomplete="off"
                 data-action="input->chat-typing#ping" required>
          <button class="btn btn-primary">Send</button>
        </form>
        {% if is_granted('chat:restricted') %}
          <form method="post" action="{{ path('app_messages_image', {id: conversation.uuid}) }}"
                enctype="multipart/form-data" class="d-flex gap-2 mt-2">
            <input type="hidden" name="_token" value="{{ csrf_token('chat' ~ conversation.id) }}">
            <input type="file" name="image" accept="image/*" class="form-control form-control-sm">
            <button class="btn btn-sm btn-outline-secondary">Attach image</button>
          </form>
        {% endif %}
      {% endset %}
      {% set conversationCardEnd = conversationCardEnd|merge({footer: conversationFooter}) %}
    {% endif %}
  {{ d.card_end(conversationCardEnd) }}
{% endblock %}
