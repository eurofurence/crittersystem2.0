{% import 'components/data/_macros.twig' as d %}
{{ d.card_start('message.index.waiting'|trans({'%count%': waiting|length}), {bodyClass: ''}) }}
  <div class="list-group list-group-flush">
    {% for c in waiting %}
      <a href="{{ path('app_messages_conversation', {id: c.uuid}) }}" class="list-group-item list-group-item-action">
        {{ c.subject ? c.subject.name : 'message.index.unknown'|trans }}
        <span class="text-secondary small">· {{ c.updatedAt|app_datetime }}</span>
      </a>
    {% else %}
      {{ d.empty_inline('message.index.empty.waiting'|trans, {tag: 'div', class: 'list-group-item text-secondary'}) }}
    {% endfor %}
  </div>
{{ d.card_end({bodyClass: ''}) }}
{{ d.card_start('message.index.claimed_by_you'|trans({'%count%': claimed|length}), {class: '', bodyClass: ''}) }}
  <div class="list-group list-group-flush">
    {% for c in claimed %}
      <a href="{{ path('app_messages_conversation', {id: c.uuid}) }}" class="list-group-item list-group-item-action">
        {{ c.subject ? c.subject.name : 'message.index.unknown'|trans }} {{ d.badge('message.index.badge_claimed'|trans, 'bg-green-lt') }}
      </a>
    {% else %}
      {{ d.empty_inline('message.index.empty.claimed'|trans, {tag: 'div', class: 'list-group-item text-secondary'}) }}
    {% endfor %}
  </div>
{{ d.card_end({bodyClass: ''}) }}
