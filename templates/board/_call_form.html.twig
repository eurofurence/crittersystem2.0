{#
  A call-for-help action, behind a confirmation.

  The board deliberately does not load Bootstrap, so the application's shared `confirm` controller
  cannot run here: it injects Bootstrap modal markup and falls back to a native `window.confirm()`,
  which this project does not allow. The kit's AlertDialog is the board's equivalent, and it is the
  reason these are dialogs rather than plain buttons - raising a call notifies real people, and
  cancelling one takes an offer of help away from them.

  The token is hand-written rather than rendered from a Form object, which is correct here: these ids
  are validated with `isCsrfTokenValid()` in CallController and are not among the stateless ones, so
  they fall back to the session token manager. The two `board_*` fields are what brings the browser
  back to this board instead of the staffing screen; CallController re-checks both before using them.

  Expects: action, token, label, confirm, variant; `shift` and `slots` only when triggering.
#}
{% set dialogId = 'call-' ~ (shift ?? action|split('/')|last) %}

<twig:AlertDialog id="{{ dialogId }}" class="inline-block">
  <twig:AlertDialog:Trigger>
    <twig:Button variant="{{ variant }}" size="xs" {{ ...alert_dialog_trigger_attrs }}>{{ label }}</twig:Button>
  </twig:AlertDialog:Trigger>

  <twig:AlertDialog:Content>
    <twig:AlertDialog:Header>
      <twig:AlertDialog:Title>{{ label }}</twig:AlertDialog:Title>
      <twig:AlertDialog:Description>{{ confirm }}</twig:AlertDialog:Description>
    </twig:AlertDialog:Header>
    <twig:AlertDialog:Footer>
      <twig:AlertDialog:Cancel size="sm">{{ 'common.action.cancel'|trans }}</twig:AlertDialog:Cancel>
      <form method="post" action="{{ action }}">
        <input type="hidden" name="_token" value="{{ token }}">
        {% if shift is defined and shift %}<input type="hidden" name="shift" value="{{ shift }}">{% endif %}
        {% if slots is not null %}<input type="hidden" name="slots" value="{{ slots }}">{% endif %}
        <input type="hidden" name="board_department" value="{{ department.uuid }}">
        <input type="hidden" name="board_date" value="{{ dayParam }}">
        <twig:AlertDialog:Action variant="{{ variant }}" size="sm">{{ label }}</twig:AlertDialog:Action>
      </form>
    </twig:AlertDialog:Footer>
  </twig:AlertDialog:Content>
</twig:AlertDialog>
