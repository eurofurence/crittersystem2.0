{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}
{% block title %}Confirm deletion{% endblock %}
{% block body %}
  {{ d.message_card_start('Permanently delete your account?', {
    width: 'col-md-6',
    class: 'border-danger',
    titleTag: 'h2',
    titleClass: 'card-title text-danger'
  }) }}
    <p>This is irreversible. All your data will be removed.</p>
    <form method="post" action="{{ path('app_erase_execute', {token: token}) }}">
      <button class="btn btn-danger">Yes, delete my account permanently</button>
    </form>
  {{ d.message_card_end() }}
{% endblock %}
