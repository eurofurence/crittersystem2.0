{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}
{% block title %}{{ 'erase.confirm.title'|trans }}{% endblock %}
{% block body %}
  {{ d.message_card_start('erase.confirm.heading'|trans, {
    width: 'col-md-6',
    class: 'border-danger',
    titleTag: 'h2',
    titleClass: 'card-title text-danger'
  }) }}
    <p>{{ 'erase.confirm.body'|trans }}</p>
    <form method="post" action="{{ path('app_erase_execute', {token: token}) }}">
      <button class="btn btn-danger">{{ 'erase.confirm.submit'|trans }}</button>
    </form>
  {{ d.message_card_end() }}
{% endblock %}
