{% extends 'base.html.twig' %}
{% block title %}Confirm deletion{% endblock %}
{% block body %}
  <div class="row justify-content-center"><div class="col-md-6"><div class="card border-danger"><div class="card-body text-center">
    <h2 class="card-title text-danger">Permanently delete your account?</h2>
    <p>This is irreversible. All your data will be removed.</p>
    <form method="post" action="{{ path('app_erase_execute', {token: token}) }}">
      <button class="btn btn-danger">Yes, delete my account permanently</button>
    </form>
  </div></div></div></div>
{% endblock %}
