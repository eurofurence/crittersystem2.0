{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}
{% block title %}{{ 'ui.user_menu.telegram'|trans }}{% endblock %}
{% block body %}
  {{ d.page_header('ui.user_menu.telegram'|trans, {subtitle: 'telegram.page.subtitle'|trans}) }}
  {{ d.card_start(null, {class: ''}) }}
    {% if user.telegramLinked %}
      <p>{{ d.badge('common.state.linked'|trans, 'text-bg-success') }} {{ 'telegram.linked.connected_as'|trans }} <strong>{{ user.telegramHandle ?? ('telegram.linked.your_account'|trans) }}</strong>.</p>
      <form method="post" action="{{ path('app_profile_telegram_unlink') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('telegram_unlink') }}">
        <button class="btn btn-outline-danger">{{ 'telegram.action.unlink'|trans }}</button>
      </form>
    {% elseif not enabled %}
      <p class="text-muted">{{ 'telegram.not_enabled'|trans }}</p>
    {% elseif pending %}
      <p>{{ 'telegram.pending.instructions'|trans({'%time%': pending.expiresAt|app_time}) }}</p>
      <p class="display-6"><code>{{ pending.code }}</code></p>
      <p class="text-muted small" id="tg-wait">{{ 'telegram.pending.waiting'|trans }}</p>
      <form method="post" action="{{ path('app_profile_telegram_start') }}"><button class="btn btn-link">{{ 'telegram.action.generate_new_code'|trans }}</button></form>
      <script>
        (function poll(){
          fetch('{{ path('app_profile_telegram_status') }}').then(r=>r.json()).then(d=>{
            if (d.linked) { window.location.reload(); } else { setTimeout(poll, 3000); }
          }).catch(()=>setTimeout(poll, 5000));
        })();
      </script>
    {% else %}
      <form method="post" action="{{ path('app_profile_telegram_start') }}">
        <button class="btn btn-primary">{{ 'telegram.action.link'|trans }}</button>
      </form>
    {% endif %}
  {{ d.card_end() }}
{% endblock %}
