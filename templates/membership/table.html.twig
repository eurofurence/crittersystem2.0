{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}Volunteer Types{% endblock %}

{% block body %}
  {{ d.page_header('Volunteer Types', {
    actions: [{label: 'Card view', href: path('app_membership_index'), class: 'btn btn-outline-secondary'}]
  }) }}

  {% if rows is empty %}
    {{ d.empty_state('No volunteer types', {message: 'There are no volunteer types to join yet.'}) }}
  {% else %}
    {{ d.table_start() }}
      <thead><tr><th>Type</th><th>Visibility</th><th>Status</th><th class="text-end">Action</th></tr></thead>
      <tbody>
        {% for row in rows %}
          <tr>
            <td><a href="{{ path('app_membership_show', {id: row.type.uuid}) }}">{{ row.type.name }}</a>
              {% if row.type.requiresIntroduction %}{{ d.badge('Requires introduction', 'text-bg-warning') }}{% endif %}
            </td>
            <td>{{ row.type.staffOnly ? 'Staff' : 'Public' }}{% if row.type.departmentOnly %} · Department{% endif %}</td>
            <td>
              {% if row.membership is null %}<span class="text-muted">Not a member</span>
              {% elseif row.membership.confirmed %}{{ d.badge('Member', 'text-bg-success') }}
              {% else %}{{ d.badge('Pending', 'text-bg-warning') }}{% endif %}
            </td>
            <td class="text-end">
              {% if row.membership is null %}
                <form method="post" action="{{ path('app_membership_join', {id: row.type.uuid}) }}" class="d-inline">
                  <input type="hidden" name="_token" value="{{ csrf_token('join' ~ row.type.id) }}">
                  <button class="btn btn-sm btn-primary">{{ row.type.requiresIntroduction ? 'Apply' : 'Join' }}</button>
                </form>
              {% else %}
                <form method="post" action="{{ path('app_membership_leave', {id: row.type.uuid}) }}" class="d-inline"
                      data-controller="confirm" data-confirm-message-value="Leave this volunteer type?">
                  <input type="hidden" name="_token" value="{{ csrf_token('leave' ~ row.type.id) }}">
                  <button class="btn btn-sm btn-outline-danger">Leave</button>
                </form>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </tbody>
    {{ d.table_end() }}
  {% endif %}
{% endblock %}
