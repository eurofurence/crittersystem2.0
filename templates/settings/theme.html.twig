{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}Theme — Settings{% endblock %}

{% block body %}
  {{ d.page_header('Theme', {
    subtitle: 'Pick how the site looks. Leave it on the default to follow what an administrator chose for everyone.',
    actions: [{label: '← Settings', href: path('app_settings'), class: 'btn btn-outline-secondary'}]
  }) }}

  {{ d.card_start(null, {
    tag: 'form',
    attrs: {method: 'post', action: path('app_settings_theme')}
  }) }}
      <input type="hidden" name="_token" value="{{ csrf_token('settings-theme') }}">

      <div class="row g-3">
        {% set followsDefault = current is null %}
        <div class="col-12 col-md-6 col-lg-4">
          <label class="card h-100 {{ followsDefault ? 'border-primary' : '' }}" style="cursor: pointer;">
            <div class="card-body d-flex align-items-start gap-2">
              <input class="form-check-input mt-1" type="radio" name="theme" value="" {{ followsDefault ? 'checked' }}>
              <div>
                <div class="fw-semibold">System default</div>
                <div class="text-muted small">Use whatever the administrator has set as the default.</div>
              </div>
            </div>
          </label>
        </div>

        {% for t in themes %}
          {% set checked = current == t.slug %}
          <div class="col-12 col-md-6 col-lg-4">
            <label class="card h-100 {{ checked ? 'border-primary' : '' }}" style="cursor: pointer;">
              <div class="card-body d-flex align-items-start gap-2">
                <input class="form-check-input mt-1" type="radio" name="theme" value="{{ t.slug }}" {{ checked ? 'checked' }}>
                <div>
                  <div class="fw-semibold">{{ t.name }} {{ d.badge(t.type|capitalize, t.type == 'dark' ? 'text-bg-dark' : 'text-bg-secondary') }}</div>
                  <div class="text-muted small font-monospace">{{ t.slug }}</div>
                </div>
              </div>
            </label>
          </div>
        {% endfor %}
      </div>

      <button class="btn btn-primary mt-3">Save</button>
      <a class="btn btn-link" href="?theme={{ active_theme.slug }}">Preview the active theme on the next page</a>
  {{ d.card_end({tag: 'form'}) }}

  <div class="alert alert-info">
    Active theme right now: <code>{{ active_theme.slug }}</code> ({{ active_theme.type }}).
    Tip: append <code>?theme=&lt;slug&gt;</code> to any URL to preview a theme without saving.
  </div>
{% endblock %}
