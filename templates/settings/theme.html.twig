{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ 'settings.theme.page.title'|trans }}{% endblock %}

{% block body %}
  {{ d.page_header('settings.theme.label'|trans, {
    subtitle: 'settings.theme.subtitle'|trans,
    actions: [{label: 'settings.theme.back'|trans, href: path('app_settings'), class: 'btn btn-outline-secondary'}]
  }) }}

  {{ d.card_start(null, {
    tag: 'form',
    attrs: {method: 'post', action: path('app_settings_theme')}
  }) }}
      <input type="hidden" name="_token" value="{{ csrf_token('settings-theme') }}">

      <div class="row g-3">
        {% set followsDefault = current is null %}
        <div class="col-12 col-md-6 col-lg-4">
          <label class="card h-100 {{ followsDefault ? 'border-primary' : '' }}" style="cursor: pointer;">
            <div class="card-body d-flex align-items-start gap-2">
              <input class="form-check-input mt-1" type="radio" name="theme" value="" {{ followsDefault ? 'checked' }}>
              <div>
                <div class="fw-semibold">{{ 'settings.theme.system_default'|trans }}</div>
                <div class="text-muted small">{{ 'settings.theme.system_default_help'|trans }}</div>
              </div>
            </div>
          </label>
        </div>

        {% for t in themes %}
          {% set checked = current == t.slug %}
          <div class="col-12 col-md-6 col-lg-4">
            <label class="card h-100 {{ checked ? 'border-primary' : '' }}" style="cursor: pointer;">
              <div class="card-body d-flex align-items-start gap-2">
                <input class="form-check-input mt-1" type="radio" name="theme" value="{{ t.slug }}" {{ checked ? 'checked' }}>
                <div>
                  <div class="fw-semibold">{{ t.name }} {{ d.badge(t.type|capitalize, t.type == 'dark' ? 'text-bg-dark' : 'text-bg-secondary') }}</div>
                  <div class="text-muted small font-monospace">{{ t.slug }}</div>
                </div>
              </div>
            </label>
          </div>
        {% endfor %}
      </div>

      <button class="btn btn-primary mt-3">{{ 'common.action.save'|trans }}</button>
      <a class="btn btn-link" href="?theme={{ active_theme.slug }}">{{ 'settings.theme.preview_link'|trans }}</a>
  {{ d.card_end({tag: 'form'}) }}

  <div class="alert alert-info">
    {{ 'settings.theme.active_label'|trans }} <code>{{ active_theme.slug }}</code> ({{ active_theme.type }}).
    {{ 'settings.theme.tip_prefix'|trans }} <code>?theme=&lt;slug&gt;</code> {{ 'settings.theme.tip_suffix'|trans }}
  </div>
{% endblock %}
