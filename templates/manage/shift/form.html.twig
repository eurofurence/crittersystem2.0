{% extends 'base.html.twig' %}
{% import 'components/forms/_macros.twig' as f %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ heading }}{% endblock %}

{% block body %}
  {{ d.page_header(heading, {
    actions: [{label: '← Back to shifts', href: path('app_manage_shift_index'), class: 'btn btn-outline-secondary'}]
  }) }}

  {{ form_start(form) }}
    <div class="row">
      {{ f.field(form.title, {col: 'col-12 col-md-8'}) }}
      {{ f.field(form.url, {col: 'col-12 col-md-4', help: 'Optional link'}) }}
      {{ f.field(form.startsAt, {col: 'col-12 col-md-3'}) }}
      {{ f.field(form.endsAt, {col: 'col-12 col-md-3'}) }}
      {{ f.choice(form.shiftType, {col: 'col-12 col-md-3'}) }}
      {{ f.choice(form.location, {col: 'col-12 col-md-3'}) }}
      {{ f.field(form.description, {col: 'col-12'}) }}
    </div>
    <button class="btn btn-primary mt-2">Save</button>
  {{ form_end(form) }}
{% endblock %}
