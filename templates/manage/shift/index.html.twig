{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}Shifts{% endblock %}

{% block body %}
  {{ d.page_header('Shifts', {
    subtitle: 'Scheduled work that volunteers sign up for.',
    actions: [
      {label: '← Manage', href: path('app_manage'), class: 'btn btn-outline-secondary'},
      {label: '+ New shift', href: path('app_manage_shift_new'), class: 'btn btn-primary'}
    ]
  }) }}

  {% if shifts is empty %}
    {{ d.empty_state('No shifts yet', {
      message: 'Create the first shift for volunteers to sign up.',
      actionLabel: '+ New shift',
      actionHref: path('app_manage_shift_new')
    }) }}
  {% else %}
    {{ d.table_start() }}
      <thead>
        <tr>
          <th>Title</th>
          <th>When</th>
          <th>Type / Location</th>
          <th>Signed up</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for shift in shifts %}
          <tr class="{{ shift.past ? 'opacity-75' : '' }}">
            <td class="fw-semibold">{{ shift.title }}</td>
            <td class="small">
              {{ shift.startsAt|app_datetime }} – {{ shift.endsAt|app_time }}
              <div class="text-muted">{{ shift.durationHours }}h{% if shift.past %} · past{% endif %}</div>
            </td>
            <td class="small">
              {{ shift.shiftTask ? shift.shiftTask.name : '—' }}
              <div class="text-muted">{{ shift.location ? shift.location.name : 'No location' }}</div>
            </td>
            <td>{{ shift.entries|length }}</td>
            {% set del %}
              {{ d.delete_form(path('app_manage_shift_delete', {id: shift.uuid}), csrf_token('delete' ~ shift.id), {
                message: 'Delete shift "' ~ shift.title ~ '"?'
              }) }}
            {% endset %}
            {{ d.row_actions([
              {label: 'Staffing', href: path('app_manage_shift_needs', {id: shift.uuid}), class: 'btn btn-sm btn-outline-secondary'},
              {label: 'Edit', href: path('app_manage_shift_edit', {id: shift.uuid})}
            ], {extraHtml: del}) }}
          </tr>
        {% endfor %}
      </tbody>
    {{ d.table_end() }}
  {% endif %}
{% endblock %}
