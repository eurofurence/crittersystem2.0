{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ 'manage.department.page.title'|trans }}{% endblock %}

{% block body %}
  {% set porter %}
    <a href="{{ path('app_manage_department_export') }}" class="btn btn-outline-secondary">{{ 'manage.action.export_json'|trans }}</a>
    <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#department-import-modal">{{ 'common.action.import'|trans }}</button>
  {% endset %}
  {{ d.page_header('manage.department.page.title'|trans, {
    subtitle: 'manage.department.page.subtitle'|trans,
    actions: [
      {label: 'manage.action.back_to_hub'|trans, href: path('app_manage'), class: 'btn btn-outline-secondary'},
      {label: 'manage.department.action.new'|trans, href: path('app_manage_department_new'), class: 'btn btn-primary'}
    ],
    actionsHtml: porter
  }) }}

  <div class="modal fade" id="department-import-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <form class="modal-content" method="post" action="{{ path('app_manage_department_import') }}" enctype="multipart/form-data">
        <div class="modal-header">
          <h5 class="modal-title">{{ 'manage.department.import.title'|trans }}</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'ui.aria.close'|trans }}"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" name="_token" value="{{ csrf_token('department_import') }}">
          <p class="text-muted small mb-3">{{ 'manage.department.import.help'|trans|raw }}</p>
          <div class="mb-3">
            <label class="form-label" for="department-import-file">{{ 'manage.import.upload_label'|trans }}</label>
            <input class="form-control" id="department-import-file" type="file" name="file" accept=".json,application/json">
          </div>
          <div class="mb-1">
            <label class="form-label" for="department-import-json">{{ 'manage.import.paste_label'|trans }}</label>
            <textarea class="form-control font-monospace" id="department-import-json" name="json" rows="8"
              placeholder='[{"name":"Logistics","slug":"logistics","description":"Move and store convention needs.","organizational":0,"locations":["main-hall"],"volunteerTypes":["Volunteer"]}]'></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-link" data-bs-dismiss="modal">{{ 'common.action.cancel'|trans }}</button>
          <button type="submit" class="btn btn-primary">{{ 'manage.department.import.submit'|trans }}</button>
        </div>
      </form>
    </div>
  </div>

  {% if departments is empty %}
    {{ d.empty_state('manage.department.empty.title'|trans, {
      message: 'manage.department.empty.message'|trans,
      actionLabel: 'manage.department.action.new'|trans,
      actionHref: path('app_manage_department_new')
    }) }}
  {% else %}
    {{ d.table_start() }}
      <thead>
        <tr>
          <th>{{ 'common.label.name'|trans }}</th>
          <th>{{ 'manage.label.locations'|trans }}</th>
          <th>{{ 'manage.label.volunteer_types'|trans }}</th>
          <th>{{ 'manage.label.visibility'|trans }}</th>
          <th>{{ 'manage.department.table.sso'|trans }}</th>
          <th class="text-end">{{ 'common.label.actions'|trans }}</th>
        </tr>
      </thead>
      <tbody>
        {% for dept in departments %}
          <tr>
            <td>
              <div class="fw-semibold">{{ dept.name }}</div>
              <div class="text-muted small"><code>{{ dept.slug }}</code></div>
            </td>
            <td class="small">{{ dept.locations|length }}</td>
            <td class="small">{{ dept.volunteerTypes|length }}</td>
            <td>
              {% if dept.staffOnly %}{{ d.badge('common.state.staff_only'|trans, 'text-bg-warning') }}
              {% else %}{{ d.badge('common.state.public'|trans, 'text-bg-success') }}{% endif %}
            </td>
            <td>
              {% if dept.id in ssoLinkedIds %}
                <a href="{{ path('app_manage_sso_mapping_index') }}" class="text-decoration-none" title="{{ 'manage.department.sso_linked_title'|trans }}">{{ d.badge('common.state.linked'|trans, 'text-bg-azure') }}</a>
              {% else %}
                <span class="text-muted">-</span>
              {% endif %}
            </td>
            {% set del %}
              {{ d.delete_form(path('app_manage_department_delete', {id: dept.uuid}), csrf_token('delete' ~ dept.id), {
                message: 'manage.department.confirm.delete'|trans({'%name%': dept.name})
              }) }}
            {% endset %}
            {{ d.row_actions([
              {label: 'common.action.edit'|trans, href: path('app_manage_department_edit', {id: dept.uuid})}
            ], {extraHtml: del}) }}
          </tr>
        {% endfor %}
      </tbody>
    {{ d.table_end() }}
  {% endif %}
{% endblock %}
