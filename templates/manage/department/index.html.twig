{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}Departments{% endblock %}

{% block body %}
  {{ d.page_header('Departments', {
    subtitle: 'Teams that organise shifts and volunteers.',
    actions: [
      {label: '← Manage', href: path('app_manage'), class: 'btn btn-outline-secondary'},
      {label: '+ New department', href: path('app_manage_department_new'), class: 'btn btn-primary'}
    ]
  }) }}

  {{ d.card_start('Bulk import (JSON)', {class: 'mb-4', titleTag: 'strong'}) }}
      <p class="text-muted small mb-2">
        Paste an array of departments. Only <code>name</code> is required — the
        <code>slug</code> (alias) is generated from the name when omitted. Optional:
        <code>description</code>, <code>staffonly</code>, <code>organizational</code>.
        Existing departments (matched by name or slug) are updated.
      </p>
      <form method="post" action="{{ path('app_manage_department_import') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('department_import') }}">
        <textarea name="json" class="form-control font-monospace" rows="8" placeholder='[{"name":"Art Show","staffonly":1},{"name":"Logistics","slug":"logistics","description":"Move and store convention needs.","organizational":0}]'></textarea>
        <button class="btn btn-primary mt-2">Import</button>
      </form>
  {{ d.card_end() }}

  {% if departments is empty %}
    {{ d.empty_state('No departments yet', {
      message: 'Create the first department to start organising teams.',
      actionLabel: '+ New department',
      actionHref: path('app_manage_department_new')
    }) }}
  {% else %}
    {{ d.table_start() }}
      <thead>
        <tr>
          <th>Name</th>
          <th>Locations</th>
          <th>Volunteer types</th>
          <th>Visibility</th>
          <th>SSO</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for dept in departments %}
          <tr>
            <td>
              <div class="fw-semibold">{{ dept.name }}</div>
              <div class="text-muted small"><code>{{ dept.slug }}</code></div>
            </td>
            <td class="small">{{ dept.locations|length }}</td>
            <td class="small">{{ dept.volunteerTypes|length }}</td>
            <td>
              {% if dept.staffOnly %}{{ d.badge('Staff only', 'text-bg-warning') }}
              {% else %}{{ d.badge('Public', 'text-bg-success') }}{% endif %}
            </td>
            <td>
              {% if dept.id in ssoLinkedIds %}
                <a href="{{ path('app_manage_sso_mapping_index') }}" class="text-decoration-none" title="Linked to an SSO group mapping">{{ d.badge('Linked', 'text-bg-azure') }}</a>
              {% else %}
                <span class="text-muted">—</span>
              {% endif %}
            </td>
            {% set del %}
              {{ d.delete_form(path('app_manage_department_delete', {id: dept.uuid}), csrf_token('delete' ~ dept.id), {
                message: 'Delete department "' ~ dept.name ~ '"?'
              }) }}
            {% endset %}
            {{ d.row_actions([
              {label: 'Edit', href: path('app_manage_department_edit', {id: dept.uuid})}
            ], {extraHtml: del}) }}
          </tr>
        {% endfor %}
      </tbody>
    {{ d.table_end() }}
  {% endif %}
{% endblock %}
