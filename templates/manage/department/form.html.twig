{% extends 'base.html.twig' %}
{% import 'components/forms/_macros.twig' as f %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ heading }}{% endblock %}

{% block body %}
  {{ d.page_header(heading, {
    actions: [{label: '← Back to departments', href: path('app_manage_department_index'), class: 'btn btn-outline-secondary'}]
  }) }}

  {{ form_start(form) }}
    <div class="row">
      {{ f.field(form.name, {col: 'col-12 col-md-6'}) }}
      {{ f.field(form.slug, {col: 'col-12 col-md-6', help: 'Leave blank to generate from the name.'}) }}
      {{ f.field(form.description, {col: 'col-12'}) }}
      {{ f.check(form.staffOnly, {col: 'col-12'}) }}
    </div>

    <div class="row">
      {{ f.choice_multiple(form.locations, {col: 'col-12 col-md-6', help: 'Areas this department operates in'}) }}
      {{ f.choice_multiple(form.volunteerTypes, {col: 'col-12 col-md-6', help: 'Role categories this department uses'}) }}
    </div>

    <button class="btn btn-primary mt-2">Save</button>
  {{ form_end(form) }}
{% endblock %}
