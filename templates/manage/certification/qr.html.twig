{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ 'manage.certification.qr.page_title'|trans({'%name%': certification.title}) }}{% endblock %}

{# Rotate before the token expires so the displayed QR stays valid. #}
{% block stylesheets %}{{ parent() }}<meta http-equiv="refresh" content="{{ ttlSeconds - 30 }}">{% endblock %}

{% block body %}
  {{ d.page_header('manage.certification.qr.heading'|trans({'%name%': certification.title}), {
    subtitle: 'manage.certification.qr.subtitle'|trans,
    actions: [{label: 'manage.certification.action.back'|trans, href: path('app_manage_certification_index'), class: 'btn btn-outline-secondary'}]
  }) }}

  <div class="row g-3 justify-content-center">
    <div class="col-12 col-md-7 col-lg-5">
      {{ d.card_start(null, {class: 'text-center'}) }}
          <img src="{{ qrDataUri }}" alt="{{ 'manage.certification.qr.image_alt'|trans }}" class="img-fluid mb-2" style="max-width: 360px;">
          <div class="text-muted small">{{ 'manage.certification.qr.valid_until'|trans({'%time%': token.expiresAt|app_time}) }}</div>
          <form method="post" action="{{ path('app_manage_certification_qr_refresh', {id: certification.uuid}) }}" class="mt-3">
            <input type="hidden" name="_token" value="{{ csrf_token('cert-qr-refresh' ~ certification.id) }}">
            <button class="btn btn-sm btn-outline-primary">{{ 'manage.certification.qr.refresh'|trans }}</button>
          </form>
      {{ d.card_end() }}
      <div class="text-muted small text-center mt-2">
        {{ 'manage.certification.qr.scan_url'|trans }} <code>{{ verifyUrl }}</code>
      </div>
      <p class="text-muted small mt-3 text-center">
        {{ 'manage.certification.qr.scan_note'|trans }} <a href="{{ path('app_certifications_index') }}">{{ path('app_certifications_index') }}</a>.
      </p>
    </div>
  </div>
{% endblock %}
