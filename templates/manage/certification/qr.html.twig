{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ 'manage.certification.qr.page_title'|trans({'%name%': certification.title}) }}{% endblock %}

{% block body %}
  {{ d.page_header('manage.certification.qr.heading'|trans({'%name%': certification.title}), {
    subtitle: 'manage.certification.qr.subtitle'|trans,
    actions: [{label: 'manage.certification.action.back'|trans, href: path('app_manage_certification_index'), class: 'btn btn-outline-secondary'}]
  }) }}

  <div class="row g-3 justify-content-center">
    <div class="col-12 col-md-7 col-lg-5">
      {#
        The QR rotates on a clock. Nothing happens on the server when a token expires, so there is
        no topic to publish and nothing to subscribe to: the card declares the instant it is
        replaced and the region re-fetches it once at exactly that moment.

        It has to be JavaScript rather than a <meta http-equiv="refresh">: Turbo never reloads the
        document, so the refresh keeps ticking after the user has navigated away and pulls them
        back to this page.

        The region holds the card and nothing else, because a refresh replaces everything inside it.
      #}
      <div data-controller="live-stream"
           data-live-stream-url-value="{{ path('app_manage_certification_qr_card', {id: certification.uuid}) }}">
        {{ include('manage/certification/_qr_card.html.twig') }}
      </div>

      <p class="text-muted small mt-3 text-center">
        {{ 'manage.certification.qr.scan_note'|trans }} <a href="{{ path('app_certifications_index') }}">{{ path('app_certifications_index') }}</a>.
      </p>
    </div>
  </div>
{% endblock %}
