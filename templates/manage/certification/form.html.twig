{% extends 'base.html.twig' %}
{% import 'components/forms/_macros.twig' as f %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ heading|trans }}{% endblock %}

{% block body %}
  {{ d.page_header(heading|trans, {
    actions: [{label: 'manage.certification.action.back'|trans, href: path('app_manage_certification_index'), class: 'btn btn-outline-secondary'}]
  }) }}

  {{ form_start(form) }}
    <div class="row">
      {{ f.field(form.title, {col: 'col-12 col-md-6'}) }}
      {{ f.field(form.location, {col: 'col-12 col-md-6'}) }}
      {{ f.field(form.description, {col: 'col-12'}) }}
    </div>

    <h2 class="h6 mt-2">{{ 'manage.certification.card.contact'|trans }}</h2>
    <div class="row">
      {{ f.field(form.contactPerson, {col: 'col-12 col-md-6'}) }}
      {{ f.field(form.contactEmail, {col: 'col-12 col-md-6'}) }}
    </div>

    <h2 class="h6 mt-2">{{ 'manage.certification.card.validity_options'|trans }}</h2>
    <div class="row">
      {{ f.field(form.validityPeriodDays, {col: 'col-12 col-md-4', help: 'manage.certification.field.validity_period_days.help'|trans}) }}
    </div>
    <div class="row">
      {{ f.check(form.isPerpetual) }}
      {{ f.check(form.allowSelfConfirmation) }}
      {{ f.check(form.staffOnly) }}
      {{ f.check(form.isActive) }}
    </div>

    <button class="btn btn-primary mt-3">{{ 'common.action.save'|trans }}</button>
  {{ form_end(form) }}
{% endblock %}
