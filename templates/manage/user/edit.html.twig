{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ 'manage.user.edit.heading'|trans({'%name%': user.name}) }}{% endblock %}

{% block body %}
  {{ d.page_header('manage.user.edit.heading'|trans({'%name%': user.name}), {actions: [{label: 'manage.user.action.back_to_index'|trans, href: path('app_manage_user_index'), class: 'btn btn-outline-secondary'}]}) }}
  <form method="post">
    {% if user.canEditFullName %}
      <div class="row g-3">
        <div class="col-md-6"><label class="form-label">{{ 'manage.label.first_name'|trans }}</label><input class="form-control" name="first_name" value="{{ user.personalData ? user.personalData.firstName }}"></div>
        <div class="col-md-6"><label class="form-label">{{ 'manage.label.last_name'|trans }}</label><input class="form-control" name="last_name" value="{{ user.personalData ? user.personalData.lastName }}"></div>
      </div>
    {% else %}
      <p class="text-muted small">{{ 'manage.user.edit.name_external'|trans }}</p>
    {% endif %}

    {% if is_granted('user:promote') %}
      <div class="mt-3"><div class="form-label">{{ 'manage.label.groups'|trans }}</div>
        {% for g in assignableGroups %}
          <label class="form-check"><input type="checkbox" class="form-check-input" name="groups[]" value="{{ g.uuid }}" {{ user.groups.contains(g) ? 'checked' }}><span class="form-check-label">{{ g.name }}{% if g.role %} <span class="text-muted small">({{ g.role }})</span>{% endif %}</span></label>
        {% endfor %}
      </div>
    {% endif %}

    {% if is_granted('badge:assign') %}
      <div class="mt-3"><div class="form-label">{{ 'manage.label.badges'|trans }}</div>
        {% for b in allBadges %}
          <label class="form-check"><input type="checkbox" class="form-check-input" name="badges[]" value="{{ b.uuid }}" {{ user.hasBadge(b) ? 'checked' }}><span class="form-check-label">{{ d.badge(b.name, 'text-bg-' ~ b.color) }}</span></label>
        {% endfor %}
      </div>
    {% endif %}

    <div class="mt-3"><label class="form-check"><input type="checkbox" class="form-check-input" name="active" value="1" {{ (user.state and user.state.active) ? 'checked' }}><span class="form-check-label">{{ 'common.state.active'|trans }}</span></label></div>

    <div class="mt-3"><button class="btn btn-primary">{{ 'common.action.save'|trans }}</button></div>
  </form>

  {% if is_granted('user:telegram:admin') and user.telegramLinked %}
    <hr>
    <form method="post" action="{{ path('app_manage_user_unlink_telegram', {id: user.uuid}) }}" class="mb-2"
          data-controller="confirm" data-confirm-message-value="{{ 'manage.user.confirm.unlink_telegram'|trans }}">
      <input type="hidden" name="_token" value="{{ csrf_token('untg' ~ user.id) }}">
      <button class="btn btn-outline-warning btn-sm">{{ 'manage.user.action.unlink_telegram'|trans }}</button>
    </form>
  {% endif %}

  {% if is_granted('global:admin') and user.twoFactorEnabled %}
    <hr>
    <form method="post" action="{{ path('app_manage_user_reset_2fa', {id: user.uuid}) }}"
          data-controller="confirm" data-confirm-message-value="{{ 'manage.user.confirm.reset_2fa'|trans }}">
      <input type="hidden" name="_token" value="{{ csrf_token('reset2fa' ~ user.id) }}">
      <button class="btn btn-outline-danger btn-sm">{{ 'manage.user.action.reset_2fa'|trans }}</button>
    </form>
  {% endif %}
{% endblock %}
