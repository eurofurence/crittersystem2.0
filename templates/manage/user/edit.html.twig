{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}
{% import 'components/icon/_macros.twig' as i %}

{% block title %}{{ 'manage.user.edit.heading'|trans({'%name%': user.name}) }}{% endblock %}

{% block body %}
  {{ d.page_header('manage.user.edit.heading'|trans({'%name%': user.name}), {actions: [{label: 'manage.user.action.back_to_index'|trans, href: path('app_manage_user_index'), class: 'btn btn-outline-secondary'}]}) }}

  {{ d.card_start('Email', {class: 'mb-3'}) }}
    <div class="d-flex flex-wrap align-items-center gap-2">
      <span>{{ user.email|pii_email }}</span>
      {% if user.ssoManaged %}
        {{ d.badge('Managed by SSO', 'text-bg-secondary') }}
      {% else %}
        {{ d.badge('Manual account', 'text-bg-light') }}
      {% endif %}
    </div>

    {% if is_granted('global:admin') and not user.ssoManaged %}
      <form method="post" action="{{ path('app_manage_user_change_email', {id: user.uuid}) }}" class="row g-2 align-items-end mt-2"
            data-controller="confirm"
            data-confirm-title-value="Change account email?"
            data-confirm-message-value="This changes the address used for notifications and email-based login. If onboarding is incomplete, the existing invitation will be invalidated and a fresh invitation sent to the new address."
            data-confirm-confirm-label-value="Change email"
            data-confirm-variant-value="warning">
        <input type="hidden" name="_token" value="{{ csrf_token('change-email' ~ user.id) }}">
        <div class="col-md-8">
          <label class="form-label" for="admin-email-{{ user.id }}">New email address</label>
          <input id="admin-email-{{ user.id }}" class="form-control" type="email" name="email" required autocomplete="off" placeholder="new-address@example.org">
          <div class="form-hint">Global administrators only. A fresh 2FA verification is required before the change is accepted.</div>
        </div>
        <div class="col-md-auto"><button class="btn btn-outline-warning">Change email</button></div>
      </form>
    {% elseif user.ssoManaged %}
      <div class="form-hint mt-2">This address is authoritative at the identity provider and is refreshed from SSO at sign-in.</div>
    {% endif %}

    {% if is_granted('user:create') and not user.ssoManaged and not user.onboardingCompleted %}
      <form method="post" action="{{ path('app_manage_user_resend_invite', {id: user.uuid}) }}" class="mt-3"
            data-controller="confirm"
            data-confirm-title-value="Resend invitation"
            data-confirm-message-value="Send a fresh 24-hour invitation to this account? The previous invitation link will stop working."
            data-confirm-confirm-label-value="Resend"
            data-confirm-variant-value="primary">
        <input type="hidden" name="_token" value="{{ csrf_token('resend-invite' ~ user.id) }}">
        <input type="hidden" name="from" value="edit">
        <button class="btn btn-outline-primary btn-sm">{{ i.icon('mail') }} Resend invitation</button>
      </form>
    {% endif %}
  {{ d.card_end() }}

  <form method="post">
    {% if user.canEditFullName %}
      <div class="row g-3">
        <div class="col-md-6"><label class="form-label">{{ 'manage.label.first_name'|trans }}</label><input class="form-control" name="first_name" value="{{ user.personalData ? user.personalData.firstName }}"></div>
        <div class="col-md-6"><label class="form-label">{{ 'manage.label.last_name'|trans }}</label><input class="form-control" name="last_name" value="{{ user.personalData ? user.personalData.lastName }}"></div>
      </div>
    {% else %}
      <p class="text-muted small">{{ 'manage.user.edit.name_external'|trans }}</p>
    {% endif %}

    {% if is_granted('user:promote') %}
      <div class="mt-3"><div class="form-label">{{ 'manage.label.groups'|trans }}</div>
        {% for g in assignableGroups %}
          <label class="form-check"><input type="checkbox" class="form-check-input" name="groups[]" value="{{ g.uuid }}" {{ user.groups.contains(g) ? 'checked' }}><span class="form-check-label">{{ g.name }}{% if g.role %} <span class="text-muted small">({{ g.role }})</span>{% endif %}</span></label>
        {% endfor %}
      </div>
    {% endif %}

    {% if is_granted('badge:assign') %}
      <div class="mt-3"><div class="form-label">{{ 'manage.label.badges'|trans }}</div>
        {% for b in allBadges %}
          <label class="form-check"><input type="checkbox" class="form-check-input" name="badges[]" value="{{ b.uuid }}" {{ user.hasBadge(b) ? 'checked' }}><span class="form-check-label">{{ d.badge(b.name, 'text-bg-' ~ b.color) }}</span></label>
        {% endfor %}
      </div>
    {% endif %}

    <div class="mt-3"><label class="form-check"><input type="checkbox" class="form-check-input" name="active" value="1" {{ (user.state and user.state.active) ? 'checked' }}><span class="form-check-label">{{ 'common.state.active'|trans }}</span></label></div>

    <div class="mt-3"><button class="btn btn-primary">{{ 'common.action.save'|trans }}</button></div>
  </form>

  {% if canGrantCertifications %}
    {{ d.card_start('manage.certification.user.heading'|trans, {class: 'mt-3'}) }}
      {% if certifications is empty %}
        {{ d.empty_inline('manage.certification.user.none'|trans, {tag: 'div', class: 'text-secondary mb-3'}) }}
      {% else %}
        <div class="table-responsive mb-3">
          <table class="table table-vcenter">
            <thead>
              <tr>
                <th>{{ 'manage.certification.queue.col.certification'|trans }}</th>
                <th>{{ 'common.label.status'|trans }}</th>
                <th>{{ 'manage.certification.show.col.expires'|trans }}</th>
                <th class="text-end">{{ 'common.label.actions'|trans }}</th>
              </tr>
            </thead>
            <tbody>
              {% for record in certifications %}
                <tr>
                  <td>
                    <a href="{{ path('app_manage_certification_show', {id: record.certification.uuid}) }}">{{ record.certification.title }}</a>
                  </td>
                  <td>{{ ('manage.certification.status.' ~ record.effectiveStatus())|trans }}</td>
                  <td class="small">
                    {{ record.dateExpires ? record.dateExpires|app_date : 'manage.certification.validity.never_expires'|trans }}
                  </td>
                  <td class="text-end">{{ include('manage/certification/_decide.html.twig', {record: record, from: 'show'}) }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}

      {{ include('manage/certification/_grant_form.html.twig', {
        certification: null,
        holder: user,
        certifications: grantableCertifications,
        from: 'user'
      }) }}
    {{ d.card_end() }}
  {% endif %}

  {% if is_granted('user:telegram:admin') and user.telegramLinked %}
    <hr>
    <form method="post" action="{{ path('app_manage_user_unlink_telegram', {id: user.uuid}) }}" class="mb-2"
          data-controller="confirm" data-confirm-message-value="{{ 'manage.user.confirm.unlink_telegram'|trans }}">
      <input type="hidden" name="_token" value="{{ csrf_token('untg' ~ user.id) }}">
      <button class="btn btn-outline-warning btn-sm">{{ 'manage.user.action.unlink_telegram'|trans }}</button>
    </form>
  {% endif %}

  {% if is_granted('global:admin') and user.twoFactorEnabled %}
    <hr>
    <form method="post" action="{{ path('app_manage_user_reset_2fa', {id: user.uuid}) }}"
          data-controller="confirm" data-confirm-message-value="{{ 'manage.user.confirm.reset_2fa'|trans }}">
      <input type="hidden" name="_token" value="{{ csrf_token('reset2fa' ~ user.id) }}">
      <button class="btn btn-outline-danger btn-sm">{{ 'manage.user.action.reset_2fa'|trans }}</button>
    </form>
  {% endif %}
{% endblock %}
