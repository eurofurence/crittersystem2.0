{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}Edit {{ user.name }}{% endblock %}

{% block body %}
  {{ d.page_header('Edit ' ~ user.name, {actions: [{label: '← Users', href: path('app_manage_user_index'), class: 'btn btn-outline-secondary'}]}) }}
  <form method="post">
    {% if user.canEditFullName %}
      <div class="row g-3">
        <div class="col-md-6"><label class="form-label">First name</label><input class="form-control" name="first_name" value="{{ user.personalData ? user.personalData.firstName }}"></div>
        <div class="col-md-6"><label class="form-label">Last name</label><input class="form-control" name="last_name" value="{{ user.personalData ? user.personalData.lastName }}"></div>
      </div>
    {% else %}
      <p class="text-muted small">This account's name is managed externally and cannot be changed here.</p>
    {% endif %}

    {% if is_granted('user:promote') %}
      <div class="mt-3"><div class="form-label">Groups</div>
        {% for g in assignableGroups %}
          <label class="form-check"><input type="checkbox" class="form-check-input" name="groups[]" value="{{ g.id }}" {{ user.groups.contains(g) ? 'checked' }}><span class="form-check-label">{{ g.name }}{% if g.role %} <span class="text-muted small">({{ g.role }})</span>{% endif %}</span></label>
        {% endfor %}
      </div>
    {% endif %}

    {% if is_granted('badge:assign') %}
      <div class="mt-3"><div class="form-label">Badges</div>
        {% for b in allBadges %}
          <label class="form-check"><input type="checkbox" class="form-check-input" name="badges[]" value="{{ b.id }}" {{ user.hasBadge(b) ? 'checked' }}><span class="form-check-label"><span class="badge text-bg-{{ b.color }}">{{ b.name }}</span></span></label>
        {% endfor %}
      </div>
    {% endif %}

    <div class="mt-3"><label class="form-check"><input type="checkbox" class="form-check-input" name="active" value="1" {{ (user.state and user.state.active) ? 'checked' }}><span class="form-check-label">Active</span></label></div>

    <div class="mt-3"><button class="btn btn-primary">Save</button></div>
  </form>

  {% if is_granted('user:telegram:admin') and user.telegramLinked %}
    <hr>
    <form method="post" action="{{ path('app_manage_user_unlink_telegram', {id: user.id}) }}" class="mb-2"
          onsubmit="return confirm('Unlink this user\'s Telegram account?');">
      <input type="hidden" name="_token" value="{{ csrf_token('untg' ~ user.id) }}">
      <button class="btn btn-outline-warning btn-sm">Unlink Telegram</button>
    </form>
  {% endif %}

  {% if is_granted('global:admin') and user.twoFactorEnabled %}
    <hr>
    <form method="post" action="{{ path('app_manage_user_reset_2fa', {id: user.id}) }}"
          onsubmit="return confirm('Reset this user\'s two-factor authentication? They will be emailed.');">
      <input type="hidden" name="_token" value="{{ csrf_token('reset2fa' ~ user.id) }}">
      <button class="btn btn-outline-danger btn-sm">Reset two-factor authentication</button>
    </form>
  {% endif %}
{% endblock %}
