{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}
{% import 'components/forms/_macros.twig' as f %}

{% block title %}{{ 'manage.user.invite.title'|trans }}{% endblock %}

{% block body %}
  {{ d.page_header('manage.user.invite.title'|trans, {actions: [{label: 'manage.user.action.back_to_index'|trans, href: path('app_manage_user_index'), class: 'btn btn-outline-secondary'}]}) }}
  <p class="text-muted">{{ 'manage.user.invite.intro'|trans }}</p>
  {{ form_start(form) }}
    <div class="row g-3">
      {{ f.field(form.username, {col: 'col-12 col-md-6'}) }}
      {{ f.field(form.email, {col: 'col-12 col-md-6'}) }}
      {{ f.field(form.firstName, {col: 'col-12 col-md-6'}) }}
      {{ f.field(form.lastName, {col: 'col-12 col-md-6'}) }}
    </div>
    {{ form_row(form.groups) }}
    <div class="mt-3"><button class="btn btn-primary">{{ 'manage.user.invite.submit'|trans }}</button></div>
  {{ form_end(form) }}
{% endblock %}
