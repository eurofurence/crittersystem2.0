{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}
{% import 'components/forms/_macros.twig' as f %}

{% block title %}Invite user{% endblock %}

{% block body %}
  {{ d.page_header('Invite user', {actions: [{label: '← Users', href: path('app_manage_user_index'), class: 'btn btn-outline-secondary'}]}) }}
  <p class="text-muted">The user receives an email to confirm their account and set a password. The link expires in 24 hours.</p>
  {{ form_start(form) }}
    <div class="row g-3">
      {{ f.field(form.username, {col: 'col-12 col-md-6'}) }}
      {{ f.field(form.email, {col: 'col-12 col-md-6'}) }}
      {{ f.field(form.firstName, {col: 'col-12 col-md-6'}) }}
      {{ f.field(form.lastName, {col: 'col-12 col-md-6'}) }}
    </div>
    {{ form_row(form.groups) }}
    <div class="mt-3"><button class="btn btn-primary">Send invitation</button></div>
  {{ form_end(form) }}
{% endblock %}
