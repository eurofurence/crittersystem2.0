{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ 'manage.user.page.title'|trans }}{% endblock %}

{% block body %}
  {{ d.page_header('manage.user.page.title'|trans, {
    subtitle: 'manage.user.page.subtitle'|trans,
    actions: [
      {label: 'manage.action.back_to_hub'|trans, href: path('app_manage'), class: 'btn btn-outline-secondary'},
      is_granted('user:create') ? {label: 'manage.user.action.invite'|trans, href: path('app_manage_user_invite'), class: 'btn btn-primary'} : null
    ]|filter(a => a is not null)
  }) }}

  <div class="d-flex gap-2 mb-3">
    <form method="get" class="flex-grow-1"><input type="text" name="q" value="{{ query }}" class="form-control" placeholder="{{ 'manage.user.search.placeholder'|trans }}"></form>
    {% if is_granted('global:admin') %}
      {{ d.delete_form(path('app_manage_user_reset_onboarding_all'), csrf_token('reset-onboarding-all'), {
        label: 'manage.user.onboarding.force_all_label'|trans,
        class: 'btn btn-warning text-nowrap',
        confirmTitle: 'manage.user.onboarding.force_all_title'|trans,
        confirmLabel: 'manage.user.onboarding.force_all_confirm'|trans,
        variant: 'warning',
        message: 'manage.user.onboarding.force_all_message'|trans
      }) }}
    {% endif %}
  </div>

  {% if can_reveal_pii() %}
    <div class="alert alert-secondary d-flex align-items-center mb-3" role="status">
      <span class="me-auto">{{ 'manage.user.pii.masked_notice'|trans }}</span>
      <a class="btn btn-sm btn-outline-primary text-nowrap" href="{{ path('app_2fa_confirm', {return: app.request.requestUri}) }}">{{ 'manage.user.pii.reveal'|trans }}</a>
    </div>
  {% endif %}

  {{ d.table_start() }}
    <thead><tr><th>{{ 'common.label.user'|trans }}</th><th>{{ 'common.label.email'|trans }}</th><th>{{ 'manage.user.table.position'|trans }}</th><th>{{ 'manage.user.table.onboarded'|trans }}</th><th class="text-end">{{ 'common.label.actions'|trans }}</th></tr></thead>
    <tbody>
      {% for u in users %}
        <tr>
          <td>
            <span class="fw-semibold">{{ u.name }}</span> <span class="text-muted small">#{{ u.id }}</span>
            {% for b in u.badges %}{{ d.badge(b.name, 'text-bg-' ~ b.color, {class: 'ms-1'}) }}{% endfor %}
          </td>
          <td class="small">{{ u.email|pii_email }}</td>
          <td class="small">{{ u.positionBadge ? u.positionBadge.name : '-' }}</td>
          <td>
            {% if u.onboardingCompleted %}{{ d.badge('common.state.yes'|trans, 'text-bg-success') }}{% else %}{{ d.badge('common.state.pending'|trans, 'text-bg-warning') }}{% endif %}
            {# The reset is queued, not applied: it takes effect at the user's next sign-in. #}
            {% if u.onboardingResetPending %}{{ d.badge('manage.user.onboarding.rerun_queued'|trans, 'text-bg-info', {class: 'ms-1'}) }}{% endif %}
          </td>
          <td class="text-end text-nowrap">
            {% if is_granted('user:edit') %}<a class="btn btn-sm btn-outline-primary" href="{{ path('app_manage_user_edit', {id: u.uuid}) }}">{{ 'common.action.edit'|trans }}</a>{% endif %}
            {% if is_granted('global:admin') %}
              {{ d.delete_form(path('app_manage_user_reset_onboarding', {id: u.uuid}), csrf_token('reset-onboarding' ~ u.id), {
                label: u.onboardingResetPending ? 'manage.user.onboarding.cancel_rerun'|trans : 'manage.user.onboarding.force'|trans,
                class: 'btn btn-sm ' ~ (u.onboardingResetPending ? 'btn-outline-secondary' : 'btn-warning'),
                confirmTitle: u.onboardingResetPending ? 'manage.user.onboarding.cancel_title'|trans : 'manage.user.onboarding.force_title'|trans,
                confirmLabel: u.onboardingResetPending ? 'manage.user.onboarding.cancel_rerun'|trans : 'manage.user.onboarding.force'|trans,
                variant: u.onboardingResetPending ? 'secondary' : 'warning',
                message: u.onboardingResetPending
                  ? 'manage.user.onboarding.cancel_message'|trans({'%name%': u.name})
                  : 'manage.user.onboarding.force_message'|trans({'%name%': u.name})
              }) }}
            {% endif %}
          </td>
        </tr>
      {% endfor %}
    </tbody>
  {{ d.table_end() }}
{% endblock %}
