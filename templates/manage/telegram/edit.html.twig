{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}
{% block title %}Telegram configuration{% endblock %}
{% block body %}
  {{ d.page_header('Telegram bot configuration', {actions: [{label: '← Manage', href: path('app_manage'), class: 'btn btn-outline-secondary'}]}) }}
  <form method="post" style="max-width:40rem">
    <input type="hidden" name="_token" value="{{ csrf_token('telegram_config') }}">
    <label class="form-check mb-3">
      <input type="checkbox" class="form-check-input" name="enabled" value="1" {{ config.enabled ? 'checked' }}>
      <span class="form-check-label">Enable Telegram linking</span>
    </label>
    <div class="mb-3">
      <label class="form-label">Bot API endpoint</label>
      <input type="url" class="form-control" name="api_endpoint" value="{{ config.apiEndpoint }}" placeholder="https://bot.example/api">
    </div>
    <div class="mb-3">
      <label class="form-label">API key {% if config.hasApiKey %}<span class="text-success small">(set — leave blank to keep)</span>{% endif %}</label>
      <input type="password" class="form-control" name="api_key" autocomplete="new-password" placeholder="{{ config.hasApiKey ? '••••••••' : '' }}">
      <div class="form-text">Stored encrypted. Never displayed.</div>
    </div>
    <button class="btn btn-primary">Save</button>
  </form>
{% endblock %}
