{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}Management{% endblock %}

{% block body %}
  {{ d.page_header('Management', {subtitle: 'Configure the core event data.'}) }}

  {# Each card is gated by the privilege that guards its controller. #}
  {% set cards = [
    {priv: 'user:view',             route: 'app_manage_user_index',            icon: '👤', title: 'Users',           text: 'Manage volunteer and staff accounts.'},
    {priv: 'badge:manage',          route: 'app_manage_badge_index',           icon: '🎫', title: 'Badges',          text: 'Identification badges and batch assignment.'},
    {priv: 'user:delete',           route: 'app_manage_ban_index',             icon: '🚫', title: 'Ban Appeals',     text: 'Review and lift bans after appeals.'},
    {priv: 'location:manage',       route: 'app_manage_location_index',        icon: '📍', title: 'Locations',       text: 'Physical areas where shifts take place.'},
    {priv: 'volunteertype:manage',  route: 'app_manage_volunteer_type_index',  icon: '🧩', title: 'Volunteer Types', text: 'Role categories volunteers can join.'},
    {priv: 'volunteertype:manage',  route: 'app_manage_applications',          icon: '📨', title: 'Applications',    text: 'Confirm pending membership requests.'},
    {priv: 'shift:manage',          route: 'app_manage_shift_index',           icon: '🕒', title: 'Shifts',          text: 'Scheduled work and staffing needs.'},
    {priv: 'shift:manage',          route: 'app_manage_shift_task_index',      icon: '🗂️', title: 'Shift Tasks',     text: 'Categories and templates for shifts.'},
    {priv: 'department:manage',     route: 'app_manage_department_index',      icon: '🏢', title: 'Departments',     text: 'Teams that organise shifts and volunteers.'},
    {priv: 'certification:manage',  route: 'app_manage_certification_index',   icon: '🎖️', title: 'Certifications',  text: 'Skills and qualifications volunteers can hold.'},
    {priv: 'user:worklog:edit',     route: 'app_manage_worklog_index',         icon: '⏱️', title: 'Worklogs',        text: 'Manual hour entries for volunteers.'},
    {priv: 'news:manage',           route: 'app_manage_news_index',            icon: '📰', title: 'News',            text: 'Publish and edit announcements.'},
    {priv: 'question:answer',       route: 'app_manage_questions_index',       icon: '❓', title: 'Questions',       text: 'Answer volunteer questions.'},
    {priv: 'faq:manage',            route: 'app_manage_faq_index',             icon: '📚', title: 'FAQ',             text: 'Curate frequently asked questions.'},
    {priv: 'rbac:group:view',       route: 'app_manage_group_index',           icon: '🔑', title: 'Groups & Permissions', text: 'Permission groups and the access each grants.'},
    {priv: 'config:privacy',        route: 'app_manage_privacy_notice',        icon: '🔏', title: 'Privacy Notice',    text: 'GDPR privacy notice shown to volunteers.'},
    {priv: 'config:consent',        route: 'app_manage_consent_text_index',    icon: '✅', title: 'Consent Texts',     text: 'Onboarding consent disclaimer, per language.'},
    {priv: 'rbac:ssomap:manage',    route: 'app_manage_sso_mapping_index',     icon: '🔗', title: 'SSO Mappings',    text: 'Map SSO groups to departments, groups, types and badges.'},
    {priv: 'config:sso',            route: 'app_admin_sso',                    icon: '🛂', title: 'SSO Status',       text: 'OpenID Connect connection status and redirect URI.'},
    {priv: 'config:sso',            route: 'app_admin_sso_roles',              icon: '🏅', title: 'SSO Department Roles', text: 'IdP roles that make a mapped user a department or shift manager.'},
    {priv: 'config:telegram',       route: 'app_manage_telegram',              icon: '📨', title: 'Telegram',         text: 'Bot endpoint, API key and enablement.'},
    {priv: 'config:event',          route: 'app_manage_event_config',          icon: '⚙️', title: 'Event Configuration', text: 'Global event settings and timeline.'},
    {priv: 'config:event',          route: 'app_manage_operations_config',     icon: '🎚️', title: 'Operational Configuration', text: 'Bans, messaging, calls, reminders and reward-hour tuning.'},
    {priv: 'config:display',        route: 'app_manage_configuration',         icon: '🕰️', title: 'Configuration',   text: 'Timezone and date/time display formats.'},
    {priv: 'audit:view',            route: 'app_manage_audit',                 icon: '🛡️', title: 'Audit Log',       text: 'Security and administrative audit trail with legal export.'}
  ] %}

  {% set canManageAny = is_granted('user:view') or is_granted('badge:manage') or is_granted('location:manage') or is_granted('volunteertype:manage') or is_granted('shift:manage') or is_granted('global:admin') or is_granted('config:event') or is_granted('config:display') or is_granted('config:privacy') or is_granted('config:consent') or is_granted('user:worklog:edit') or is_granted('news:manage') or is_granted('question:answer') or is_granted('faq:manage') or is_granted('rbac:group:view') or is_granted('certification:manage') or is_granted('department:manage') or is_granted('rbac:ssomap:manage') or is_granted('config:sso') or is_granted('config:telegram') or is_granted('audit:view') %}

  {% if not canManageAny %}
    {{ d.empty_state('No management access', {message: 'You do not have permission to manage any resources.'}) }}
  {% else %}
    <div class="row g-3">
      {% for c in cards %}
        {% if is_granted(c.priv) %}
          {% set cardIcon %}<span class="fs-3" aria-hidden="true">{{ c.icon }}</span>{% endset %}
          {{ d.action_card(c.title, {
            text: c.text,
            href: path(c.route),
            iconHtml: cardIcon,
            col: 'col-12 col-md-6 col-lg-4',
            class: 'shadow-sm'
          }) }}
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
{% endblock %}
