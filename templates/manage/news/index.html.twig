{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}Manage News{% endblock %}

{% block body %}
  {{ d.page_header('News', {
    subtitle: 'Announcements shown to volunteers.',
    actions: [
      {label: '← Manage', href: path('app_manage'), class: 'btn btn-outline-secondary'},
      {label: '+ New post', href: path('app_manage_news_new'), class: 'btn btn-primary'}
    ]
  }) }}

  {% if news is empty %}
    {{ d.empty_state('No news yet', {
      message: 'Publish the first announcement.',
      actionLabel: '+ New post',
      actionHref: path('app_manage_news_new')
    }) }}
  {% else %}
    {{ d.table_start() }}
      <thead><tr><th>Title</th><th>Flags</th><th>Published</th><th class="text-end">Actions</th></tr></thead>
      <tbody>
        {% for n in news %}
          <tr>
            <td><a href="{{ path('app_news_show', {id: n.id}) }}" class="fw-semibold text-decoration-none">{{ n.title }}</a></td>
            <td>
              <div class="d-flex flex-wrap gap-1">
                {% if n.pinned %}{{ d.badge('Pinned', 'text-bg-primary') }}{% endif %}
                {% if n.highlighted %}{{ d.badge('Highlight', 'text-bg-warning') }}{% endif %}
                {% if n.meeting %}{{ d.badge('Meeting', 'text-bg-info') }}{% endif %}
                {% if n.staffOnly %}{{ d.badge('Staff only', 'text-bg-secondary') }}{% endif %}
              </div>
            </td>
            <td class="small text-muted">{{ n.createdAt|app_datetime }}</td>
            <td class="text-end text-nowrap">
              <a class="btn btn-sm btn-outline-primary" href="{{ path('app_manage_news_edit', {id: n.id}) }}">Edit</a>
              <form method="post" action="{{ path('app_manage_news_delete', {id: n.id}) }}" class="d-inline"
                    onsubmit="return confirm('Delete &quot;{{ n.title|e('js') }}&quot;?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ n.id) }}">
                <button class="btn btn-sm btn-outline-danger">Delete</button>
              </form>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    {{ d.table_end() }}
  {% endif %}
{% endblock %}
