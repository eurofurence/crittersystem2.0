{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}Manage FAQ{% endblock %}

{% block body %}
  {{ d.page_header('FAQ', {
    subtitle: 'Curated answers to common questions.',
    actions: [
      {label: '← Manage', href: path('app_manage'), class: 'btn btn-outline-secondary'},
      {label: '+ New entry', href: path('app_manage_faq_new'), class: 'btn btn-primary'}
    ]
  }) }}

  {% if faqs is empty %}
    {{ d.empty_state('No FAQ entries', {actionLabel: '+ New entry', actionHref: path('app_manage_faq_new')}) }}
  {% else %}
    {{ d.table_start() }}
      <thead><tr><th>Category</th><th>Question</th><th>Order</th><th class="text-end">Actions</th></tr></thead>
      <tbody>
        {% for faq in faqs %}
          <tr>
            <td>{{ faq.category }}</td>
            <td>{{ faq.question }}</td>
            <td>{{ faq.displayOrder }}</td>
            {% set del %}
              {{ d.delete_form(path('app_manage_faq_delete', {id: faq.uuid}), csrf_token('delete' ~ faq.id), {
                message: 'Delete this FAQ entry?'
              }) }}
            {% endset %}
            {{ d.row_actions([
              {label: 'Edit', href: path('app_manage_faq_edit', {id: faq.uuid})}
            ], {extraHtml: del}) }}
          </tr>
        {% endfor %}
      </tbody>
    {{ d.table_end() }}
  {% endif %}
{% endblock %}
