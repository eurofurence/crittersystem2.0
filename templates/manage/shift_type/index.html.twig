{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}Shift Types{% endblock %}

{% block body %}
  {{ d.page_header('Shift Types', {
    subtitle: 'Categories and templates for shifts.',
    actions: [
      {label: '← Manage', href: path('app_manage'), class: 'btn btn-outline-secondary'},
      {label: '+ New shift type', href: path('app_manage_shift_type_new'), class: 'btn btn-primary'}
    ]
  }) }}

  {% if shiftTypes is empty %}
    {{ d.empty_state('No shift types yet', {
      message: 'Create the first shift type to categorise shifts.',
      actionLabel: '+ New shift type',
      actionHref: path('app_manage_shift_type_new')
    }) }}
  {% else %}
    {{ d.table_start() }}
      <thead>
        <tr>
          <th>Name</th>
          <th>Department</th>
          <th>Visibility</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for st in shiftTypes %}
          <tr>
            <td>
              <div class="fw-semibold">{{ st.name }}</div>
              {% if st.description %}<div class="text-muted small">{{ st.description }}</div>{% endif %}
            </td>
            <td>{{ st.department ? st.department.name : '—' }}</td>
            <td>
              {% if st.staffOnly %}{{ d.badge('Staff only', 'text-bg-warning') }}
              {% else %}{{ d.badge('Public', 'text-bg-success') }}{% endif %}
            </td>
            <td class="text-end text-nowrap">
              <a class="btn btn-sm btn-outline-primary" href="{{ path('app_manage_shift_type_edit', {id: st.id}) }}">Edit</a>
              <form method="post" action="{{ path('app_manage_shift_type_delete', {id: st.id}) }}" class="d-inline"
                    onsubmit="return confirm('Delete shift type &quot;{{ st.name|e('js') }}&quot;?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ st.id) }}">
                <button class="btn btn-sm btn-outline-danger">Delete</button>
              </form>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    {{ d.table_end() }}
  {% endif %}
{% endblock %}
