{% extends 'base.html.twig' %}
{% import 'components/forms/_macros.twig' as f %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ heading|trans }}{% endblock %}

{% block body %}
  {{ d.page_header(heading|trans, {
    actions: [{label: 'manage.volunteer_type.action.back'|trans, href: path('app_manage_volunteer_type_index'), class: 'btn btn-outline-secondary'}]
  }) }}

  {{ form_start(form) }}
    {{ d.card_start(null, {class: 'mt-3'}) }}
    <div class="row">
        <div class="col-md-7">{{ form_row(form.name) }}</div>
        <div class="col-md-5">{{ form_row(form.sortOrder) }}</div>
        <div class="col-12">{{ form_row(form.description) }}</div>
    </div>
    {{ d.card_end() }}

    {# Section for the Flags #}
    {{ d.card_start('manage.volunteer_type.card.flags'|trans, {class: 'mt-3'}) }}
    <h2 class="h3">{{ 'manage.volunteer_type.card.flags'|trans }}</h2>
    <div class="row" data-controller="volunteer-type-flags">
        {{ f.switch(form.staffOnly, {col: 'col-12 col-md-4', attr: {'data-volunteer-type-flags-target': 'staffOnly', 'data-action': 'change->volunteer-type-flags#sync'}}) }}
        {{ f.switch(form.departmentOnly, {col: 'col-12 col-md-4', attr: {'data-volunteer-type-flags-target': 'departmentOnly'}}) }}
        {{ f.switch(form.global, {col: 'col-12 col-md-4', attr: {'data-volunteer-type-flags-target': 'global', 'data-action': 'change->volunteer-type-flags#sync'}}) }}
        {{ f.switch(form.hideOnShiftView, {col: 'col-12 col-md-4', attr: {'data-volunteer-type-flags-target': 'hideOnShiftView'}}) }}
        {{ f.switch(form.showOnDashboard, {col: 'col-12 col-md-4', attr: {'data-volunteer-type-flags-target': 'showOnDashboard'}}) }}
        {{ f.switch(form.restricted, {col: 'col-12 col-md-4'}) }}
        {{ f.switch(form.shiftSelfSignup, {col: 'col-12 col-md-4'}) }}
        {{ f.switch(form.hideRegister, {col: 'col-12 col-md-4'}) }}
    </div>
    {{ d.card_end() }}

    {# Section Contacts #}
    {{ d.card_start(null, {class: 'mt-3'}) }}
    <h2 class="h3">{{ 'manage.volunteer_type.card.contacts'|trans }}</h2>
    <div data-controller="collection" data-prototype="{{ form_widget(form.contacts.vars.prototype)|e('html_attr') }}">
      <div data-collection-container>
        {% for contact in form.contacts %}
          <div data-collection-item class="border rounded p-2 mb-2">
            <div class="row">
              {{ f.field(contact.name, {col: 'col-6 col-md-3'}) }}
              {{ f.field(contact.phone, {col: 'col-6 col-md-3'}) }}
              {{ f.field(contact.telegram, {col: 'col-6 col-md-3'}) }}
              {{ f.field(contact.email, {col: 'col-6 col-md-3'}) }}
            </div>
            <button type="button" class="btn btn-sm btn-outline-danger" data-action="collection#remove">{{ 'common.action.remove'|trans }}</button>
          </div>
        {% endfor %}
      </div>
      <button type="button" class="btn btn-sm btn-outline-secondary" data-action="collection#add">{{ 'manage.volunteer_type.action.add_contact'|trans }}</button>
    </div>
    {{ d.card_end() }}

    {# Section Certifications #}
    <h2 class="h3 mt-3">{{ 'manage.volunteer_type.card.certifications'|trans }}</h2>
    {% if form.certifications|length > 0 %}
      <div class="row">
        {% for cert in form.certifications %}
          {% set entity = certifications[cert.vars.value] %}
          {% if entity %}
            {% set control %}
              <label class="form-check form-switch form-switch-4 m-0">
                {{ form_widget(cert, {attr: {class: 'form-check-input position-static', 'aria-label': entity.title}}) }}
              </label>
            {% endset %}
            {{ d.certification_card(entity, {
              col: 'col-12 col-md-6 col-lg-3',
              infoUrl: path('app_certifications_show', {id: entity.uuid}),
              control: control,
            }) }}
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <p class="text-muted">{{ 'manage.volunteer_type.empty.certifications'|trans }}</p>
    {% endif %}
    {{ form_errors(form.certifications) }}

    <button class="btn btn-primary mt-3">{{ 'common.action.save'|trans }}</button>
  {{ form_end(form) }}

  {% if type is defined and type is not null %}
    <h2 class="h3 mt-4">{{ 'manage.volunteer_type.card.members'|trans }}</h2>
    {{ include('manage/volunteer_type/_manage_members.html.twig') }}
  {% endif %}
{% endblock %}
