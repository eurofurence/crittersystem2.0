{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}
{% import 'components/forms/_macros.twig' as f %}

{% block title %}{{ heading|trans }}{% endblock %}

{% block body %}
  {{ d.page_header(heading|trans, {actions: [{label: 'manage.action.back_arrow'|trans, href: path('app_manage_badge_index'), class: 'btn btn-outline-secondary'}]}) }}
  {{ form_start(form) }}
    <div class="row g-3">
      {{ f.field(form.name, {col: 'col-12 col-md-6'}) }}
      {{ f.field(form.type, {col: 'col-12 col-md-6'}) }}
      {{ f.field(form.priority, {col: 'col-12 col-md-6'}) }}
      {{ f.field(form.color, {col: 'col-12 col-md-6'}) }}
    </div>
    <div class="mt-3"><button class="btn btn-primary">{{ 'common.action.save'|trans }}</button></div>
  {{ form_end(form) }}
{% endblock %}
