{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ 'manage.badge.page.title'|trans }}{% endblock %}

{% block body %}
  {{ d.page_header('manage.badge.page.title'|trans, {
    subtitle: 'manage.badge.page.subtitle'|trans,
    actions: [
      {label: 'manage.action.back_to_hub'|trans, href: path('app_manage'), class: 'btn btn-outline-secondary'},
      is_granted('badge:assign') ? {label: 'manage.badge.action.batch_assign'|trans, href: path('app_manage_badge_assign'), class: 'btn btn-outline-primary'} : null,
      {label: 'manage.badge.action.new'|trans, href: path('app_manage_badge_new'), class: 'btn btn-primary'}
    ]|filter(a => a is not null)
  }) }}

  {{ d.table_start() }}
    <thead><tr><th>{{ 'manage.label.badge'|trans }}</th><th>{{ 'common.label.type'|trans }}</th><th>{{ 'manage.label.priority'|trans }}</th><th>{{ 'common.label.members'|trans }}</th><th class="text-end">{{ 'common.label.actions'|trans }}</th></tr></thead>
    <tbody>
      {% for b in badges %}
        <tr>
          <td>{{ d.badge(b.name, 'text-bg-' ~ b.color) }} <code class="ms-1">{{ b.slug }}</code></td>
          <td class="small">{{ b.position ? 'manage.badge.type_label.position'|trans : 'manage.badge.type_label.standard'|trans }}</td>
          <td class="small">{{ b.position ? b.priority : '-' }}</td>
          <td class="small">{{ b.users|length }}</td>
          {% set del %}
            {{ d.delete_form(path('app_manage_badge_delete', {id: b.uuid}), csrf_token('delete' ~ b.id), {
              message: 'manage.badge.confirm.delete'|trans({'%name%': b.name})
            }) }}
          {% endset %}
          {{ d.row_actions([
            {label: 'common.action.edit'|trans, href: path('app_manage_badge_edit', {id: b.uuid})}
          ], {extraHtml: del}) }}
        </tr>
      {% endfor %}
    </tbody>
  {{ d.table_end() }}
{% endblock %}
