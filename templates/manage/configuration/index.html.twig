{% extends 'base.html.twig' %}
{% import 'components/forms/_macros.twig' as f %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ 'manage.configuration.page.title'|trans }}{% endblock %}

{% block body %}
  {{ d.page_header('manage.configuration.page.title'|trans, {
    subtitle: 'manage.configuration.page.subtitle'|trans,
    actions: [{label: 'manage.action.back_to_hub'|trans, href: path('app_manage'), class: 'btn btn-outline-secondary'}]
  }) }}

  {{ form_start(form) }}
    <h2 class="h6">{{ 'manage.configuration.section.regional'|trans }}</h2>
    <div class="row">
      {{ f.choice(form.timezone, {col: 'col-12 col-md-6'}) }}
    </div>

    <h2 class="h6 mt-2">{{ 'manage.configuration.section.formats'|trans }}</h2>
    <div class="row">
      {{ f.field(form.dateTimeFormat, {col: 'col-12 col-md-4'}) }}
      {{ f.field(form.dateFormat, {col: 'col-12 col-md-4'}) }}
      {{ f.field(form.timeFormat, {col: 'col-12 col-md-4'}) }}
    </div>

    {{ d.card_start() }}
        <div class="text-muted small mb-1">{{ 'manage.configuration.preview.label'|trans }}</div>
        <div class="d-flex flex-wrap gap-4">
          <div><span class="text-muted small d-block">{{ 'manage.configuration.preview.datetime'|trans }}</span><strong>{{ now|app_datetime }}</strong></div>
          <div><span class="text-muted small d-block">{{ 'manage.configuration.preview.date'|trans }}</span><strong>{{ now|app_date }}</strong></div>
          <div><span class="text-muted small d-block">{{ 'manage.configuration.preview.time'|trans }}</span><strong>{{ now|app_time }}</strong></div>
        </div>
    {{ d.card_end() }}

    <button class="btn btn-primary">{{ 'common.action.save'|trans }}</button>
  {{ form_end(form) }}
{% endblock %}
