{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ 'manage.group.page.title'|trans }}{% endblock %}

{% block body %}
  {{ d.page_header('manage.group.page.title'|trans, {
    subtitle: 'manage.group.page.subtitle'|trans,
    actions: [
      {label: 'manage.action.back_to_hub'|trans, href: path('app_manage'), class: 'btn btn-outline-secondary'},
      is_granted('rbac:group:manage')
        ? {label: 'manage.group.action.new'|trans, href: path('app_manage_group_new'), class: 'btn btn-primary'} : null
    ]|filter(a => a is not null)
  }) }}

  {{ d.table_start() }}
    <thead>
      <tr>
        <th>{{ 'manage.group.table.group'|trans }}</th>
        <th>{{ 'common.label.role'|trans }}</th>
        <th>{{ 'manage.label.permissions'|trans }}</th>
        <th>{{ 'common.label.members'|trans }}</th>
        <th class="text-end">{{ 'common.label.actions'|trans }}</th>
      </tr>
    </thead>
    <tbody>
      {% for group in groups %}
        <tr>
          <td>
            <div class="fw-semibold">
              {{ group.name }}
              {% if group.slug in core_group_slugs %}{{ d.badge('manage.group.badge.core'|trans, 'text-bg-secondary') }}{% endif %}
            </div>
            <div class="text-muted small"><code>{{ group.slug }}</code></div>
          </td>
          <td>
            {% if group.role %}{{ d.badge(group.role, 'text-bg-azure') }}{% else %}<span class="text-muted small">-</span>{% endif %}
          </td>
          <td class="small">{{ group.privileges|length }}</td>
          <td class="small">{{ group.assignments|length }}</td>
          <td class="text-end text-nowrap">
            {% if is_granted('rbac:group:manage') %}
              {% set del %}
                {% if group.slug not in core_group_slugs %}
                  {{ d.delete_form(path('app_manage_group_delete', {id: group.uuid}), csrf_token('delete' ~ group.id), {
                    message: 'manage.group.confirm.delete'|trans({'%name%': group.name})
                  }) }}
                {% endif %}
              {% endset %}
              {{ d.row_actions([
                {label: 'common.action.edit'|trans, href: path('app_manage_group_edit', {id: group.uuid})}
              ], {cell: false, extraHtml: del}) }}
            {% else %}
              <span class="text-muted small">{{ 'manage.group.view_only'|trans }}</span>
            {% endif %}
          </td>
        </tr>
      {% endfor %}
    </tbody>
  {{ d.table_end() }}
{% endblock %}
