{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}
{% import 'components/forms/_macros.twig' as f %}

{% block title %}{{ heading|trans }}{% endblock %}

{% block body %}
  {{ d.page_header(heading|trans, {
    actions: [{label: 'manage.action.back_arrow'|trans, href: path('app_manage_group_index'), class: 'btn btn-outline-secondary'}]
  }) }}

  {{ form_start(form) }}
    <div class="row g-3">
      {{ f.field(form.name, {col: 'col-12 col-md-6'}) }}
      {{ f.field(form.role, {col: 'col-12 col-md-6'}) }}
    </div>

    {% set cats = {} %}
    {% for child in form.privileges %}
      {% set cat = permissionMeta[child.vars.value].category|default('manage.group.category.other'|trans) %}
      {% set cats = cats|merge({ (cat): (cats[cat]|default([]))|merge([child]) }) %}
    {% endfor %}

    <div class="mt-3">
      <div class="form-label">{{ 'manage.label.permissions'|trans }}</div>
      <div class="row g-3">
        {% for cat, children in cats %}
          <div class="col-12 col-lg-6">
            {{ d.card_start(cat, {class: 'h-100', titleTag: 'strong', headerClass: 'card-header py-2', bodyClass: 'card-body py-2'}) }}
                {% for child in children %}
                  {% set name = child.vars.value %}
                  <label class="form-check">
                    {{ form_widget(child) }}
                    <span class="form-check-label">
                      <code>{{ child.vars.label }}</code>
                      {% if permissionMeta[name].twoFactor %}
                        {{ d.badge('manage.group.badge.two_factor'|trans, 'text-bg-purple', {class: 'ms-1', attrs: {title: 'manage.group.badge.two_factor_title'|trans}}) }}
                      {% endif %}
                      <span class="d-block text-muted small">{{ permissionMeta[name].description }}</span>
                    </span>
                  </label>
                {% endfor %}
            {{ d.card_end({bodyClass: 'card-body py-2'}) }}
          </div>
        {% endfor %}
      </div>
      {{ form_errors(form.privileges) }}
    </div>

    <div class="mt-3">
      <button class="btn btn-primary">{{ 'common.action.save'|trans }}</button>
      <a class="btn btn-link" href="{{ path('app_manage_group_index') }}">{{ 'common.action.cancel'|trans }}</a>
    </div>
  {{ form_end(form) }}
{% endblock %}
