{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ 'manage.shift_task.page.title'|trans }}{% endblock %}

{% block body %}
  {{ d.page_header('manage.shift_task.page.title'|trans, {
    subtitle: 'manage.shift_task.page.subtitle'|trans,
    actions: [
      {label: 'manage.action.back_to_hub'|trans, href: path('app_manage'), class: 'btn btn-outline-secondary'},
      {label: 'manage.shift_task.action.new'|trans, href: path('app_manage_shift_task_new'), class: 'btn btn-primary'}
    ]
  }) }}

  {% if shiftTasks is empty %}
    {{ d.empty_state('manage.shift_task.empty.title'|trans, {
      message: 'manage.shift_task.empty.message'|trans,
      actionLabel: 'manage.shift_task.action.new'|trans,
      actionHref: path('app_manage_shift_task_new')
    }) }}
  {% else %}
    {{ d.table_start() }}
      <thead>
        <tr>
          <th>{{ 'common.label.name'|trans }}</th>
          <th>{{ 'common.label.department'|trans }}</th>
          <th>{{ 'manage.shift_task.table.visibility'|trans }}</th>
          <th class="text-end">{{ 'common.label.actions'|trans }}</th>
        </tr>
      </thead>
      <tbody>
        {% for st in shiftTasks %}
          <tr>
            <td>
              <div class="fw-semibold">{{ st.name }}</div>
              {% if st.description %}<div class="text-muted small">{{ st.description }}</div>{% endif %}
            </td>
            <td>{{ st.department ? st.department.name : '-' }}</td>
            <td>
              {% if st.staffOnly %}{{ d.badge('common.state.staff_only'|trans, 'text-bg-warning') }}
              {% else %}{{ d.badge('common.state.public'|trans, 'text-bg-success') }}{% endif %}
            </td>
            {% set del %}
              {{ d.delete_form(path('app_manage_shift_task_delete', {id: st.uuid}), csrf_token('delete' ~ st.id), {
                message: 'manage.shift_task.confirm.delete'|trans({'%name%': st.name})
              }) }}
            {% endset %}
            {{ d.row_actions([
              {label: 'common.action.edit'|trans, href: path('app_manage_shift_task_edit', {id: st.uuid})}
            ], {extraHtml: del}) }}
          </tr>
        {% endfor %}
      </tbody>
    {{ d.table_end() }}
  {% endif %}
{% endblock %}
