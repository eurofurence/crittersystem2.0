{% extends 'base.html.twig' %}
{% import 'components/forms/_macros.twig' as f %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ heading }}{% endblock %}

{% block body %}
  {{ d.page_header(heading, {
    actions: [{label: '← Back to shift types', href: path('app_manage_shift_task_index'), class: 'btn btn-outline-secondary'}]
  }) }}

  {{ form_start(form) }}
    <div class="row">
      {{ f.field(form.name, {col: 'col-12 col-md-6'}) }}
      {{ f.choice(form.department, {col: 'col-12 col-md-6', help: 'Optional owning department'}) }}
      {{ f.field(form.description, {col: 'col-12'}) }}
      {{ f.check(form.staffOnly, {col: 'col-12'}) }}
    </div>
    <button class="btn btn-primary mt-2">Save</button>
  {{ form_end(form) }}
{% endblock %}
