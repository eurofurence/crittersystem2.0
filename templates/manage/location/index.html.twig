{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ 'manage.location.page.title'|trans }}{% endblock %}

{% block body %}
  {% set porter %}
    <a href="{{ path('app_manage_location_export') }}" class="btn btn-outline-secondary">{{ 'manage.action.export_json'|trans }}</a>
    <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#location-import-modal">{{ 'common.action.import'|trans }}</button>
  {% endset %}
  {{ d.page_header('manage.location.page.title'|trans, {
    subtitle: 'manage.location.page.subtitle'|trans,
    actions: [
      {label: 'manage.action.back_to_hub'|trans, href: path('app_manage'), class: 'btn btn-outline-secondary'},
      {label: 'manage.location.action.new'|trans, href: path('app_manage_location_new'), class: 'btn btn-primary'}
    ],
    actionsHtml: porter
  }) }}

  <div class="modal fade" id="location-import-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <form class="modal-content" method="post" action="{{ path('app_manage_location_import') }}" enctype="multipart/form-data">
        <div class="modal-header">
          <h5 class="modal-title">{{ 'manage.location.import.title'|trans }}</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'ui.aria.close'|trans }}"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" name="_token" value="{{ csrf_token('location_import') }}">
          <p class="text-muted small mb-3">{{ 'manage.location.import.help'|trans|raw }}</p>
          <div class="mb-3">
            <label class="form-label" for="location-import-file">{{ 'manage.import.upload_label'|trans }}</label>
            <input class="form-control" id="location-import-file" type="file" name="file" accept=".json,application/json">
          </div>
          <div class="mb-1">
            <label class="form-label" for="location-import-json">{{ 'manage.import.paste_label'|trans }}</label>
            <textarea class="form-control font-monospace" id="location-import-json" name="json" rows="8"
              placeholder='[{"name":"Main Hall","alias":"main-hall","phone":"100","staffOnly":false,"parent":null}]'></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-link" data-bs-dismiss="modal">{{ 'common.action.cancel'|trans }}</button>
          <button type="submit" class="btn btn-primary">{{ 'manage.location.import.submit'|trans }}</button>
        </div>
      </form>
    </div>
  </div>

  {% if locations is empty %}
    {{ d.empty_state('manage.location.empty.title'|trans, {
      message: 'manage.location.empty.message'|trans,
      actionLabel: 'manage.location.action.new'|trans,
      actionHref: path('app_manage_location_new')
    }) }}
  {% else %}
    {{ d.table_start() }}
      <thead>
        <tr>
          <th>{{ 'common.label.name'|trans }}</th>
          <th>{{ 'manage.label.phone'|trans }}</th>
          <th>{{ 'manage.label.visibility'|trans }}</th>
          <th class="text-end">{{ 'common.label.actions'|trans }}</th>
        </tr>
      </thead>
      <tbody>
        {% for location in locations %}
          <tr>
            <td>
              <div class="fw-semibold">{{ location.name }}</div>
              <code class="small text-muted">{{ location.alias }}</code>
              {% if location.description %}<div class="text-muted small">{{ location.description }}</div>{% endif %}
            </td>
            <td>{{ location.phone ?: '-' }}</td>
            <td>
              {% if location.staffOnly %}{{ d.badge('common.state.staff_only'|trans, 'text-bg-warning') }}
              {% else %}{{ d.badge('common.state.public'|trans, 'text-bg-success') }}{% endif %}
            </td>
            {% set del %}
              {{ d.delete_form(path('app_manage_location_delete', {id: location.uuid}), csrf_token('delete' ~ location.id), {
                message: 'manage.location.confirm.delete'|trans({'%name%': location.name})
              }) }}
            {% endset %}
            {{ d.row_actions([
              {label: 'common.action.edit'|trans, href: path('app_manage_location_edit', {id: location.uuid})}
            ], {extraHtml: del}) }}
          </tr>
        {% endfor %}
      </tbody>
    {{ d.table_end() }}
  {% endif %}
{% endblock %}
