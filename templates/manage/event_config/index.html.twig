{% extends 'base.html.twig' %}
{% import 'components/forms/_macros.twig' as f %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ 'manage.event_config.page.title'|trans }}{% endblock %}

{% block body %}
  {{ d.page_header('manage.event_config.page.title'|trans, {
    subtitle: 'manage.event_config.page.subtitle'|trans,
    actions: [{label: 'manage.action.back_to_hub'|trans, href: path('app_manage'), class: 'btn btn-outline-secondary'}]
  }) }}

  {{ form_start(form) }}
    <h2 class="h6">{{ 'manage.event_config.section.general'|trans }}</h2>
    <div class="row">
      {{ f.field(form.name, {col: 'col-12 col-md-6'}) }}
      {{ f.choice(form.accessMode, {col: 'col-12 col-md-6', help: 'manage.event_config.field.access_mode.help'|trans}) }}
      {{ f.field(form.welcomeMessage, {col: 'col-12'}) }}
    </div>

    <h2 class="h6 mt-2">{{ 'manage.event_config.section.timeline'|trans }}</h2>
    <div class="row">
      {{ f.field(form.buildupStart, {col: 'col-12 col-md-3'}) }}
      {{ f.field(form.eventStart, {col: 'col-12 col-md-3'}) }}
      {{ f.field(form.eventEnd, {col: 'col-12 col-md-3'}) }}
      {{ f.field(form.teardownEnd, {col: 'col-12 col-md-3'}) }}
    </div>

    <h2 class="h6 mt-2">{{ 'manage.event_config.section.appearance'|trans }}</h2>
    <div class="row">
      {{ f.choice(form.defaultTheme, {col: 'col-12 col-md-6'}) }}
    </div>

    <button class="btn btn-primary mt-2">{{ 'common.action.save'|trans }}</button>
  {{ form_end(form) }}
{% endblock %}
