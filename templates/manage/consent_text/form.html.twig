{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}
{% import 'components/forms/_macros.twig' as f %}

{% block title %}{{ heading }}{% endblock %}

{% block body %}
  {{ d.page_header(heading, {actions: [{label: '← Back', href: path('app_manage_consent_text_index'), class: 'btn btn-outline-secondary'}]}) }}
  {{ form_start(form) }}
    <div class="row g-3">
      {{ f.field(form.locale, {col: 'col-12 col-md-4'}) }}
      {{ f.field(form.headerTitle, {col: 'col-12 col-md-8'}) }}
    </div>
    {{ f.field(form.headerBody) }}
    {{ f.field(form.checkboxLabel) }}
    {{ f.field(form.footer) }}
    <div class="mt-3"><button class="btn btn-primary">Save</button></div>
  {{ form_end(form) }}
{% endblock %}
