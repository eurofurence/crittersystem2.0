{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}Consent texts{% endblock %}

{% block body %}
  {{ d.page_header('Consent texts', {
    subtitle: 'The onboarding consent disclaimer, per language.',
    actions: [
      {label: '← Manage', href: path('app_manage'), class: 'btn btn-outline-secondary'},
      {label: '+ New language', href: path('app_manage_consent_text_new'), class: 'btn btn-primary'}
    ]
  }) }}

  {% if texts is empty %}
    {{ d.empty_state('No consent texts yet', {message: 'Add the consent disclaimer for at least one language.', actionLabel: '+ New language', actionHref: path('app_manage_consent_text_new')}) }}
  {% else %}
    {{ d.table_start() }}
      <thead><tr><th>Locale</th><th>Header title</th><th>Updated</th><th class="text-end">Actions</th></tr></thead>
      <tbody>
        {% for t in texts %}
          <tr>
            <td><code>{{ t.locale }}</code></td>
            <td>{{ t.headerTitle }}</td>
            <td class="small text-muted">{{ t.updatedAt|app_datetime }}</td>
            {% set del %}
              {{ d.delete_form(path('app_manage_consent_text_delete', {id: t.uuid}), csrf_token('delete' ~ t.id), {
                message: 'Delete consent text for ' ~ t.locale ~ '?'
              }) }}
            {% endset %}
            {{ d.row_actions([
              {label: 'Edit', href: path('app_manage_consent_text_edit', {id: t.uuid})}
            ], {extraHtml: del}) }}
          </tr>
        {% endfor %}
      </tbody>
    {{ d.table_end() }}
  {% endif %}
{% endblock %}
