{% extends 'base.html.twig' %}
{% import 'components/forms/_macros.twig' as f %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ heading }}{% endblock %}

{% block body %}
  {{ d.page_header(heading, {
    actions: [{label: '← Back to worklogs', href: path('app_manage_worklog_index'), class: 'btn btn-outline-secondary'}]
  }) }}

  {{ form_start(form) }}
    <div class="row">
      {{ f.choice(form.user, {col: 'col-12 col-md-6'}) }}
      {{ f.field(form.hours, {col: 'col-6 col-md-3'}) }}
      {{ f.field(form.workedAt, {col: 'col-6 col-md-3'}) }}
      {{ f.field(form.comment, {col: 'col-12'}) }}
    </div>
    <button class="btn btn-primary mt-2">Save</button>
  {{ form_end(form) }}
{% endblock %}
