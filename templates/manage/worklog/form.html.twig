{% extends 'base.html.twig' %}
{% import 'components/forms/_macros.twig' as f %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ heading|trans }}{% endblock %}

{% block body %}
  {{ d.page_header(heading|trans, {
    actions: [{label: 'manage.worklog.action.back'|trans, href: path('app_manage_worklog_index'), class: 'btn btn-outline-secondary'}]
  }) }}

  {% set currentUser = form.vars.data.user %}
  {{ form_start(form) }}
    <div class="row">
      {{ f.user_select(form.user.vars.full_name, {
        url: path('app_manage_worklog_user_search'),
        label: 'manage.label.volunteer'|trans,
        multiple: false,
        col: 'col-12 col-md-6',
        id: form.user.vars.id,
        selected: currentUser ? [{id: currentUser.uuid, name: currentUser.name, staff: currentUser.staff}] : [],
      }) }}
      {{ f.field(form.hours, {col: 'col-6 col-md-3'}) }}
      {{ f.field(form.workedAt, {col: 'col-6 col-md-3'}) }}
      {{ f.field(form.comment, {col: 'col-12'}) }}
    </div>
    {# The picker macro already emitted the hidden user input; mark the field rendered so form_end
       does not add a duplicate, while still rendering the CSRF token. #}
    {% do form.user.setRendered %}
    <button class="btn btn-primary mt-2">{{ 'common.action.save'|trans }}</button>
  {{ form_end(form) }}
{% endblock %}
