{% import 'components/data/_macros.twig' as d %}
{{ d.card_start(null, {class: 'text-center'}) }}
    <img src="{{ qrDataUri }}" alt="Digital ID QR code" class="img-fluid mb-2" style="max-width: 320px;">
    <div class="fw-semibold">{{ app.user.name }}</div>
    <div class="text-muted small">User ID #{{ app.user.id }}</div>
    <div class="text-muted small mt-2">Valid until {{ token.expiresAt|app_time }}</div>
    <form method="post" action="{{ path('app_digital_id_refresh') }}" class="mt-3">
      <input type="hidden" name="_token" value="{{ csrf_token('digital-id-refresh') }}">
      <button class="btn btn-sm btn-outline-primary">↻ Refresh now</button>
    </form>
{{ d.card_end() }}
<div class="text-muted small text-center mt-2">
  Scanner URL: <code>{{ verifyUrl }}</code>
</div>
