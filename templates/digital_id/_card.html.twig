{% import 'components/data/_macros.twig' as d %}
{{ d.card_start(null, {class: 'text-center'}) }}
    <img src="{{ qrDataUri }}" alt="{{ 'digital_id.qr.alt'|trans }}" class="img-fluid mb-2" style="max-width: 320px;">
    <div class="fw-semibold">{{ app.user.name }}</div>
    <div class="text-muted small">{{ 'digital_id.field.user_id'|trans({'%id%': app.user.id}) }}</div>
    {% if app.user.personalData and app.user.personalData.badgeNumber %}
      <div class="text-muted small">{{ 'digital_id.field.reg'|trans({'%number%': app.user.personalData.badgeNumber}) }}</div>
    {% endif %}
    <div class="text-muted small mt-2">{{ 'digital_id.field.valid_until'|trans({'%time%': token.expiresAt|app_time}) }}</div>
    <form method="post" action="{{ path('app_digital_id_refresh') }}" class="mt-3">
      <input type="hidden" name="_token" value="{{ csrf_token('digital-id-refresh') }}">
      <button class="btn btn-sm btn-outline-primary">{{ 'digital_id.action.refresh'|trans }}</button>
    </form>
{{ d.card_end() }}
<div class="text-muted small text-center mt-2">
  {{ 'digital_id.field.scanner_url'|trans }} <code>{{ verifyUrl }}</code>
</div>
