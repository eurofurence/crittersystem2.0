{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}Digital ID — Invalid{% endblock %}

{% block body %}
  {% set icon %}<div class="display-6 mb-2">⚠️</div>{% endset %}
  {{ d.message_card_start('QR code is invalid or expired', {
    width: 'col-12 col-md-7 col-lg-5',
    class: 'text-center',
    bodyClass: 'card-body',
    titleTag: 'h1',
    titleClass: 'h4 mb-2',
    iconHtml: icon
  }) }}
          <p class="text-muted">Ask the user to refresh their digital ID and try again.</p>
  {{ d.message_card_end() }}
{% endblock %}
