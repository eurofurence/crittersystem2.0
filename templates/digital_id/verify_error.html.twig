{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ 'digital_id.verify.error_title'|trans }}{% endblock %}

{% block body %}
  {% set icon %}<div class="display-6 mb-2">⚠️</div>{% endset %}
  {{ d.message_card_start('digital_id.verify.error_heading'|trans, {
    width: 'col-12 col-md-7 col-lg-5',
    class: 'text-center',
    bodyClass: 'card-body',
    titleTag: 'h1',
    titleClass: 'h4 mb-2',
    iconHtml: icon
  }) }}
          <p class="text-muted">{{ 'digital_id.verify.error_message'|trans }}</p>
  {{ d.message_card_end() }}
{% endblock %}
