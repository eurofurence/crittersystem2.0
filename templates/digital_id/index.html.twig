{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ 'digital_id.page.title'|trans }}{% endblock %}

{% block body %}
  {{ d.page_header('digital_id.page.heading'|trans, {subtitle: 'digital_id.page.subtitle'|trans}) }}

  <div class="row g-3 justify-content-center">
    {#
      The card re-renders just before the current token expires, which rotates the QR. There is no
      topic here and nothing publishes one: the rotation is driven purely by the clock, so the card
      declares the instant it next changes and the region waits for exactly that.

      It has to be JavaScript rather than a <meta http-equiv="refresh">: Turbo never reloads the
      document, so a meta refresh keeps ticking after the user has navigated away and drags them
      back to this page.
    #}
    <div class="col-12 col-md-6 col-lg-5"
         data-controller="live-stream"
         data-live-stream-url-value="{{ path('app_digital_id_card') }}">
      {{ include('digital_id/_card.html.twig') }}
    </div>
  </div>
{% endblock %}
