{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ 'digital_id.page.title'|trans }}{% endblock %}

{% block body %}
  {{ d.page_header('digital_id.page.heading'|trans, {subtitle: 'digital_id.page.subtitle'|trans}) }}

  <div class="row g-3 justify-content-center">
    {#
      The card re-renders itself just before the current token expires, which
      rotates the QR. This has to be a Stimulus timer rather than a
      <meta http-equiv="refresh">: Turbo never reloads the document, so a meta
      refresh keeps ticking after the user has navigated away and drags them back
      to this page.
    #}
    <div class="col-12 col-md-6 col-lg-5"
         data-controller="live-refresh"
         data-live-refresh-url-value="{{ path('app_digital_id_card') }}"
         data-live-refresh-interval-value="{{ refreshIntervalMs }}">
      {{ include('digital_id/_card.html.twig') }}
    </div>
  </div>
{% endblock %}
