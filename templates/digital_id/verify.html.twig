{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}Digital ID — {{ user.name }}{% endblock %}

{% block body %}
  {% set icon %}<div class="display-6 mb-2">✅</div>{% endset %}
  {{ d.message_card_start(user.name, {
    width: 'col-12 col-md-7 col-lg-5',
    class: 'text-center shadow-sm',
    bodyClass: 'card-body',
    titleTag: 'h1',
    titleClass: 'h3 mb-1',
    iconHtml: icon
  }) }}
          <div class="text-muted small mb-3">User ID #{{ user.id }}{% if user.personalData and user.personalData.badgeNumber %} · Reg #{{ user.personalData.badgeNumber }}{% endif %}</div>

          {% if user.groups is not empty %}
            <div class="d-flex flex-wrap gap-1 justify-content-center">
              {% for group in user.groups %}{{ d.badge(group.name, 'text-bg-primary') }}{% endfor %}
            </div>
          {% endif %}

          <hr>
          <div class="small text-muted">Verified at {{ "now"|app_datetime }}</div>
  {{ d.message_card_end() }}
{% endblock %}
