{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ pageTitle }}{% endblock %}

{% block body %}
<div class="container py-4">
  {{ d.page_header(pageTitle, {
    subtitle: 'Confirmations and dialogs - the supported mechanisms',
    actions: [
      {label: 'Back to Navigation Kit', href: path('app_navigation_kit'), class: 'btn btn-outline-secondary'}
    ]
  }) }}

  {% set intro %}
    <p>
      This project has <strong>no modal macros</strong>. Confirmations and dialogs use the two
      mechanisms below.
    </p>
    <p class="mb-0">
      Never use <code>window.confirm()</code> or <code>window.alert()</code>: they cannot be styled,
      cannot be tested, and block the main thread.
    </p>
  {% endset %}
  {{ d.card_start('Confirmations and dialogs', {class: 'mb-3 border-warning'}) }}
    {{ intro|raw }}
  {{ d.card_end() }}

  {{ d.section_header('1. Confirm before submit (declarative)', {
    subtitle: 'Put the confirm controller on the <form>. This is what every destructive action in the app uses.'
  }) }}

  {{ d.card_start() }}
    {% set demoActions %}
      {{ d.delete_form(path('app_modal_kit'), csrf_token('modal_kit_demo'), {
        label: 'Delete department',
        message: 'This action cannot be undone. Delete “Logistics”?',
        class: 'btn btn-danger'
      }) }}
    {% endset %}
    {{ d.row_actions([], {cell: false, extraHtml: demoActions}) }}

    <pre class="mt-3 mb-0"><code>{{ '{{ d.delete_form(path(\'app_manage_location_delete\', {id: location.uuid}),
              csrf_token(\'delete\' ~ location.id),
              {message: \'Delete this location?\'}) }}' }}</code></pre>
  {{ d.card_end() }}

  {{ d.section_header('2. Programmatic confirm / notice (from JavaScript)', {
    subtitle: 'Import the helpers in a Stimulus controller or fetch handler. Both return a Promise.'
  }) }}

  {{ d.card_start() }}
    <pre class="mb-0"><code>import { confirmModal, alertModal } from '../js/modal.js';

if (await confirmModal('Discard the draft shift?', { variant: 'danger' })) {
    await this.destroy();
}

await alertModal('The export is ready.');</code></pre>
  {{ d.card_end() }}
</div>
{% endblock %}
