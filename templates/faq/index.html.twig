{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ 'ui.nav.faq'|trans }}{% endblock %}

{% block body %}
  {{ d.page_header('faq.page.heading'|trans, {
    subtitle: 'faq.page.subtitle'|trans,
    actions: (is_granted('question:ask') ? [{label: 'faq.action.ask'|trans, href: path('app_questions_index'), class: 'btn btn-outline-primary'}] : [])
      |merge(is_granted('faq:manage') ? [{label: 'faq.action.manage'|trans, href: path('app_manage_faq_index'), class: 'btn btn-outline-secondary'}] : [])
  }) }}

  {% if byCategory is empty %}
    {{ d.empty_state('faq.empty.title'|trans, {message: 'faq.empty.message'|trans}) }}
  {% else %}
    {% for category, entries in byCategory %}
      <h2 class="h5 mt-3">{{ category }}</h2>
      <div class="accordion mb-3" id="faq-{{ loop.index }}">
        {% for faq in entries %}
          <div class="accordion-item">
            <h3 class="accordion-header">
              <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq-{{ faq.id }}">
                {{ faq.question }}
              </button>
            </h3>
            <div id="faq-{{ faq.id }}" class="accordion-collapse collapse" data-bs-parent="#faq-{{ loop.parent.loop.index }}">
              <div class="accordion-body">{{ faq.answer|nl2br }}</div>
            </div>
          </div>
        {% endfor %}
      </div>
    {% endfor %}
  {% endif %}
{% endblock %}
