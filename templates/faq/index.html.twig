{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ 'ui.nav.faq'|trans }}{% endblock %}

{% block body %}
  {{ d.page_header('faq.page.heading'|trans, {
    subtitle: 'faq.page.subtitle'|trans,
    actions: (is_granted('question:ask') ? [{label: 'faq.action.ask'|trans, href: path('app_questions_index'), class: 'btn btn-outline-primary'}] : [])
      |merge(is_granted('faq:manage') ? [{label: 'faq.action.manage'|trans, href: path('app_manage_faq_index'), class: 'btn btn-outline-secondary'}] : [])
  }) }}

  {% if byCategory is empty %}
    {{ d.empty_state('faq.empty.title'|trans, {message: 'faq.empty.message'|trans}) }}
  {% else %}
        <div class="card">
            <div class="card-body">
                <div class="space-y-4">
                    {% for category, entries in byCategory %}
                    <div>
                        <h2 class="mb-3">{{ category }}</h2>
                        <div id="faq-{{ loop.index }}" class="accordion accordion-tabs" role="tablist" aria-multiselectable="true">

                            {% for faq in entries %}
                            <div class="accordion-item">
                                <div class="accordion-header">
                                    <button class="accordion-button" data-bs-toggle="collapse" data-bs-target="#faq-{{ loop.parent.loop.index }}-{{ faq.id }}" role="tab" aria-expanded="true">
                                        {{ faq.question }}
                                        <div class="accordion-button-toggle">
                                            <!-- Download SVG icon from http://tabler.io/icons/icon/chevron-down -->
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-1">
                                                <path d="M6 9l6 6l6 -6"></path>
                                            </svg>
                                        </div>
                                    </button>
                                </div>
                                <div id="faq-{{ loop.parent.loop.index }}-{{ faq.id }}" class="accordion-collapse collapse show" role="tabpanel" data-bs-parent="#faq-{{ loop.parent.loop.index }}" style="">
                                    <div class="accordion-body pt-0">
                                        <div>
                                                {{ faq.answer|nl2br }}
                                        </div>
                                    </div>
                                </div>
                            </div>
                            {% endfor %}
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>
  {% endif %}

{% endblock %}
