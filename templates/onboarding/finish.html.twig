{% extends 'onboarding/_layout.html.twig' %}
{% block title %}{{ 'onboarding.finish.title'|trans }}{% endblock %}
{% block step_title %}{{ 'onboarding.finish.heading'|trans }}{% endblock %}
{% block step_body %}
  <form method="post">
    {% if not user.ssoManaged %}
      <p>{{ 'onboarding.finish.set_password'|trans }}</p>
      <div class="row g-3">
        <div class="col-md-6"><label class="form-label">{{ 'onboarding.finish.password_label'|trans }}</label><input type="password" class="form-control" name="password" required minlength="8"></div>
        <div class="col-md-6"><label class="form-label">{{ 'onboarding.finish.password_confirm_label'|trans }}</label><input type="password" class="form-control" name="password_confirm" required minlength="8"></div>
      </div>
    {% else %}
      <p>{{ 'onboarding.finish.sso_managed'|trans }}</p>
    {% endif %}
    <div class="mt-3"><button class="btn btn-success w-100">{{ 'onboarding.finish.submit'|trans }}</button></div>
  </form>
{% endblock %}
