{% extends 'onboarding/_layout.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{# Each theme card is a link, not a radio: following it re-renders this step under that theme,
   which is the preview. Nothing is stored until Confirm is pressed. #}
{% block title %}{{ 'onboarding.theme.title'|trans }}{% endblock %}
{% block step_title %}{{ 'onboarding.theme.heading'|trans }}{% endblock %}
{% block step_body %}
  <p>{{ 'onboarding.theme.body'|trans }}</p>

  <div class="row g-3">
    {% for t in themes %}
      <div class="col-12 col-md-4">
        <a class="card h-100 text-decoration-none {{ selected == t.slug ? 'border-primary border-2' : '' }}"
           href="{{ path('app_onboarding_theme', {theme: t.slug}) }}"
           aria-current="{{ selected == t.slug ? 'true' : 'false' }}">
          <div class="card-body">
            <div class="fw-semibold">
              {{ t.name }}
              {{ d.badge(t.type|capitalize, t.type == 'dark' ? 'text-bg-dark' : 'text-bg-secondary') }}
            </div>
            {% if selected == t.slug %}
              <div class="text-primary small mt-1">{{ 'onboarding.theme.previewing'|trans }}</div>
            {% endif %}
          </div>
        </a>
      </div>
    {% endfor %}
  </div>

  <form method="post" class="mt-3">
    <input type="hidden" name="theme" value="{{ selected }}">
    <button class="btn btn-primary w-100">{{ 'onboarding.theme.confirm'|trans }}</button>
  </form>
{% endblock %}
