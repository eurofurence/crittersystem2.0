{% extends 'onboarding/_layout.html.twig' %}
{% block title %}Notifications{% endblock %}
{% block step_title %}Notifications & visibility{% endblock %}
{% block step_body %}
  <form method="post">
    <p class="form-label">Email notifications</p>
    <label class="form-check"><input type="checkbox" class="form-check-input" name="email_shifts" value="1" {{ settings.emailShiftinfo ? 'checked' }}><span class="form-check-label">Shift notifications</span></label>
    <label class="form-check"><input type="checkbox" class="form-check-input" name="email_goodies" value="1" {{ settings.emailGoodie ? 'checked' }}><span class="form-check-label">Goodies notifications</span></label>
    <p class="form-label mt-3">Visible to managers &amp; shift managers</p>
    <label class="form-check"><input type="checkbox" class="form-check-input" name="show_name" value="1" {{ consent.fullNameVisible ? 'checked' }}><span class="form-check-label">My full name</span></label>
    <label class="form-check"><input type="checkbox" class="form-check-input" name="show_email" value="1" {{ consent.emailVisible ? 'checked' }}><span class="form-check-label">My email</span></label>
    <label class="form-check"><input type="checkbox" class="form-check-input" name="show_phone" value="1" {{ consent.phoneVisible ? 'checked' }}><span class="form-check-label">My phone number</span></label>
    <p class="text-muted small mt-3">Critical notifications (password reset, security, support) are always sent. We never share your email or send spam.</p>
    <div class="mt-3"><button class="btn btn-primary">Continue</button></div>
  </form>
{% endblock %}
