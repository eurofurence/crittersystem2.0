{% extends 'onboarding/_layout.html.twig' %}
{% block title %}{{ 'onboarding.consent.title'|trans }}{% endblock %}
{% block step_title %}{{ text ? text.headerTitle : 'onboarding.consent.heading_default'|trans }}{% endblock %}
{% block step_body %}
  {% if text %}<p class="lead">{{ text.headerBody|nl2br }}</p>{% endif %}
  {% if privacyHtml %}
    <details class="mb-3"><summary>{{ 'onboarding.consent.read_notice'|trans }}</summary><div class="mt-2">{{ privacyHtml|raw }}</div></details>
  {% endif %}
  <form method="post">
    <label class="form-check">
      <input type="checkbox" class="form-check-input" name="consent" value="1" required>
      <span class="form-check-label required">{{ text ? text.checkboxLabel : 'onboarding.consent.checkbox_default'|trans }}</span>
    </label>
    {% if text and text.footer %}<p class="text-muted small mt-2">{{ text.footer|nl2br }}</p>{% endif %}
    <div class="mt-3"><button class="btn btn-primary w-100">{{ 'onboarding.consent.agree'|trans }}</button></div>
  </form>
{% endblock %}
