{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}
{% import 'components/icon/_macros.twig' as i %}

{% block title %}{{ 'department.index.page.title'|trans }}{% endblock %}

{% block body %}
  {{ d.page_header('department.index.page.title'|trans, {subtitle: 'department.index.page.subtitle'|trans}) }}

  {% if rows is empty %}
    {{ d.empty_state('department.index.empty.title'|trans, {message: 'department.index.empty.message'|trans}) }}
  {% else %}
    <div class="row g-3">
      {% for row in rows %}
        {% set dept = row.department %}
        <div class="col-12 col-md-6 col-lg-4">
          <a href="{{ path('app_department_show', {id: dept.uuid}) }}" class="text-decoration-none text-reset">
            {{ d.card_start(dept.name, {class: 'h-100 shadow-sm ' ~ (row.member ? 'border-primary' : ''), bodyClass: ''}) }}
              {% if dept.description %}<div class="card-body">{{ dept.description }}</div>{% endif %}
              {% set deptFooter %}
                {% if row.member %}<span class="badge text-bg-primary">{{ i.icon('users', {class: 'icon-1 me-1'}) }}{{ 'department.label.member'|trans }}</span>{% endif %}
                {% if dept.organizational %}{{ d.badge('department.index.organizational'|trans, 'text-bg-azure') }}{% endif %}
                {% if dept.staffOnly %}{{ d.badge('common.state.staff_only'|trans, 'text-bg-yellow') }}{% endif %}
              {% endset %}
            {{ d.card_end({bodyClass: '', footer: deptFooter, footerClass: 'card-footer d-flex gap-2'}) }}
          </a>
        </div>
      {% endfor %}
    </div>
  {% endif %}
{% endblock %}
