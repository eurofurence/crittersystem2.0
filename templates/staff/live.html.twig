{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}
{% import 'components/notification/_macros.twig' as n %}

{% block title %}{{ 'staff.live.page.title'|trans }}{% endblock %}

{% block body %}
  {{ d.page_header('staff.live.page.title'|trans, {
    subtitle: 'staff.live.page.subtitle'|trans,
    actions: [{label: 'staff.action.back_overview'|trans, href: path('app_staff_overview'), class: 'btn btn-outline-secondary'}]
  }) }}

  {# 
  {% if understaffed is not empty %}
    {{ n.alert('warning', 'staff.live.understaffed'|trans({'%departments%': understaffed|map(dep => dep.name)|join(', ')}), {icon: '⚠️'}) }}
  {% endif %}
  #}
  {% if byDepartment is empty %}
    {{ d.empty_state('staff.live.empty.title'|trans, {message: 'staff.live.empty.message'|trans}) }}
  {% else %}
    <div class="row g-3">
      {% for group in byDepartment %}
        <div class="col-12 col-md-6 col-lg-4">
          {% set dutyCount %}{{ d.badge('staff.live.on_duty_count'|trans({'%count%': group.records|length}), 'text-bg-success') }}{% endset %}
          {{ d.card_start(group.department ? group.department.name : 'staff.live.no_specific_area'|trans, {
            class: 'h-100',
            bodyClass: '',
            titleTag: 'span',
            titleClass: 'fw-semibold',
            headerActions: dutyCount
          }) }}
            <ul class="list-group list-group-flush">
              {% for r in group.records %}
                <li class="list-group-item d-flex justify-content-between">
                  <span>{{ r.user.name }}</span>
                  <span class="text-muted small">{{ r.durationHours|round(1) }}h</span>
                </li>
              {% endfor %}
            </ul>
          {{ d.card_end({bodyClass: ''}) }}
        </div>
      {% endfor %}
    </div>
  {% endif %}
{% endblock %}
