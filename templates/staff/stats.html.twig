{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}Statistics{% endblock %}

{% block body %}
  {{ d.page_header('Statistics' ~ (isOther ? ' — ' ~ target.name : ''), {
    subtitle: isOther ? 'Viewing another volunteer (admin).' : 'Your hours and history.',
    actions: [{label: '← Staff overview', href: path('app_staff_overview'), class: 'btn btn-outline-secondary'}]
  }) }}

  {% if canSwitch %}
    <form method="get" action="{{ path('app_staff_stats') }}" class="row g-2 mb-3">
      <div class="col-12 col-md-6">
        <select name="user" class="form-select" onchange="this.form.submit()">
          {% for u in allUsers %}<option value="{{ u.uuid }}" {{ u.uuid == target.uuid ? 'selected' }}>{{ u.name }}</option>{% endfor %}
        </select>
      </div>
      <div class="col-auto"><noscript><button class="btn btn-primary">View</button></noscript></div>
    </form>
  {% endif %}

  {% set statOptions = {col: 'col-6 col-md-3', size: 'fs-4'} %}
  <div class="row g-3 mb-3">
    {{ d.stat_card(stats.shiftHours|round(2), 'Shift hours', statOptions) }}
    {{ d.stat_card(stats.dutyHours|round(2), 'Duty hours', statOptions) }}
    {{ d.stat_card(stats.shiftEntries, 'Shift sign-ups', statOptions) }}
    {{ d.stat_card(stats.goodies, 'Goodies', statOptions) }}
  </div>

  <h2 class="h5">Duty history</h2>
  {% if dutyHistory is empty %}
    {{ d.empty_inline('No duty sessions yet.', {class: 'text-muted'}) }}
  {% else %}
    {{ d.table_start({hover: false}) }}
      <thead><tr><th>Area</th><th>Started</th><th>Ended</th><th>Hours</th></tr></thead>
      <tbody>
        {% for r in dutyHistory %}
          <tr>
            <td>{{ r.department ? r.department.name : '—' }}</td>
            <td class="small">{{ r.startedAt|app_datetime }}</td>
            <td class="small">{{ r.endedAt ? r.endedAt|app_datetime : d.badge('Active', 'text-bg-success') }}</td>
            <td>{{ r.durationHours|round(2) }}</td>
          </tr>
        {% endfor %}
      </tbody>
    {{ d.table_end() }}
  {% endif %}

  <h2 class="h5 mt-3">Shift history</h2>
  {% if shiftEntries is empty %}
    {{ d.empty_inline('No shift sign-ups.', {class: 'text-muted'}) }}
  {% else %}
    {{ d.table_start({hover: false}) }}
      <thead><tr><th>Shift</th><th>When</th><th>Role</th><th>No-show</th></tr></thead>
      <tbody>
        {% for e in shiftEntries %}
          <tr>
            <td>{{ e.shift.title }}</td>
            <td class="small">{{ e.shift.startsAt|app_datetime }}</td>
            <td>{{ e.volunteerType.name }}</td>
            <td>{% if e.noshow %}{{ d.badge('No-show', 'text-bg-danger') }}{% else %}—{% endif %}</td>
          </tr>
        {% endfor %}
      </tbody>
    {{ d.table_end() }}
  {% endif %}
{% endblock %}
