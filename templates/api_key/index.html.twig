{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ 'api_key.page.title'|trans }}{% endblock %}

{% block body %}
  {{ d.page_header('api_key.page.title'|trans, {subtitle: 'api_key.page.subtitle'|trans}) }}

  {{ d.card_start() }}
      <label class="form-label">{{ 'api_key.field.key.label'|trans }}</label>
      <div class="input-group mb-2">
        <input type="text" class="form-control font-monospace" value="{{ app.user.apiKey }}" readonly>
      </div>
      <form method="post" action="{{ path('app_api_key_regenerate') }}"
            data-controller="confirm" data-confirm-message-value="{{ 'api_key.confirm.regenerate'|trans }}">
        <input type="hidden" name="_token" value="{{ csrf_token('api-key-regenerate') }}">
        <button class="btn btn-outline-danger btn-sm">{{ 'api_key.action.regenerate'|trans }}</button>
      </form>
  {{ d.card_end() }}

  <h2 class="h5">{{ 'api_key.section.usage'|trans }}</h2>
  <p class="text-muted small">{{ 'api_key.usage.intro'|trans }}</p>
  <pre class="bg-body-tertiary border rounded p-3 small">curl -H "Authorization: Bearer {{ app.user.apiKey }}" {{ app.request.schemeAndHttpHost }}/api/v0-beta/info
curl -H "X-API-Key: {{ app.user.apiKey }}" {{ app.request.schemeAndHttpHost }}/api/v0-beta/users/self
{{ app.request.schemeAndHttpHost }}/api/ical?key={{ app.user.apiKey }}</pre>

  <h2 class="h5 mt-3">{{ 'api_key.section.endpoints'|trans }}</h2>
  <ul class="small">
    <li><code>GET /api/v0-beta</code> - {{ 'api_key.endpoint.index'|trans }}</li>
    <li><code>GET /api/v0-beta/info</code> - {{ 'api_key.endpoint.info'|trans }}</li>
    <li><code>GET /api/v0-beta/{volunteertypes,locations,shifttypes,news,shifts}</code></li>
    <li><code>GET /api/v0-beta/users/self</code> - {{ 'api_key.endpoint.self'|trans }}</li>
    <li><code>GET /api/atom</code>, <code>/api/rss</code> - {{ 'api_key.endpoint.feeds'|trans }}</li>
    <li><code>GET /api/ical</code> - {{ 'api_key.endpoint.ical'|trans }}</li>
    <li><code>GET /api/shifts-json-export</code> - {{ 'api_key.endpoint.json'|trans }}</li>
  </ul>
{% endblock %}
