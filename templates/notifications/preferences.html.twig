{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ 'notifications.preferences.title'|trans }}{% endblock %}

{% block body %}
  {{ d.page_header('notifications.preferences.title'|trans, {
    subtitle: 'notifications.preferences.subtitle'|trans,
    actions: [{label: 'notifications.action.back'|trans, href: path('app_notifications'), class: 'btn btn-outline-secondary'}]
  }) }}

  <form method="post">
    <input type="hidden" name="_token" value="{{ csrf_token('notif_prefs') }}">

    {{ d.table_start() }}
      <thead>
        <tr>
          <th>{{ 'notifications.preferences.category'|trans }}</th>
          <th class="text-center">{{ 'notifications.preferences.in_app'|trans }}</th>
          <th class="text-center">{{ 'common.label.email'|trans }}</th>
          <th class="text-center">{{ 'ui.user_menu.telegram'|trans }}</th>
        </tr>
      </thead>
      <tbody>
        {% for row in matrix %}
          <tr>
            <td>
              {{ row.label }}
              {% if row.system %}{{ d.badge('notifications.preferences.badge_system'|trans, 'bg-secondary-lt', {class: 'ms-1'}) }}{% endif %}
            </td>
            <td class="text-center">
              <input type="checkbox" class="form-check-input" name="pref[{{ row.category }}][inApp]" value="1"
                     {{ row.inApp ? 'checked' : '' }} {{ row.system ? 'disabled' : '' }}>
            </td>
            <td class="text-center">
              <input type="checkbox" class="form-check-input" name="pref[{{ row.category }}][email]" value="1"
                     {{ row.email ? 'checked' : '' }} {{ row.inAppOnly ? 'disabled' : '' }}>
            </td>
            <td class="text-center">
              <input type="checkbox" class="form-check-input" name="pref[{{ row.category }}][telegram]" value="1"
                     {{ row.telegram ? 'checked' : '' }} {{ row.inAppOnly ? 'disabled' : '' }}>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    {{ d.table_end() }}

    <p class="text-secondary small">{{ 'notifications.preferences.note'|trans }}</p>

    <div class="mb-3" style="max-width: 24rem;">
      <label class="form-label" for="reminder_lead">{{ 'notifications.preferences.reminder_lead.label'|trans }}</label>
      <select class="form-select" id="reminder_lead" name="reminder_lead">
        <option value="" {{ reminderLead is null ? 'selected' : '' }}>{{ 'notifications.preferences.reminder_lead.default'|trans }}</option>
        {% for minutes in reminderChoices %}
          <option value="{{ minutes }}" {{ reminderLead == minutes ? 'selected' : '' }}>
            {% if minutes >= 60 %}{% set h = minutes // 60 %}{{ (h > 1 ? 'notifications.preferences.lead.hours' : 'notifications.preferences.lead.hour')|trans({'%count%': h}) }}{% else %}{{ 'notifications.preferences.lead.minutes'|trans({'%count%': minutes}) }}{% endif %}
          </option>
        {% endfor %}
      </select>
    </div>

    <button class="btn btn-primary">{{ 'notifications.action.save_preferences'|trans }}</button>
  </form>
{% endblock %}
