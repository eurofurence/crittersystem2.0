{# A Turbo Frame so "mark all read" swaps in place. The live region re-fetches the fragment when
   something is delivered to this user (a Mercure signal on their notifications topic), so the unread
   count is current without a timer. Keep the frame id stable - the server responses target it by
   id. #}
<turbo-frame id="notifications-bell"
             data-controller="live-stream"
             data-live-stream-topic-value="{{ mercure_topic('user_notifications') }}"
             data-live-stream-url-value="{{ path('app_notifications_bell') }}"
             class="nav-item dropdown d-none d-md-flex me-2">
  {% include 'notifications/_bell_content.html.twig' with {vm: vm} only %}
</turbo-frame>
