{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ 'notifications.page.title'|trans }}{% endblock %}

{% block body %}
  {{ d.page_header('notifications.page.title'|trans, {
    subtitle: 'notifications.index.subtitle'|trans,
    actions: [{label: 'notifications.action.preferences'|trans, href: path('app_notifications_preferences'), class: 'btn btn-outline-secondary'}]
  }) }}

  {% if notifications is empty %}
    {{ d.empty_state('notifications.empty.title'|trans, {message: 'notifications.empty.message'|trans}) }}
  {% else %}
    <div class="list-group">
      {% for n in notifications %}
        <a href="{{ path('app_notifications_open', {id: n.uuid}) }}"
           class="list-group-item list-group-item-action {{ n.isRead ? '' : 'fw-semibold' }}">
          <div class="d-flex justify-content-between">
            <span>{{ n.title }}</span>
            <span class="text-secondary small">{{ n.createdAt|app_datetime }}</span>
          </div>
          <div class="text-secondary small">{{ n.message }}</div>
        </a>
      {% endfor %}
    </div>
  {% endif %}
{% endblock %}
