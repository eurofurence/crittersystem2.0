{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}Staffing — {{ shift.title }}{% endblock %}

{% block body %}
  {{ d.page_header('Staffing: ' ~ shift.title, {
    subtitle: shift.startsAt|app_datetime ~ ' – ' ~ shift.endsAt|app_time,
    actions: [{label: '← Planner', href: path('app_manage_shifts_planner', {department: shift.department.uuid}), class: 'btn btn-outline-secondary'}]
  }) }}

  <div class="row g-3">
    <div class="col-12 col-lg-7">
      {{ d.card_start('Assigned (' ~ rows|length ~ ')', {class: '', bodyClass: ''}) }}
        <div class="list-group list-group-flush">
          {% for row in rows %}
            <div class="list-group-item d-flex align-items-center justify-content-between">
              <div>
                <span class="fw-bold">{{ row.entry.user.name }}</span>
                <span class="text-secondary small">· {{ row.entry.volunteerType.name }}</span>
                {% if row.entry.overridden %}
                  {{ d.badge('Override', 'bg-red-lt') }}
                  <span class="text-secondary small">({{ row.entry.overrideReason }})</span>
                {% endif %}
                {% if row.overThreshold %}{{ d.badge('Over hours', 'bg-orange-lt') }}{% endif %}
              </div>
              <form method="post" action="{{ path('app_shift_staffing_remove', {id: shift.uuid, entryId: row.entry.uuid}) }}"
                    data-controller="confirm" data-confirm-message-value="Remove this assignment?">
                <input type="hidden" name="_token" value="{{ csrf_token('staffing_remove' ~ row.entry.uuid) }}">
                <button class="btn btn-sm btn-outline-danger">Remove</button>
              </form>
            </div>
          {% else %}
            {{ d.empty_inline('No one is assigned yet.', {tag: 'div', class: 'list-group-item text-secondary'}) }}
          {% endfor %}
        </div>
      {{ d.card_end({bodyClass: ''}) }}
    </div>

    <div class="col-12 col-lg-5">
      {{ d.card_start('Add a user', {class: ''}) }}
          <form method="get" class="mb-3">
            <div class="input-group">
              <input type="text" class="form-control" name="q" value="{{ query }}" placeholder="Search all users by name/nickname">
              <button class="btn btn-outline-secondary">Search</button>
            </div>
          </form>

          <form method="post" action="{{ path('app_shift_staffing_assign', {id: shift.uuid}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('staffing_assign' ~ shift.id) }}">
            <div class="mb-2">
              <label class="form-label" for="assign-user">User</label>
              <select class="form-select" id="assign-user" name="user" required>
                <option value="">— Choose —</option>
                {% for user in candidates %}
                  <option value="{{ user.id }}">{{ user.name }}</option>
                {% endfor %}
              </select>
            </div>
            {% if is_granted('assignment:override', shift.department) %}
              <label class="form-check mb-2">
                <input type="checkbox" class="form-check-input" name="override" value="1">
                <span class="form-check-label">Override availability / hour warnings</span>
              </label>
            {% endif %}
            <button class="btn btn-primary w-100">Assign</button>
          </form>
      {{ d.card_end() }}

      {% if is_granted('call:trigger') %}
        {{ d.card_start('Call for help', {class: 'mt-3'}) }}
            <form method="post" action="{{ path('app_call_trigger') }}" class="d-flex gap-2 align-items-end">
              <input type="hidden" name="_token" value="{{ csrf_token('call_trigger') }}">
              <input type="hidden" name="shift" value="{{ shift.id }}">
              <div>
                <label class="form-label" for="call-slots">Slots</label>
                <input type="number" id="call-slots" name="slots" value="1" min="1" class="form-control" style="max-width: 6rem;">
              </div>
              <button class="btn btn-warning">Send call for help</button>
            </form>
            <small class="text-secondary">Notifies eligible Free-to-help volunteers.</small>
        {{ d.card_end() }}
      {% endif %}
    </div>
  </div>
{% endblock %}
