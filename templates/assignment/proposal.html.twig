{% extends 'base.html.twig' %}
{% import 'components/data/_macros.twig' as d %}

{% block title %}{{ 'assignment.proposal.page.title'|trans }}{% endblock %}

{% block body %}
  {{ d.page_header('assignment.proposal.header'|trans({'%department%': proposal.department.name}), {
    subtitle: 'assignment.proposal.subtitle'|trans,
    actions: [{label: 'assignment.action.back_to_planner'|trans, href: path('app_manage_shifts_planner', {department: proposal.department.uuid}), class: 'btn btn-outline-secondary'}]
  }) }}

  {% set proposalStatusBadge %}<span>{{ d.status_badge(proposal.status.value) }}</span>{% endset %}
  {{ d.card_start('assignment.proposal.suggestions_count'|trans({'%count%': proposal.assignments|length}), {class: '', bodyClass: '', headerActions: proposalStatusBadge}) }}
    <div class="table-responsive">
      <table class="table table-vcenter card-table">
        <thead><tr><th>{{ 'assignment.table.shift'|trans }}</th><th>{{ 'common.label.when'|trans }}</th><th>{{ 'common.label.user'|trans }}</th><th>{{ 'common.label.role'|trans }}</th><th>{{ 'assignment.table.availability'|trans }}</th></tr></thead>
        <tbody>
          {% for a in proposal.assignments %}
            <tr>
              <td>{{ a.shift.title }}</td>
              <td>{{ a.shift.startsAt|app_datetime }}</td>
              <td>{{ a.user.name }}</td>
              <td>{{ a.volunteerType.name }}</td>
              <td>{{ a.availabilityValue ? d.badge(a.availabilityValue.label, 'bg-azure-lt') : '-' }}</td>
            </tr>
          {% else %}
            {{ d.empty_row(5, 'assignment.proposal.empty'|trans) }}
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% set cardEndOptions = {class: '', bodyClass: ''} %}
    {% if proposal.status.value == 'draft' %}
      {% set proposalFooter %}
        <form method="post" action="{{ path('app_proposal_discard', {id: proposal.uuid}) }}">
          <input type="hidden" name="_token" value="{{ csrf_token('proposal_discard' ~ proposal.id) }}">
          <button class="btn btn-outline-danger">{{ 'assignment.proposal.discard'|trans }}</button>
        </form>
        <form method="post" action="{{ path('app_proposal_apply', {id: proposal.uuid}) }}"
              data-controller="confirm" data-confirm-message-value="{{ 'assignment.proposal.confirm_apply'|trans }}">
          <input type="hidden" name="_token" value="{{ csrf_token('proposal_apply' ~ proposal.id) }}">
          <button class="btn btn-success">{{ 'assignment.proposal.apply_publish'|trans }}</button>
        </form>
      {% endset %}
      {% set cardEndOptions = cardEndOptions|merge({footer: proposalFooter, footerClass: 'card-footer d-flex justify-content-end gap-2'}) %}
    {% endif %}
  {{ d.card_end(cardEndOptions) }}
{% endblock %}
