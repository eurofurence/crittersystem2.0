# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
APP_ENCRYPTION_KEY=ZGzxDHkPGNmYbaC3jxEDshmgRmoxNVpOsTZbDdPnIwg=

# The suite runs against the `test-database` service from compose.dev.yaml, never the dev database.
# That one is a throwaway on a tmpfs with fsync off, which is what makes the per-test schema reset
# cost milliseconds instead of the 1.5s it costs on a durable database - half an hour across a full
# run. Doctrine appends `_test` and, in a parallel run, TEST_TOKEN, so the DSN names no database.
#
# Start it with:  docker compose -f compose.dev.yaml up -d test-database
#
# The container overrides this through DATABASE_URL_TEST, because from inside the dev network the
# same server is `test-database:5432` rather than a published port.
DATABASE_URL=${DATABASE_URL_TEST:-postgresql://app:!ChangeMe!@127.0.0.1:5433/app?serverVersion=16&charset=utf8}

# The suite must not share file storage with a running application, for the same reason it does not
# share its database. The export tests delete archives by key, and the purge commands delete every
# expired one they find - pointed at the real directory, they would delete real exports.
EXPORT_STORAGE_DSN=local://var/test-exports
UPLOAD_STORAGE_DSN=local://var/test-uploads

# Fixed service token for the /api/bot suite. Never a real deployment's token.
BOT_API_TOKEN=test-bot-token

# Browser tests seed their fixtures through the kernel in the `test` env, so the server Panther
# starts must run in that same env or it would look at a different database and see nothing. The
# recipe ships `panther` here; phpunit.dist.xml overrides it via $_SERVER, and the two are kept in
# step so neither file reads as the source of truth on its own.
###> symfony/panther ###
PANTHER_APP_ENV=test
PANTHER_ERROR_SCREENSHOT_DIR=./var/error-screenshots
PANTHER_DEVTOOLS=0
###< symfony/panther ###

# No hub runs during the suite. Empty means the pages never advertise one, so no EventSource is
# opened against a URL that cannot answer - which would write a SEVERE console entry on every retry
# and fail every browser test on principle. Publishing is captured by a MockHub, see config/services.yaml.
MERCURE_PUBLIC_URL=""
