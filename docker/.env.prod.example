# Copy to docker/.env.prod and fill in. NEVER commit the real file.
# Used by compose.prod.yaml for both the database and the app containers.

# --- PostgreSQL ---
POSTGRES_VERSION=16
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-strong

# --- Application ---
APP_ENV=prod
# Generate one with: php -r 'echo bin2hex(random_bytes(16));'
APP_SECRET=change-me-32-hex-chars
# Must match the POSTGRES_* values above; host is the compose service name.
DATABASE_URL="postgresql://app:change-me-strong@database:5432/app?serverVersion=16&charset=utf8"
# Key for encrypting secrets at rest. REQUIRED. Generate with:
#   php bin/console app:encryption:generate-key
# Losing this key makes all encrypted data unrecoverable - store it safely.
APP_ENCRYPTION_KEY=change-me-32-byte-base64-key

# Web install wizard at /admin/install. Leave EMPTY to disable the wizard and
# manage setup from the console only. Set a strong secret to enable it.
INSTALL_PASSWORD=

# Mailer (optional). Default discards mail.
MAILER_DSN=null://null

# Reverse proxy. If TLS is terminated in front of this stack, the app must trust the proxy's
# X-Forwarded-* headers so generated URLs (notably the OIDC SSO redirect_uri) use https. The
# default trusts private/loopback upstreams, which is correct when the app is only reachable
# through the proxy; narrow it to the proxy's IP/CIDR if the app is otherwise directly reachable.
TRUSTED_PROXIES=private_ranges

# Export archives (audit legal packages, GDPR data exports). The worker builds them and the app
# container serves the download; compose.prod.yaml gives both the same named volume, so local:// is
# correct for this single-host stack. Switch to s3:// as soon as the app runs on more than one host.
EXPORT_STORAGE_DSN=local://var/exports
#   EXPORT_STORAGE_DSN=s3://my-bucket?region=eu-central-1&prefix=exports

# Published HTTP port for the nginx container.
HTTP_PORT=8080

# Live updates (Mercure). The app publishes over the internal network; browsers subscribe through
# nginx on the app's own origin, which is what lets the subscriber token be a SameSite=Strict cookie.
#
# Run exactly ONE hub container. The open-source hub does not cluster: with two behind a load
# balancer, a browser connected to one never receives what the app published to the other, and
# nothing reports an error.
MERCURE_URL=http://mercure/.well-known/mercure
MERCURE_PUBLIC_URL=/.well-known/mercure
# Both must be at least 32 characters and MUST differ. The subscriber secret signs tokens handed to
# every browser; if it leaks it must not also be able to publish.
MERCURE_JWT_SECRET=change-me-at-least-32-characters-long
MERCURE_SUBSCRIBER_JWT_SECRET=change-me-too-and-differently-32ch
